# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/node_modules_old_broken

# package manager: npm only (keep package-lock.json; never yarn/pnpm)
/yarn.lock
/pnpm-lock.yaml

# next.js / build output
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# testing
/coverage

# env files — never commit secrets; the template is opt-in
.env*
!.env.example

# vercel
.vercel

# claude code (local, machine-specific)
.claude/settings.local.json

# planning docs (superpowers specs/plans — local only)
/docs/superpowers/

# misc
.DS_Store
*.pem
npm-debug.log*
