            },
            {
              "speaker": "ワット：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>ワット：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そうですか。罰金(ばっきん)は 払(はら)わなければ なりませんか。",
                  "japaneseHtml": "そうですか。<ruby>罰金<rp>(</rp><rt>ばっきん</rt><rp>)</rp></ruby>は <ruby>払<rp>(</rp><rt>はら</rt><rp>)</rp></ruby>わなければ なりませんか。",
                  "vietnamese": "Vậy à? Tiền phạt phải đóng à?",
                  "vietnameseHtml": "Vậy à? Tiền phạt phải đóng à?"
                }
              ]
            },
            {
              "speaker": "大学(だいがく)職員(しょくいん)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>大学<rp>(</rp><rt>だいがく</rt><rp>)</rp></ruby><ruby>職員<rp>(</rp><rt>しょくいん</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ、15,000円(えん) 払(はら)わないと いけません。",
                  "japaneseHtml": "ええ、15,000<ruby>円<rp>(</rp><rt>えん</rt><rp>)</rp></ruby> <ruby>払<rp>(</rp><rt>はら</rt><rp>)</rp></ruby>わないと いけません。",
                  "vietnamese": "Vâng, bắt buộc phải đóng 15,000 yên đấy.",
