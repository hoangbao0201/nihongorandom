              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ちゅうしゃいはん･････、どういう 意味(いみ)ですか。",
                  "japaneseHtml": "ちゅうしゃいはん･････、どういう <ruby>意味<rp>(</rp><rt>いみ</rt><rp>)</rp></ruby>ですか。",
                  "vietnamese": "Vi phạm đỗ xe････, có nghĩa gì vậy?",
                  "vietnameseHtml": "Vi phạm đỗ xe････, có nghĩa gì vậy?"
