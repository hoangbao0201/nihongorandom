              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>大学<rp>(</rp><rt>だいがく</rt><rp>)</rp></ruby><ruby>職員<rp>(</rp><rt>しょくいん</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "駅(えき)の 前(まえ)だったら、10分(ぷん)でも だめですよ。",
                  "japaneseHtml": "<ruby>駅<rp>(</rp><rt>えき</rt><rp>)</rp></ruby>の <ruby>前<rp>(</rp><rt>まえ</rt><rp>)</rp></ruby>だったら、10<ruby>分<rp>(</rp><rt>ぷん</rt><rp>)</rp></ruby>でも だめですよ。",
                  "vietnamese": "Nếu là trước nhà ga thì dù 10 phút cũng không được đâu.",
                  "vietnameseHtml": "Nếu là trước nhà ga thì dù 10 phút cũng không được đâu."
                }
