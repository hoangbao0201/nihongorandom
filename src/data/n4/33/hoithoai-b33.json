            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "どこに 止(と)めたんですか。",
                  "japaneseHtml": "どこに <ruby>止<rp>(</rp><rt>と</rt><rp>)</rp></ruby>めたんですか。",
                  "vietnamese": "Ông đã đỗ xe ở đâu vậy?",
                  "vietnameseHtml": "Ông đã đỗ xe ở đâu vậy?"
                }
              ]
            },
            {
              "speaker": "ワット：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>ワット：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "駅(えき)の 前(まえ)です。雑誌(ざっし)を 買(か)いに 行(い)って、10分(ぶん)だけ･････。",
                  "japaneseHtml": "<ruby>駅<rp>(</rp><rt>えき</rt><rp>)</rp></ruby>の <ruby>前<rp>(</rp><rt>まえ</rt><rp>)</rp></ruby>です。<ruby>雑誌<rp>(</rp><rt>ざっし</rt><rp>)</rp></ruby>を <ruby>買<rp>(</rp><rt>か</rt><rp>)</rp></ruby>いに <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>って、10<ruby>分<rp>(</rp><rt>ぶん</rt><rp>)</rp></ruby>だけ･････。",
                  "vietnamese": "Trước nhà ga. Tôi đi mua tờ tạp chí, chỉ có 10 phút mà･････",
