            {
              "speaker": "大学(だいがく)職員(しょくいん)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>大学<rp>(</rp><rt>だいがく</rt><rp>)</rp></ruby><ruby>職員<rp>(</rp><rt>しょくいん</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "止(と)めては いけない 場所(ばしょ)に 車(くるま)を 止(と)めたと いう 意味(いみ)です。",
                  "japaneseHtml": "<ruby>止<rp>(</rp><rt>と</rt><rp>)</rp></ruby>めては いけない <ruby>場所<rp>(</rp><rt>ばしょ</rt><rp>)</rp></ruby>に <ruby>車<rp>(</rp><rt>くるま</rt><rp>)</rp></ruby>を <ruby>止<rp>(</rp><rt>と</rt><rp>)</rp></ruby>めたと いう <ruby>意味<rp>(</rp><rt>いみ</rt><rp>)</rp></ruby>です。",
                  "vietnamese": "Nghĩa là đã đỗ xe ở chỗ cấm đỗ xe.",
