        {
          "kind": "dialogue",
          "rows": [
            {
              "speaker": "タワポン：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>タワポン：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "鈴木(すずき)さん、冬休(ふゆやす)みに 友達(ともだち)と スキーに 行(い)きたいんですが、どこか いい 所(ところ)、ありませんか。",
                  "japaneseHtml": "<ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>さん、<ruby>冬休<rp>(</rp><rt>ふゆやす</rt><rp>)</rp></ruby>みに <ruby>友達<rp>(</rp><rt>ともだち</rt><rp>)</rp></ruby>と スキーに <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>きたいんですが、どこか いい <ruby>所<rp>(</rp><rt>ところ</rt><rp>)</rp></ruby>、ありませんか。",
                  "vietnamese": "Anh Suzuki này, vào kỳ nghỉ đông, tôi muốn đi trượt tuyết với bạn mà, có chỗ nào tốt không nhỉ?",
                  "vietnameseHtml": "Anh Suzuki này, vào kỳ nghỉ đông, tôi muốn đi trượt tuyết với bạn mà, có chỗ nào tốt không nhỉ?"
                }
              ]
            },
            {
              "speaker": "鈴(すず) 木(き)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby> <ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "何日(なんにち)ぐらいの 予定(よてい)ですか。",
                  "japaneseHtml": "<ruby>何日<rp>(</rp><rt>なんにち</rt><rp>)</rp></ruby>ぐらいの <ruby>予定<rp>(</rp><rt>よてい</rt><rp>)</rp></ruby>ですか。",
                  "vietnamese": "Dự định đi khoảng bao nhiêu ngày?",
                  "vietnameseHtml": "Dự định đi khoảng bao nhiêu ngày?"
                }
              ]
            },
            {
              "speaker": "タワポン：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>タワポン：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "3日(みっか)ぐらいです。",
                  "japaneseHtml": "<ruby>3日<rp>(</rp><rt>みっか</rt><rp>)</rp></ruby>ぐらいです。",
                  "vietnamese": "Khoảng 3 ngày.",
                  "vietnameseHtml": "Khoảng 3 ngày."
                }
              ]
            },
            {
              "speaker": "鈴(すず) 木(き)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby> <ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "それなら、草津(くさつ)か 志賀高原(しがこうげん)が いいと 思(おも)いますよ。温泉(おんせん)も あるし･････。",
                  "japaneseHtml": "それなら、<ruby>草津<rp>(</rp><rt>くさつ</rt><rp>)</rp></ruby>か <ruby>志賀高原<rp>(</rp><rt>しがこうげん</rt><rp>)</rp></ruby>が いいと <ruby>思<rp>(</rp><rt>おも</rt><rp>)</rp></ruby>いますよ。<ruby>温泉<rp>(</rp><rt>おんせん</rt><rp>)</rp></ruby>も あるし･････。",
                  "vietnamese": "Nếu vậy thì tôi nghĩ Kusatsu hay Shigakougen sẽ tốt đấy. Lại còn có cả suối nước nóng nữa….",
                  "vietnameseHtml": "Nếu vậy thì tôi nghĩ Kusatsu hay Shigakougen sẽ tốt đấy. Lại còn có cả suối nước nóng nữa…."
                }
              ]
            },
            {
              "speaker": "タワポン：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>タワポン： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "どうやって 行(い)くんですか。",
                  "japaneseHtml": "どうやって <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>くんですか。",
                  "vietnamese": "Đến đó bằng cách nào nhỉ?",
                  "vietnameseHtml": "Đến đó bằng cách nào nhỉ?"
                }
              ]
            },
            {
              "speaker": "鈴(すず) 木(き)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby> <ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "JRでも 行(い)けますが、夜行(やこう)バス(ばす)なら、朝(あさ) 着(つ)きますから、便利(べんり)ですよ。",
                  "japaneseHtml": "JRでも <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>けますが、<ruby>夜行<rp>(</rp><rt>やこう</rt><rp>)</rp></ruby><ruby>バス<rp>(</rp><rt>ばす</rt><rp>)</rp></ruby>なら、<ruby>朝<rp>(</rp><rt>あさ</rt><rp>)</rp></ruby> <ruby>着<rp>(</rp><rt>つ</rt><rp>)</rp></ruby>きますから、<ruby>便利<rp>(</rp><rt>べんり</rt><rp>)</rp></ruby>ですよ。",
                  "vietnamese": "Cũng có thể đi bằng JR nhưng nếu là xe buýt đi ban đêm thì buổi sáng sẽ đến được, nên rất tiện đấy.",
                  "vietnameseHtml": "Cũng có thể đi bằng JR nhưng nếu là xe buýt đi ban đêm thì buổi sáng sẽ đến được, nên rất tiện đấy."
                }
              ]
            },
            {
              "speaker": "タワポン：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>タワポン：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そうですか。どちらが 安(やす)いんですか。",
                  "japaneseHtml": "そうですか。どちらが <ruby>安<rp>(</rp><rt>やす</rt><rp>)</rp></ruby>いんですか。",
                  "vietnamese": "Vậy à. Cách nào rẻ hơn nhỉ?",
                  "vietnameseHtml": "Vậy à. Cách nào rẻ hơn nhỉ?"
                }
              ]
            },
            {
              "speaker": "鈴(すず) 木(き)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby> <ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "さあ･････。旅行社(りょこうしゃ)へ 行(い)けば もっと 詳(くわ)しい ことが わかりますよ。",
                  "japaneseHtml": "さあ･････。<ruby>旅行社<rp>(</rp><rt>りょこうしゃ</rt><rp>)</rp></ruby>へ <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>けば もっと <ruby>詳<rp>(</rp><rt>くわ</rt><rp>)</rp></ruby>しい ことが わかりますよ。",
                  "vietnamese": "À,…Nếu bạn đến công ty du lịch thì sẽ biết được nhiều điều chi tiết hơn đấy.",
                  "vietnameseHtml": "À,…Nếu bạn đến công ty du lịch thì sẽ biết được nhiều điều chi tiết hơn đấy."
                }
              ]
            },
            {
              "speaker": "タワポン：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>タワポン： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "それから、スキーの 道具(どうぐ)や 服(ふく)は 何(なに)も 持(も)って いないんですが･････。",
                  "japaneseHtml": "それから、スキーの <ruby>道具<rp>(</rp><rt>どうぐ</rt><rp>)</rp></ruby>や <ruby>服<rp>(</rp><rt>ふく</rt><rp>)</rp></ruby>は <ruby>何<rp>(</rp><rt>なに</rt><rp>)</rp></ruby>も <ruby>持<rp>(</rp><rt>も</rt><rp>)</rp></ruby>って いないんですが･････。",
                  "vietnamese": "Và còn dụng cụ trượt tuyết hay trang phục thì tôi chẳng có cái nào cả…..",
                  "vietnameseHtml": "Và còn dụng cụ trượt tuyết hay trang phục thì tôi chẳng có cái nào cả….."
                }
              ]
            },
            {
              "speaker": "鈴(すず) 木(き)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby> <ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "全部(ぜんぶ) スキー(すきー)場(じょう)で 借(か)りられますよ。",
                  "japaneseHtml": "<ruby>全部<rp>(</rp><rt>ぜんぶ</rt><rp>)</rp></ruby> <ruby>スキー<rp>(</rp><rt>すきー</rt><rp>)</rp></ruby><ruby>場<rp>(</rp><rt>じょう</rt><rp>)</rp></ruby>で <ruby>借<rp>(</rp><rt>か</rt><rp>)</rp></ruby>りられますよ。",
                  "vietnamese": "Toàn bộ đều có thể mượn được ở bãi trượt đấy.",
                  "vietnameseHtml": "Toàn bộ đều có thể mượn được ở bãi trượt đấy."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "心配(しんぱい)なら、旅行社(りょこうしゃ)で 予約(よやく)も できるし･････。",
                  "japaneseHtml": "<ruby>心配<rp>(</rp><rt>しんぱい</rt><rp>)</rp></ruby>なら、<ruby>旅行社<rp>(</rp><rt>りょこうしゃ</rt><rp>)</rp></ruby>で <ruby>予約<rp>(</rp><rt>よやく</rt><rp>)</rp></ruby>も できるし･････。",
                  "vietnamese": "Nếu cậu lo lắng thì cũng có thể đặt trước ở công ty du lịch….",
                  "vietnameseHtml": "Nếu cậu lo lắng thì cũng có thể đặt trước ở công ty du lịch…."
                }
              ]
            },
            {
              "speaker": "タワポン：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>タワポン： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そうですか。どうも ありがとう ございました。",
                  "japaneseHtml": "そうですか。どうも ありがとう ございました。",
                  "vietnamese": "Vậy à. Cảm ơn anh nhiều lắm.",
                  "vietnameseHtml": "Vậy à. Cảm ơn anh nhiều lắm."
                }
              ]
            }
