          "kind": "dialogue",
          "rows": [
            {
              "speaker": "先生(せんせい)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "はい、ひまわり小学校(しょうがっこう)です。",
                  "japaneseHtml": "はい、ひまわり<ruby>小学校<rp>(</rp><rt>しょうがっこう</rt><rp>)</rp></ruby>です。",
                  "vietnamese": "Vâng, trường tiểu học Himawari xin nghe.",
                  "vietnameseHtml": "Vâng, trường tiểu học Himawari xin nghe."
                }
              ]
            },
            {
              "speaker": "クララ：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>クララ：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "おはよう ございます。",
                  "japaneseHtml": "おはよう ございます。",
                  "vietnamese": "Xin chào buổi sáng.",
                  "vietnameseHtml": "Xin chào buổi sáng."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "５年(ねん)2組(くみ)の ハンス・シュミットの 母(はは)ですが、伊藤(いとう)先生(せんせい)は いらっしゃいますか。",
                  "japaneseHtml": "５<ruby>年<rp>(</rp><rt>ねん</rt><rp>)</rp></ruby>2<ruby>組<rp>(</rp><rt>くみ</rt><rp>)</rp></ruby>の ハンス・シュミットの <ruby>母<rp>(</rp><rt>はは</rt><rp>)</rp></ruby>ですが、<ruby>伊藤<rp>(</rp><rt>いとう</rt><rp>)</rp></ruby><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>は いらっしゃいますか。",
                  "vietnamese": "Tôi là mẹ của em Hans Schmidt học năm thứ 5 lớp 2, cho tôi hỏi cô Itou có ở đó không ạ?",
                  "vietnameseHtml": "Tôi là mẹ của em Hans Schmidt học năm thứ 5 lớp 2, cho tôi hỏi cô Itou có ở đó không ạ?"
                }
              ]
            },
            {
              "speaker": "先生(せんせい)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "まだなんですが･････。",
                  "japaneseHtml": "まだなんですが･････。",
                  "vietnamese": "Cô ấy vẫn chưa tới…",
                  "vietnameseHtml": "Cô ấy vẫn chưa tới…"
                }
              ]
            },
            {
              "speaker": "クララ：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>クララ： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "では、伊藤(いとう)先生(せんせい)に 伝(つた)えて いただきたいんですが･････。",
                  "japaneseHtml": "では、<ruby>伊藤<rp>(</rp><rt>いとう</rt><rp>)</rp></ruby><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>に <ruby>伝<rp>(</rp><rt>つた</rt><rp>)</rp></ruby>えて いただきたいんですが･････。",
                  "vietnamese": "Vậy thì tôi mong thầy chuyển lời giúp đến cô Itou…",
                  "vietnameseHtml": "Vậy thì tôi mong thầy chuyển lời giúp đến cô Itou…"
                }
              ]
            },
            {
              "speaker": "先生(せんせい)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "はい、何(なん)でしょうか。",
                  "japaneseHtml": "はい、<ruby>何<rp>(</rp><rt>なん</rt><rp>)</rp></ruby>でしょうか。",
                  "vietnamese": "Vâng, việc gì ạ?",
                  "vietnameseHtml": "Vâng, việc gì ạ?"
                }
              ]
            },
            {
              "speaker": "クララ：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>クララ： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "実(じつ)は ハンスが ゆうべ 熱(ねつ)を 出(だ)しまして、けさも まだ 下(さ)がらないんです。",
                  "japaneseHtml": "<ruby>実<rp>(</rp><rt>じつ</rt><rp>)</rp></ruby>は ハンスが ゆうべ <ruby>熱<rp>(</rp><rt>ねつ</rt><rp>)</rp></ruby>を <ruby>出<rp>(</rp><rt>だ</rt><rp>)</rp></ruby>しまして、けさも まだ <ruby>下<rp>(</rp><rt>さ</rt><rp>)</rp></ruby>がらないんです。",
                  "vietnamese": "Thật ra là Hans đã bị sốt tối qua và sáng nay vẫn chưa hạ sốt.",
                  "vietnameseHtml": "Thật ra là Hans đã bị sốt tối qua và sáng nay vẫn chưa hạ sốt."
                }
              ]
            },
            {
              "speaker": "先生(せんせい)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "それは いけませんね。",
                  "japaneseHtml": "それは いけませんね。",
                  "vietnamese": "Như vậy thật là không tốt rồi.",
                  "vietnameseHtml": "Như vậy thật là không tốt rồi."
                }
              ]
            },
            {
              "speaker": "クララ：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>クララ： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "それで きょうは 学校(がっこう)を 休(やす)ませますので、先生(せんせい)に よろしく お伝(つた)え ください。",
                  "japaneseHtml": "それで きょうは <ruby>学校<rp>(</rp><rt>がっこう</rt><rp>)</rp></ruby>を <ruby>休<rp>(</rp><rt>やす</rt><rp>)</rp></ruby>ませますので、<ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>に よろしく お<ruby>伝<rp>(</rp><rt>つた</rt><rp>)</rp></ruby>え ください。",
                  "vietnamese": "Vì vậy, tôi đã cho nó nghỉ học ngày hôm nay, nên nhờ thầy chuyển lời giúp.",
                  "vietnameseHtml": "Vì vậy, tôi đã cho nó nghỉ học ngày hôm nay, nên nhờ thầy chuyển lời giúp."
                }
              ]
            },
            {
              "speaker": "先生(せんせい)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "わかりました。どうぞ お大事(だいじ)に。",
                  "japaneseHtml": "わかりました。どうぞ お<ruby>大事<rp>(</rp><rt>だいじ</rt><rp>)</rp></ruby>に。",
                  "vietnamese": "Tôi biết rồi. Mong cháu mau khỏi bệnh.",
                  "vietnameseHtml": "Tôi biết rồi. Mong cháu mau khỏi bệnh."
                }
              ]
            },
            {
              "speaker": "クララ：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>クララ： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ありがとう ございます。失礼(しつれい)いたします。",
                  "japaneseHtml": "ありがとう ございます。<ruby>失礼<rp>(</rp><rt>しつれい</rt><rp>)</rp></ruby>いたします。",
                  "vietnamese": "Cám ơn. Xin chào thầy ạ.",
                  "vietnameseHtml": "Cám ơn. Xin chào thầy ạ."
                }
              ]
            }
          ],
          "contentHtml": "<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"khung\" style=\" width: 100%;\"> <tbody> <tr> <td style=\"width: 13%;\"> <span style=\"color:#000080;\"><strong><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">はい、ひまわり<ruby>小学校<rp>(</rp><rt>しょうがっこう</rt><rp>)</rp></ruby>です。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vâng, trường tiểu học Himawari xin nghe.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>クララ：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">おはよう ございます。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Xin chào buổi sáng.</div></div></div></td> </tr> <tr> <td> </td> <td> <div class=\"tudich\"><div class=\"candich\">５<ruby>年<rp>(</rp><rt>ねん</rt><rp>)</rp></ruby>2<ruby>組<rp>(</rp><rt>くみ</rt><rp>)</rp></ruby>の ハンス・シュミットの <ruby>母<rp>(</rp><rt>はは</rt><rp>)</rp></ruby>ですが、<ruby>伊藤<rp>(</rp><rt>いとう</rt><rp>)</rp></ruby><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>は いらっしゃいますか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Tôi là mẹ của em Hans Schmidt học năm thứ 5 lớp 2, cho tôi hỏi cô Itou có ở đó không ạ?</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">まだなんですが･････。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Cô ấy vẫn chưa tới…</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>クララ： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">では、<ruby>伊藤<rp>(</rp><rt>いとう</rt><rp>)</rp></ruby><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>に <ruby>伝<rp>(</rp><rt>つた</rt><rp>)</rp></ruby>えて いただきたいんですが･････。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vậy thì tôi mong thầy chuyển lời giúp đến cô Itou…</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">はい、<ruby>何<rp>(</rp><rt>なん</rt><rp>)</rp></ruby>でしょうか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vâng, việc gì ạ?</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>クララ： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>実<rp>(</rp><rt>じつ</rt><rp>)</rp></ruby>は ハンスが ゆうべ <ruby>熱<rp>(</rp><rt>ねつ</rt><rp>)</rp></ruby>を <ruby>出<rp>(</rp><rt>だ</rt><rp>)</rp></ruby>しまして、けさも まだ <ruby>下<rp>(</rp><rt>さ</rt><rp>)</rp></ruby>がらないんです。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Thật ra là Hans đã bị sốt tối qua và sáng nay vẫn chưa hạ sốt.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">それは いけませんね。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Như vậy thật là không tốt rồi.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>クララ： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">それで きょうは <ruby>学校<rp>(</rp><rt>がっこう</rt><rp>)</rp></ruby>を <ruby>休<rp>(</rp><rt>やす</rt><rp>)</rp></ruby>ませますので、<ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>に よろしく お<ruby>伝<rp>(</rp><rt>つた</rt><rp>)</rp></ruby>え ください。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vì vậy, tôi đã cho nó nghỉ học ngày hôm nay, nên nhờ thầy chuyển lời giúp.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">わかりました。どうぞ お<ruby>大事<rp>(</rp><rt>だいじ</rt><rp>)</rp></ruby>に。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Tôi biết rồi. Mong cháu mau khỏi bệnh.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>クララ： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">ありがとう ございます。<ruby>失礼<rp>(</rp><rt>しつれい</rt><rp>)</rp></ruby>いたします。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Cám ơn. Xin chào thầy ạ.</div></div></div></td> </tr> </tbody> </table>"
        }
      ]
