        {
          "kind": "dialogue",
          "rows": [
            {
              "speaker": "管理人(かんりにん)：",
              "speakerHtml": "<strong><span style=\"color:#000080;\"><ruby>管理人<rp>(</rp><rt>かんりにん</rt><rp>)</rp></ruby>：</span></strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ミラーさん、引(ひ)っ越(こ)しの 荷物(にもつ)は 片付(かたづ)きましたか。",
                  "japaneseHtml": "ミラーさん、<ruby>引<rp>(</rp><rt>ひ</rt><rp>)</rp></ruby>っ<ruby>越<rp>(</rp><rt>こ</rt><rp>)</rp></ruby>しの <ruby>荷物<rp>(</rp><rt>にもつ</rt><rp>)</rp></ruby>は <ruby>片付<rp>(</rp><rt>かたづ</rt><rp>)</rp></ruby>きましたか。",
                  "vietnamese": "Anh Miller này, đồ đạc chuyển nhà đã dọn dẹp xong hết chưa?",
                  "vietnameseHtml": "Anh Miller này, đồ đạc chuyển nhà đã dọn dẹp xong hết chưa?"
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<strong><span style=\"color:#000080;\">ミラー：</span></strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "はい、だいたい 片付(かたづ)きました。",
                  "japaneseHtml": "はい、だいたい <ruby>片付<rp>(</rp><rt>かたづ</rt><rp>)</rp></ruby>きました。",
                  "vietnamese": "Vâng, phần lớn đã dọn xong rồi.",
                  "vietnameseHtml": "Vâng, phần lớn đã dọn xong rồi."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "あのう、ごみを 捨(す)てたいんですが、どこに出(だ)したら いいですか。",
                  "japaneseHtml": "あのう、ごみを <ruby>捨<rp>(</rp><rt>す</rt><rp>)</rp></ruby>てたいんですが、どこに<ruby>出<rp>(</rp><rt>だ</rt><rp>)</rp></ruby>したら いいですか。",
                  "vietnamese": "Xin lỗi, tôi muốn vứt rác nhưng mà đổ rác ở đâu thì được đây?",
                  "vietnameseHtml": "Xin lỗi, tôi muốn vứt rác nhưng mà đổ rác ở đâu thì được đây?"
                }
              ]
            },
            {
              "speaker": "管理人(かんりにん)：",
              "speakerHtml": "<strong><span style=\"color:#000080;\"><ruby>管理人<rp>(</rp><rt>かんりにん</rt><rp>)</rp></ruby>：</span></strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "燃(も)える ごみは 月曜日(げつようび)と 木曜日(もくようび)の 朝(あさ) 出(だ)して ください。",
                  "japaneseHtml": "<ruby>燃<rp>(</rp><rt>も</rt><rp>)</rp></ruby>える ごみは <ruby>月曜日<rp>(</rp><rt>げつようび</rt><rp>)</rp></ruby>と <ruby>木曜日<rp>(</rp><rt>もくようび</rt><rp>)</rp></ruby>の <ruby>朝<rp>(</rp><rt>あさ</rt><rp>)</rp></ruby> <ruby>出<rp>(</rp><rt>だ</rt><rp>)</rp></ruby>して ください。",
                  "vietnamese": "Rác cháy được thì hãy đổ vào sáng thứ hai và thứ năm.",
                  "vietnameseHtml": "Rác cháy được thì hãy đổ vào sáng thứ hai và thứ năm."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ごみ置(お)き場(ば)は 駐車場(ちゅうしゃじょう)の 横(よこ)です。",
                  "japaneseHtml": "ごみ<ruby>置<rp>(</rp><rt>お</rt><rp>)</rp></ruby>き<ruby>場<rp>(</rp><rt>ば</rt><rp>)</rp></ruby>は <ruby>駐車場<rp>(</rp><rt>ちゅうしゃじょう</rt><rp>)</rp></ruby>の <ruby>横<rp>(</rp><rt>よこ</rt><rp>)</rp></ruby>です。",
                  "vietnamese": "Chỗ đổ rác là bên cạnh bãi đổ xe ấy.",
                  "vietnameseHtml": "Chỗ đổ rác là bên cạnh bãi đổ xe ấy."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<strong><span style=\"color:#000080;\">ミラー：</span></strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "瓶(びん)や 缶(かん)は いつですか。",
                  "japaneseHtml": "<ruby>瓶<rp>(</rp><rt>びん</rt><rp>)</rp></ruby>や <ruby>缶<rp>(</rp><rt>かん</rt><rp>)</rp></ruby>は いつですか。",
                  "vietnamese": "Còn bình hay lon thì chừng nào vậy?",
                  "vietnameseHtml": "Còn bình hay lon thì chừng nào vậy?"
                }
              ]
            },
            {
              "speaker": "管理人(かんりにん)：",
              "speakerHtml": "<strong><span style=\"color:#000080;\"><ruby>管理人<rp>(</rp><rt>かんりにん</rt><rp>)</rp></ruby>：</span></strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "土曜日(どようび)です。",
                  "japaneseHtml": "<ruby>土曜日<rp>(</rp><rt>どようび</rt><rp>)</rp></ruby>です。",
                  "vietnamese": "Vào thứ bảy.",
                  "vietnameseHtml": "Vào thứ bảy."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<strong><span style=\"color:#000080;\">ミラー：</span></strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "わかりました。それから、お湯(ゆ)が 出(で)ないんですが・・・。",
                  "japaneseHtml": "わかりました。それから、お<ruby>湯<rp>(</rp><rt>ゆ</rt><rp>)</rp></ruby>が <ruby>出<rp>(</rp><rt>で</rt><rp>)</rp></ruby>ないんですが・・・。",
                  "vietnamese": "Tôi hiểu rồi. Thêm nữa là nước nóng không chảy ra …..",
                  "vietnameseHtml": "Tôi hiểu rồi. Thêm nữa là nước nóng không chảy ra ….."
                }
              ]
            },
            {
              "speaker": "管理人(かんりにん)：",
              "speakerHtml": "<strong><span style=\"color:#000080;\"><ruby>管理人<rp>(</rp><rt>かんりにん</rt><rp>)</rp></ruby>：</span></strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ガス会社(がいしゃ)に 連絡(れんらく)したら、すぐ 来(き)て くれますよ。",
                  "japaneseHtml": "ガス<ruby>会社<rp>(</rp><rt>がいしゃ</rt><rp>)</rp></ruby>に <ruby>連絡<rp>(</rp><rt>れんらく</rt><rp>)</rp></ruby>したら、すぐ <ruby>来<rp>(</rp><rt>き</rt><rp>)</rp></ruby>て くれますよ。",
                  "vietnamese": "Nếu cậu liên lạc với công ty gas thì họ sẽ tới ngay đấy.",
                  "vietnameseHtml": "Nếu cậu liên lạc với công ty gas thì họ sẽ tới ngay đấy."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<strong><span style=\"color:#000080;\">ミラー：</span></strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "すみませんが、電話番号(でんわばんごう)を 教(おし)えて いただけませんか。",
                  "japaneseHtml": "すみませんが、<ruby>電話番号<rp>(</rp><rt>でんわばんごう</rt><rp>)</rp></ruby>を <ruby>教<rp>(</rp><rt>おし</rt><rp>)</rp></ruby>えて いただけませんか。",
                  "vietnamese": "Xin lỗi có thể cho tôi số điện thoại không?",
                  "vietnameseHtml": "Xin lỗi có thể cho tôi số điện thoại không?"
                }
              ]
            },
            {
              "speaker": "管理人(かんりにん)：",
              "speakerHtml": "<strong><span style=\"color:#000080;\"><ruby>管理人<rp>(</rp><rt>かんりにん</rt><rp>)</rp></ruby>：</span></strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ、いいですよ。",
                  "japaneseHtml": "ええ、いいですよ。",
                  "vietnamese": "Ồ, được chứ.",
                  "vietnameseHtml": "Ồ, được chứ."
                }
              ]
            }
          ],
          "contentHtml": "<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"khung\" style=\" width: 100%;\"> <tbody> <tr> <td style=\"width: 120px;\"> <strong><span style=\"color:#000080;\"><ruby>管理人<rp>(</rp><rt>かんりにん</rt><rp>)</rp></ruby>：</span></strong></td> <td> <div class=\"tudich\"><div class=\"candich\">ミラーさん、<ruby>引<rp>(</rp><rt>ひ</rt><rp>)</rp></ruby>っ<ruby>越<rp>(</rp><rt>こ</rt><rp>)</rp></ruby>しの <ruby>荷物<rp>(</rp><rt>にもつ</rt><rp>)</rp></ruby>は <ruby>片付<rp>(</rp><rt>かたづ</rt><rp>)</rp></ruby>きましたか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Anh Miller này, đồ đạc chuyển nhà đã dọn dẹp xong hết chưa?</div></div></div></td> </tr> <tr> <td> <strong><span style=\"color:#000080;\">ミラー：</span></strong></td> <td> <div class=\"tudich\"><div class=\"candich\">はい、だいたい <ruby>片付<rp>(</rp><rt>かたづ</rt><rp>)</rp></ruby>きました。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vâng, phần lớn đã dọn xong rồi.</div></div></div></td> </tr> <tr> <td> </td> <td> <div class=\"tudich\"><div class=\"candich\">あのう、ごみを <ruby>捨<rp>(</rp><rt>す</rt><rp>)</rp></ruby>てたいんですが、どこに<ruby>出<rp>(</rp><rt>だ</rt><rp>)</rp></ruby>したら いいですか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Xin lỗi, tôi muốn vứt rác nhưng mà đổ rác ở đâu thì được đây?</div></div></div></td> </tr> <tr> <td> <strong><span style=\"color:#000080;\"><ruby>管理人<rp>(</rp><rt>かんりにん</rt><rp>)</rp></ruby>：</span></strong></td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>燃<rp>(</rp><rt>も</rt><rp>)</rp></ruby>える ごみは <ruby>月曜日<rp>(</rp><rt>げつようび</rt><rp>)</rp></ruby>と <ruby>木曜日<rp>(</rp><rt>もくようび</rt><rp>)</rp></ruby>の <ruby>朝<rp>(</rp><rt>あさ</rt><rp>)</rp></ruby> <ruby>出<rp>(</rp><rt>だ</rt><rp>)</rp></ruby>して ください。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Rác cháy được thì hãy đổ vào sáng thứ hai và thứ năm.</div></div></div></td> </tr> <tr> <td> </td> <td> <div class=\"tudich\"><div class=\"candich\">ごみ<ruby>置<rp>(</rp><rt>お</rt><rp>)</rp></ruby>き<ruby>場<rp>(</rp><rt>ば</rt><rp>)</rp></ruby>は <ruby>駐車場<rp>(</rp><rt>ちゅうしゃじょう</rt><rp>)</rp></ruby>の <ruby>横<rp>(</rp><rt>よこ</rt><rp>)</rp></ruby>です。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Chỗ đổ rác là bên cạnh bãi đổ xe ấy.</div></div></div></td> </tr> <tr> <td> <strong><span style=\"color:#000080;\">ミラー：</span></strong></td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>瓶<rp>(</rp><rt>びん</rt><rp>)</rp></ruby>や <ruby>缶<rp>(</rp><rt>かん</rt><rp>)</rp></ruby>は いつですか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Còn bình hay lon thì chừng nào vậy?</div></div></div></td> </tr> <tr> <td> <strong><span style=\"color:#000080;\"><ruby>管理人<rp>(</rp><rt>かんりにん</rt><rp>)</rp></ruby>：</span></strong></td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>土曜日<rp>(</rp><rt>どようび</rt><rp>)</rp></ruby>です。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vào thứ bảy.</div></div></div></td> </tr> <tr> <td> <strong><span style=\"color:#000080;\">ミラー：</span></strong></td> <td> <div class=\"tudich\"><div class=\"candich\">わかりました。それから、お<ruby>湯<rp>(</rp><rt>ゆ</rt><rp>)</rp></ruby>が <ruby>出<rp>(</rp><rt>で</rt><rp>)</rp></ruby>ないんですが・・・。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Tôi hiểu rồi. Thêm nữa là nước nóng không chảy ra …..</div></div></div></td> </tr> <tr> <td> <strong><span style=\"color:#000080;\"><ruby>管理人<rp>(</rp><rt>かんりにん</rt><rp>)</rp></ruby>：</span></strong></td> <td> <div class=\"tudich\"><div class=\"candich\">ガス<ruby>会社<rp>(</rp><rt>がいしゃ</rt><rp>)</rp></ruby>に <ruby>連絡<rp>(</rp><rt>れんらく</rt><rp>)</rp></ruby>したら、すぐ <ruby>来<rp>(</rp><rt>き</rt><rp>)</rp></ruby>て くれますよ。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Nếu cậu liên lạc với công ty gas thì họ sẽ tới ngay đấy.</div></div></div></td> </tr> <tr> <td> <strong><span style=\"color:#000080;\">ミラー：</span></strong></td> <td> <div class=\"tudich\"><div class=\"candich\">すみませんが、<ruby>電話番号<rp>(</rp><rt>でんわばんごう</rt><rp>)</rp></ruby>を <ruby>教<rp>(</rp><rt>おし</rt><rp>)</rp></ruby>えて いただけませんか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Xin lỗi có thể cho tôi số điện thoại không?</div></div></div></td> </tr> <tr> <td> <strong><span style=\"color:#000080;\"><ruby>管理人<rp>(</rp><rt>かんりにん</rt><rp>)</rp></ruby>：</span></strong></td> <td> <div class=\"tudich\"><div class=\"candich\">ええ、いいですよ。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Ồ, được chứ.</div></div></div></td> </tr> </tbody> </table>"
        }
      ]
    },
