            {
              "speaker": "ミラー：",
              "speakerHtml": "<strong>ミラー：</strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "こんにちは。",
                  "japaneseHtml": "こんにちは。",
                  "vietnamese": "Xin chào.",
                  "vietnameseHtml": "Xin chào."
                }
              ]
            },
            {
              "speaker": "鈴木(すずき)：",
              "speakerHtml": "<strong><ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>：</strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "いらっしゃい。さあ、どうそ。",
                  "japaneseHtml": "いらっしゃい。さあ、どうそ。",
                  "vietnamese": "Rất vui khi được anh ghé thăm, xin mời.",
                  "vietnameseHtml": "Rất vui khi được anh ghé thăm, xin mời."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<strong>ミラー：</strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "大(おお)きい リュックが 置(お)いて ありますね。",
                  "japaneseHtml": "<ruby>大<rp>(</rp><rt>おお</rt><rp>)</rp></ruby>きい リュックが <ruby>置<rp>(</rp><rt>お</rt><rp>)</rp></ruby>いて ありますね。",
                  "vietnamese": "Có cái ba lô to nhỉ.",
                  "vietnameseHtml": "Có cái ba lô to nhỉ."
                },
                {
                  "kind": "tudich",
                  "japanese": "山(やま)へ 行(い)くんですか。",
                  "japaneseHtml": "<ruby>山<rp>(</rp><rt>やま</rt><rp>)</rp></ruby>へ <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>くんですか。",
                  "vietnamese": "Anh đi leo núi à.",
                  "vietnameseHtml": "Anh đi leo núi à."
                }
              ]
            },
            {
              "speaker": "鈴木(すずき)：",
              "speakerHtml": "<strong><ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>：</strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "いいえ。非常(ひじょう)袋(ぶくろ)ですよ。",
                  "japaneseHtml": "いいえ。<ruby>非常<rp>(</rp><rt>ひじょう</rt><rp>)</rp></ruby><ruby>袋<rp>(</rp><rt>ぶくろ</rt><rp>)</rp></ruby>ですよ。",
                  "vietnamese": "Không. Là túi khẩn cấp ấy.",
                  "vietnameseHtml": "Không. Là túi khẩn cấp ấy."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<strong>ミラー： </strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "非常(ひじょう)袋(ぶくろ)？何(なん)ですか。",
                  "japaneseHtml": "<ruby>非常<rp>(</rp><rt>ひじょう</rt><rp>)</rp></ruby><ruby>袋<rp>(</rp><rt>ぶくろ</rt><rp>)</rp></ruby>？<ruby>何<rp>(</rp><rt>なん</rt><rp>)</rp></ruby>ですか。",
                  "vietnamese": "Túi khẩn cấp? Là gì vậy?",
                  "vietnameseHtml": "Túi khẩn cấp? Là gì vậy?"
                }
              ]
            },
            {
              "speaker": "鈴木(すずき)：",
              "speakerHtml": "<strong><ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>： </strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "非常時(ひじょうじ)に 使(つか)う 物(もの)を 入(い)れて おく 袋(ふくろ)です。",
                  "japaneseHtml": "<ruby>非常時<rp>(</rp><rt>ひじょうじ</rt><rp>)</rp></ruby>に <ruby>使<rp>(</rp><rt>つか</rt><rp>)</rp></ruby>う <ruby>物<rp>(</rp><rt>もの</rt><rp>)</rp></ruby>を <ruby>入<rp>(</rp><rt>い</rt><rp>)</rp></ruby>れて おく <ruby>袋<rp>(</rp><rt>ふくろ</rt><rp>)</rp></ruby>です。",
                  "vietnamese": "Là túi để những đồ đạc dùng khi khẩn cấp.",
                  "vietnameseHtml": "Là túi để những đồ đạc dùng khi khẩn cấp."
                },
                {
                  "kind": "tudich",
                  "japanese": "電気(でんき)や ガスが 止(と)まっても、３日(みっか)ぐらい 生活(せいかつ)できる 物(もの)が 入(い)れて あるんです。",
                  "japaneseHtml": "<ruby>電気<rp>(</rp><rt>でんき</rt><rp>)</rp></ruby>や ガスが <ruby>止<rp>(</rp><rt>と</rt><rp>)</rp></ruby>まっても、<ruby>３日<rp>(</rp><rt>みっか</rt><rp>)</rp></ruby>ぐらい <ruby>生活<rp>(</rp><rt>せいかつ</rt><rp>)</rp></ruby>できる <ruby>物<rp>(</rp><rt>もの</rt><rp>)</rp></ruby>が <ruby>入<rp>(</rp><rt>い</rt><rp>)</rp></ruby>れて あるんです。",
                  "vietnamese": "Có để những đồ đạc sinh hoạt mà có thể sinh sống 3 ngày cho dù có mất điện hay ga.",
                  "vietnameseHtml": "Có để những đồ đạc sinh hoạt mà có thể sinh sống 3 ngày cho dù có mất điện hay ga."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<strong>ミラー： </strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "水(みず)や 食(た)べ物(もの)ですか。",
                  "japaneseHtml": "<ruby>水<rp>(</rp><rt>みず</rt><rp>)</rp></ruby>や <ruby>食<rp>(</rp><rt>た</rt><rp>)</rp></ruby>べ<ruby>物<rp>(</rp><rt>もの</rt><rp>)</rp></ruby>ですか。",
                  "vietnamese": "Để nước hay đồ ăn à?",
                  "vietnameseHtml": "Để nước hay đồ ăn à?"
                }
              ]
            },
            {
              "speaker": "鈴木(すずき)：",
              "speakerHtml": "<strong><ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>：</strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ、ほかにも いろいろ ありますよ。懐中電灯(かいちゅうでんとう)とか、ラジオとか…。",
                  "japaneseHtml": "ええ、ほかにも いろいろ ありますよ。<ruby>懐中電灯<rp>(</rp><rt>かいちゅうでんとう</rt><rp>)</rp></ruby>とか、ラジオとか…。",
                  "vietnamese": "Vâng, ngoài ra còn có nhiều thứ khác. Như là đèn pin, máy Radio …",
                  "vietnameseHtml": "Vâng, ngoài ra còn có nhiều thứ khác. Như là đèn pin, máy Radio …"
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<strong>ミラー： </strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "わたしも 準備(じゅんび)して おかないと。",
                  "japaneseHtml": "わたしも <ruby>準備<rp>(</rp><rt>じゅんび</rt><rp>)</rp></ruby>して おかないと。",
                  "vietnamese": "Tôi cũng phải chuẩn bị thôi.",
                  "vietnameseHtml": "Tôi cũng phải chuẩn bị thôi."
                }
              ]
            },
            {
              "speaker": "鈴木(すずき)：",
              "speakerHtml": "<strong><ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>： </strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "非常(ひじょう)袋(ぶくろ)は スーパーでも 売(う)って いますよ。",
                  "japaneseHtml": "<ruby>非常<rp>(</rp><rt>ひじょう</rt><rp>)</rp></ruby><ruby>袋<rp>(</rp><rt>ぶくろ</rt><rp>)</rp></ruby>は スーパーでも <ruby>売<rp>(</rp><rt>う</rt><rp>)</rp></ruby>って いますよ。",
                  "vietnamese": "Túi khẩn cấp có bán ở siêu thị ấy.",
                  "vietnameseHtml": "Túi khẩn cấp có bán ở siêu thị ấy."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<strong>ミラー： </strong>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そうですか。じゃ、買(か)って おきます。",
                  "japaneseHtml": "そうですか。じゃ、<ruby>買<rp>(</rp><rt>か</rt><rp>)</rp></ruby>って おきます。",
                  "vietnamese": "Vậy à, vậy tôi sẽ mua.",
                  "vietnameseHtml": "Vậy à, vậy tôi sẽ mua."
                }
              ]
            }
          ],
          "contentHtml": "<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"khung\" style=\" width: 100%;\"> <tbody> <tr> <td style=\"width: 13%;\"> <strong>ミラー：</strong></td> <td> <div class=\"tudich\"><div class=\"candich\">こんにちは。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Xin chào.</div></div></div></td> </tr> <tr> <td> <strong><ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>：</strong></td> <td> <div class=\"tudich\"><div class=\"candich\">いらっしゃい。さあ、どうそ。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Rất vui khi được anh ghé thăm, xin mời.</div></div></div></td> </tr> <tr> <td> <strong>ミラー：</strong></td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>大<rp>(</rp><rt>おお</rt><rp>)</rp></ruby>きい リュックが <ruby>置<rp>(</rp><rt>お</rt><rp>)</rp></ruby>いて ありますね。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Có cái ba lô to nhỉ.</div></div></div><p></p><div class=\"tudich\"><div class=\"candich\"><ruby>山<rp>(</rp><rt>やま</rt><rp>)</rp></ruby>へ <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>くんですか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Anh đi leo núi à.</div></div></div></td> </tr> <tr> <td> <strong><ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>：</strong></td> <td> <div class=\"tudich\"><div class=\"candich\">いいえ。<ruby>非常<rp>(</rp><rt>ひじょう</rt><rp>)</rp></ruby><ruby>袋<rp>(</rp><rt>ぶくろ</rt><rp>)</rp></ruby>ですよ。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Không. Là túi khẩn cấp ấy.</div></div></div></td> </tr> <tr> <td> <strong>ミラー： </strong></td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>非常<rp>(</rp><rt>ひじょう</rt><rp>)</rp></ruby><ruby>袋<rp>(</rp><rt>ぶくろ</rt><rp>)</rp></ruby>？<ruby>何<rp>(</rp><rt>なん</rt><rp>)</rp></ruby>ですか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Túi khẩn cấp? Là gì vậy?</div></div></div></td> </tr> <tr> <td> <strong><ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>： </strong></td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>非常時<rp>(</rp><rt>ひじょうじ</rt><rp>)</rp></ruby>に <ruby>使<rp>(</rp><rt>つか</rt><rp>)</rp></ruby>う <ruby>物<rp>(</rp><rt>もの</rt><rp>)</rp></ruby>を <ruby>入<rp>(</rp><rt>い</rt><rp>)</rp></ruby>れて おく <ruby>袋<rp>(</rp><rt>ふくろ</rt><rp>)</rp></ruby>です。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Là túi để những đồ đạc dùng khi khẩn cấp.</div></div></div><p></p><div class=\"tudich\"><div class=\"candich\"><ruby>電気<rp>(</rp><rt>でんき</rt><rp>)</rp></ruby>や ガスが <ruby>止<rp>(</rp><rt>と</rt><rp>)</rp></ruby>まっても、<ruby>３日<rp>(</rp><rt>みっか</rt><rp>)</rp></ruby>ぐらい <ruby>生活<rp>(</rp><rt>せいかつ</rt><rp>)</rp></ruby>できる <ruby>物<rp>(</rp><rt>もの</rt><rp>)</rp></ruby>が <ruby>入<rp>(</rp><rt>い</rt><rp>)</rp></ruby>れて あるんです。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Có để những đồ đạc sinh hoạt mà có thể sinh sống 3 ngày cho dù có mất điện hay ga.</div></div></div></td> </tr> <tr> <td> <strong>ミラー： </strong></td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>水<rp>(</rp><rt>みず</rt><rp>)</rp></ruby>や <ruby>食<rp>(</rp><rt>た</rt><rp>)</rp></ruby>べ<ruby>物<rp>(</rp><rt>もの</rt><rp>)</rp></ruby>ですか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Để nước hay đồ ăn à?</div></div></div></td> </tr> <tr> <td> <strong><ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>：</strong></td> <td> <div class=\"tudich\"><div class=\"candich\">ええ、ほかにも いろいろ ありますよ。<ruby>懐中電灯<rp>(</rp><rt>かいちゅうでんとう</rt><rp>)</rp></ruby>とか、ラジオとか…。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vâng, ngoài ra còn có nhiều thứ khác. Như là đèn pin, máy Radio …</div></div></div></td> </tr> <tr> <td> <strong>ミラー： </strong></td> <td> <div class=\"tudich\"><div class=\"candich\">わたしも <ruby>準備<rp>(</rp><rt>じゅんび</rt><rp>)</rp></ruby>して おかないと。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Tôi cũng phải chuẩn bị thôi.</div></div></div></td> </tr> <tr> <td> <strong><ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>： </strong></td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>非常<rp>(</rp><rt>ひじょう</rt><rp>)</rp></ruby><ruby>袋<rp>(</rp><rt>ぶくろ</rt><rp>)</rp></ruby>は スーパーでも <ruby>売<rp>(</rp><rt>う</rt><rp>)</rp></ruby>って いますよ。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Túi khẩn cấp có bán ở siêu thị ấy.</div></div></div></td> </tr> <tr> <td> <strong>ミラー： </strong></td> <td> <div class=\"tudich\"><div class=\"candich\">そうですか。じゃ、<ruby>買<rp>(</rp><rt>か</rt><rp>)</rp></ruby>って おきます。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vậy à, vậy tôi sẽ mua.</div></div></div></td> </tr> </tbody> </table>"
        }
