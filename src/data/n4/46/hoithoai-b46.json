            {
              "speaker": "係員(かかりいん)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>係員<rp>(</rp><rt>かかりいん</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "はい、ガスサービスセンターで ございます。",
                  "japaneseHtml": "はい、ガスサービスセンターで ございます。",
                  "vietnamese": "Vâng, trung tâm dịch vụ gas xin nghe.",
                  "vietnameseHtml": "Vâng, trung tâm dịch vụ gas xin nghe."
                }
              ]
            },
            {
              "speaker": "タワポン：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>タワポン：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "あのう、ガスレンジの 調子(ちょうし)が おかしいんですが ･････。",
                  "japaneseHtml": "あのう、ガスレンジの <ruby>調子<rp>(</rp><rt>ちょうし</rt><rp>)</rp></ruby>が おかしいんですが ･････。",
                  "vietnamese": "À, tình trạng bếp gas của tôi có hơi lạ…",
                  "vietnameseHtml": "À, tình trạng bếp gas của tôi có hơi lạ…"
                }
              ]
            },
            {
              "speaker": "係(かかり)人(いん)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>係<rp>(</rp><rt>かかり</rt><rp>)</rp></ruby><ruby>人<rp>(</rp><rt>いん</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "どんな 具合(ぐあい)ですか。",
                  "japaneseHtml": "どんな <ruby>具合<rp>(</rp><rt>ぐあい</rt><rp>)</rp></ruby>ですか。",
                  "vietnamese": "Cụ thể như thế nào ạ?",
                  "vietnameseHtml": "Cụ thể như thế nào ạ?"
                }
              ]
            },
            {
              "speaker": "タワポン：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>タワポン：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "先週(せんしゅう) 直(なお)して もらった ばかりなのに、また 火(ひ)が 消(き)えて しまうんです。",
                  "japaneseHtml": "<ruby>先週<rp>(</rp><rt>せんしゅう</rt><rp>)</rp></ruby> <ruby>直<rp>(</rp><rt>なお</rt><rp>)</rp></ruby>して もらった ばかりなのに、また <ruby>火<rp>(</rp><rt>ひ</rt><rp>)</rp></ruby>が <ruby>消<rp>(</rp><rt>き</rt><rp>)</rp></ruby>えて しまうんです。",
                  "vietnamese": "Tuần trước mới được sửa thế mà lửa lại tắt mất rồi.",
                  "vietnameseHtml": "Tuần trước mới được sửa thế mà lửa lại tắt mất rồi."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "危(あぶ)ないので、すぐ 見(み)に 来(き)て くれませんか。",
                  "japaneseHtml": "<ruby>危<rp>(</rp><rt>あぶ</rt><rp>)</rp></ruby>ないので、すぐ <ruby>見<rp>(</rp><rt>み</rt><rp>)</rp></ruby>に <ruby>来<rp>(</rp><rt>き</rt><rp>)</rp></ruby>て くれませんか。",
                  "vietnamese": "Rất là nguy hiểm nên có thể đến xem ngay được không vậy?",
                  "vietnameseHtml": "Rất là nguy hiểm nên có thể đến xem ngay được không vậy?"
                }
              ]
            },
            {
              "speaker": "係(かかり)人(いん)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>係<rp>(</rp><rt>かかり</rt><rp>)</rp></ruby><ruby>人<rp>(</rp><rt>いん</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "わかりました。5時(じ)ごろには 行(い)けると 思(おも)います。",
                  "japaneseHtml": "わかりました。5<ruby>時<rp>(</rp><rt>じ</rt><rp>)</rp></ruby>ごろには <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>けると <ruby>思<rp>(</rp><rt>おも</rt><rp>)</rp></ruby>います。",
                  "vietnamese": "Tôi hiểu rồi. Khoảng 5 giờ chúng tôi có thể đến được.",
                  "vietnameseHtml": "Tôi hiểu rồi. Khoảng 5 giờ chúng tôi có thể đến được."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ご住所(じゅうしょ)と お名前(なまえ)を お願(ねが)いします。",
                  "japaneseHtml": "ご<ruby>住所<rp>(</rp><rt>じゅうしょ</rt><rp>)</rp></ruby>と お<ruby>名前<rp>(</rp><rt>なまえ</rt><rp>)</rp></ruby>を お<ruby>願<rp>(</rp><rt>ねが</rt><rp>)</rp></ruby>いします。",
                  "vietnamese": "Xin cho tôi địa chỉ và tên.",
                  "vietnameseHtml": "Xin cho tôi địa chỉ và tên."
                }
              ]
            },
            {
              "speaker": "タワポン：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>タワポン： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "もしもし、5時(じ)ごろに ガスレンジを 見(み)に 来(き)て くれるはずなんですが、まだですか。",
                  "japaneseHtml": "もしもし、5<ruby>時<rp>(</rp><rt>じ</rt><rp>)</rp></ruby>ごろに ガスレンジを <ruby>見<rp>(</rp><rt>み</rt><rp>)</rp></ruby>に <ruby>来<rp>(</rp><rt>き</rt><rp>)</rp></ruby>て くれるはずなんですが、まだですか。",
                  "vietnamese": "A lô, đáng lẽ khoảng 5 giờ là đến kiểm tra bếp ga mà vẫn chưa tới à?",
                  "vietnameseHtml": "A lô, đáng lẽ khoảng 5 giờ là đến kiểm tra bếp ga mà vẫn chưa tới à?"
                }
              ]
            },
            {
              "speaker": "係(かかり)人(いん)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong> <ruby>係<rp>(</rp><rt>かかり</rt><rp>)</rp></ruby><ruby>人<rp>(</rp><rt>いん</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "申(もう)し訳(わけ) ありません。どちら様(さま)でしょうか。",
                  "japaneseHtml": "<ruby>申<rp>(</rp><rt>もう</rt><rp>)</rp></ruby>し<ruby>訳<rp>(</rp><rt>わけ</rt><rp>)</rp></ruby> ありません。どちら<ruby>様<rp>(</rp><rt>さま</rt><rp>)</rp></ruby>でしょうか。",
                  "vietnamese": "Xin lỗi. Cho hỏi vị khách nào đấy ạ?",
                  "vietnameseHtml": "Xin lỗi. Cho hỏi vị khách nào đấy ạ?"
                }
              ]
            },
            {
              "speaker": "タワポン：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong> タワポン： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "タワポンです。",
                  "japaneseHtml": "タワポンです。",
                  "vietnamese": "Tôi là Thawapon.",
                  "vietnameseHtml": "Tôi là Thawapon."
                }
              ]
            },
            {
              "speaker": "係(かかり)人(いん)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong> <ruby>係<rp>(</rp><rt>かかり</rt><rp>)</rp></ruby><ruby>人<rp>(</rp><rt>いん</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "少々(しょうしょう) お待(ま)ち ください。係(かかり)人(いん)に 連絡(れんらく)しますから。",
                  "japaneseHtml": "<ruby>少々<rp>(</rp><rt>しょうしょう</rt><rp>)</rp></ruby><ruby> お<ruby>待<rp>(</rp><rt>ま</rt><rp>)</rp></ruby>ち ください。<ruby>係<rp>(</rp><rt>かかり</rt><rp>)</rp></ruby><ruby>人<rp>(</rp><rt>いん</rt><rp>)</rp></ruby>に <ruby>連絡<rp>(</rp><rt>れんらく</rt><rp>)</rp></ruby>しますから。",
                  "vietnamese": "Xin vui lòng đợi trong chốc lát. Tôi sẽ liên lạc với người phụ trách đây.",
                  "vietnameseHtml": "Xin vui lòng đợi trong chốc lát. Tôi sẽ liên lạc với người phụ trách đây."
                }
              ]
            },
            {
              "speaker": "係(かかり)人(いん)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>係<rp>(</rp><rt>かかり</rt><rp>)</rp></ruby><ruby>人<rp>(</rp><rt>いん</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
