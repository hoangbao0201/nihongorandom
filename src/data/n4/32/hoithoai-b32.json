        {
          "kind": "dialogue",
          "rows": [
            {
              "speaker": "小川(おがわ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "シュミットさん、元気(げんき)が ありませんね。どう したんですか。",
                  "japaneseHtml": "シュミットさん、<ruby>元気<rp>(</rp><rt>げんき</rt><rp>)</rp></ruby>が ありませんね。どう したんですか。",
                  "vietnamese": "Anh Schmidt, trông anh không khỏe lắm. Anh có sao không?",
                  "vietnameseHtml": "Anh Schmidt, trông anh không khỏe lắm. Anh có sao không?"
                }
              ]
            },
            {
              "speaker": "シュミット：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>シュミット：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "最近(さいきん) 体(からだ)の 調子(ちょうし)が よくないんです。",
                  "japaneseHtml": "<ruby>最近<rp>(</rp><rt>さいきん</rt><rp>)</rp></ruby> <ruby>体<rp>(</rp><rt>からだ</rt><rp>)</rp></ruby>の <ruby>調子<rp>(</rp><rt>ちょうし</rt><rp>)</rp></ruby>が よくないんです。",
                  "vietnamese": "Dạo này, tình trạng cơ thể không tốt lắm.",
                  "vietnameseHtml": "Dạo này, tình trạng cơ thể không tốt lắm."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "時々(ときどき) 頭(あたま)や 胃(い)が 痛(いた)く なるんです。",
                  "japaneseHtml": "<ruby>時々<rp>(</rp><rt>ときどき</rt><rp>)</rp></ruby> <ruby>頭<rp>(</rp><rt>あたま</rt><rp>)</rp></ruby>や <ruby>胃<rp>(</rp><rt>い</rt><rp>)</rp></ruby>が <ruby>痛<rp>(</rp><rt>いた</rt><rp>)</rp></ruby>く なるんです。",
                  "vietnamese": "Đôi khi còn bị đau đầu hay đau bụng nữa.",
                  "vietnameseHtml": "Đôi khi còn bị đau đầu hay đau bụng nữa."
                }
              ]
            },
            {
              "speaker": "小川(おがわ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "それは いけませんね。仕事(しごと)が 忙(いそが)しいんですか。",
                  "japaneseHtml": "それは いけませんね。<ruby>仕事<rp>(</rp><rt>しごと</rt><rp>)</rp></ruby>が <ruby>忙<rp>(</rp><rt>いそが</rt><rp>)</rp></ruby>しいんですか。",
                  "vietnamese": "Điều đó không tốt rồi. Công việc bận rộn lắm à?",
                  "vietnameseHtml": "Điều đó không tốt rồi. Công việc bận rộn lắm à?"
                }
              ]
            },
            {
              "speaker": "小川(おがわ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ストレスかもしれません。",
                  "japaneseHtml": "ストレスかもしれません。",
                  "vietnamese": "Không chừng là stress.",
                  "vietnameseHtml": "Không chừng là stress."
                },
                {
                  "kind": "tudich",
                  "japanese": "一度(いちど) 病院(びょういん)で 診(み)て もらった ほうが いいですよ。",
                  "japaneseHtml": "<ruby>一度<rp>(</rp><rt>いちど</rt><rp>)</rp></ruby> <ruby>病院<rp>(</rp><rt>びょういん</rt><rp>)</rp></ruby>で <ruby>診<rp>(</rp><rt>み</rt><rp>)</rp></ruby>て もらった ほうが いいですよ。",
                  "vietnamese": "Nên đi khám bệnh viện ấy.",
                  "vietnameseHtml": "Nên đi khám bệnh viện ấy."
                }
              ]
            },
            {
              "speaker": "シュミット：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>シュミット：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ、そうですね。",
                  "japaneseHtml": "ええ、そうですね。",
                  "vietnamese": "Vâng, đúng là như vậy nhỉ.",
                  "vietnameseHtml": "Vâng, đúng là như vậy nhỉ."
                }
              ]
            },
            {
              "speaker": "小川(おがわ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "無理(むり)を しない ほうが いいですよ。",
                  "japaneseHtml": "<ruby>無理<rp>(</rp><rt>むり</rt><rp>)</rp></ruby>を しない ほうが いいですよ。",
                  "vietnamese": "Không nên làm việc quá sức đâu.",
                  "vietnameseHtml": "Không nên làm việc quá sức đâu."
                }
              ]
            },
            {
              "speaker": "シュミット：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>シュミット： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ、今(いま)の 仕事(しごと)が 終(お)わったら、休(やす)みを 取(と)ろうと 思(おも)っています。",
                  "japaneseHtml": "ええ、<ruby>今<rp>(</rp><rt>いま</rt><rp>)</rp></ruby>の <ruby>仕事<rp>(</rp><rt>しごと</rt><rp>)</rp></ruby>が <ruby>終<rp>(</rp><rt>お</rt><rp>)</rp></ruby>わったら、<ruby>休<rp>(</rp><rt>やす</rt><rp>)</rp></ruby>みを <ruby>取<rp>(</rp><rt>と</rt><rp>)</rp></ruby>ろうと <ruby>思<rp>(</rp><rt>おも</rt><rp>)</rp></ruby>っています。",
                  "vietnamese": "Vâng, sau khi công việc hiện tại kết thúc thì tôi sẽ lấy kỳ nghỉ.",
                  "vietnameseHtml": "Vâng, sau khi công việc hiện tại kết thúc thì tôi sẽ lấy kỳ nghỉ."
                }
              ]
            },
            {
              "speaker": "小川(おがわ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "それは いいですね。",
                  "japaneseHtml": "それは いいですね。",
                  "vietnamese": "Điều đó tốt nhỉ.",
                  "vietnameseHtml": "Điều đó tốt nhỉ."
                }
              ]
            }
          ],
