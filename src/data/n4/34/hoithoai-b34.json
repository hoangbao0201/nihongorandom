          "rows": [
            {
              "speaker": "クララ：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>クララ：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "一度(いちど) 茶道(さどう)が 見(み)たいんですが･････。",
                  "japaneseHtml": "<ruby>一度<rp>(</rp><rt>いちど</rt><rp>)</rp></ruby> <ruby>茶道<rp>(</rp><rt>さどう</rt><rp>)</rp></ruby>が <ruby>見<rp>(</rp><rt>み</rt><rp>)</rp></ruby>たいんですが･････。",
                  "vietnamese": "Tôi muốn xem trà đạo một lần….",
                  "vietnameseHtml": "Tôi muốn xem trà đạo một lần…."
                }
              ]
            },
            {
              "speaker": "渡(わたり) 辺(へん)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>渡<rp>(</rp><rt>わたり</rt><rp>)</rp></ruby> <ruby>辺<rp>(</rp><rt>へん</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "じゃ、来週(らいしゅう)の 土曜日(どようび) いっしょに 行(い)きませんか。",
                  "japaneseHtml": "じゃ、<ruby>来週<rp>(</rp><rt>らいしゅう</rt><rp>)</rp></ruby>の <ruby>土曜日<rp>(</rp><rt>どようび</rt><rp>)</rp></ruby> いっしょに <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>きませんか。",
                  "vietnamese": "Vậy thì, thứ bảy tuần sau mình cùng đi nhé.",
                  "vietnameseHtml": "Vậy thì, thứ bảy tuần sau mình cùng đi nhé."
                }
              ]
            },
            {
              "speaker": "お茶(ちゃ)の先生(せんせい)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>お<ruby>茶<rp>(</rp><rt>ちゃ</rt><rp>)</rp></ruby>の<ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "渡辺(わたなべ)さん、お茶(ちゃ)を たてて ください。",
                  "japaneseHtml": "<ruby>渡辺<rp>(</rp><rt>わたなべ</rt><rp>)</rp></ruby>さん、お<ruby>茶<rp>(</rp><rt>ちゃ</rt><rp>)</rp></ruby>を たてて ください。",
                  "vietnamese": "Cô Watanabe, cô hãy pha trà nhé.",
                  "vietnameseHtml": "Cô Watanabe, cô hãy pha trà nhé."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "クララさん、お菓子(かし)を どうぞ。",
                  "japaneseHtml": "クララさん、お<ruby>菓子<rp>(</rp><rt>かし</rt><rp>)</rp></ruby>を どうぞ。",
                  "vietnamese": "Cô Kurara, mời cô ăn bánh.",
                  "vietnameseHtml": "Cô Kurara, mời cô ăn bánh."
                }
              ]
            },
            {
              "speaker": "クララ：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>クララ：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "えっ、先(さき)に お菓子(かし)を 食(た)べるんですか。",
                  "japaneseHtml": "えっ、<ruby>先<rp>(</rp><rt>さき</rt><rp>)</rp></ruby>に お<ruby>菓子<rp>(</rp><rt>かし</rt><rp>)</rp></ruby>を <ruby>食<rp>(</rp><rt>た</rt><rp>)</rp></ruby>べるんですか。",
                  "vietnamese": "Ồ, ăn bánh trước sao?",
                  "vietnameseHtml": "Ồ, ăn bánh trước sao?"
                }
              ]
            },
            {
              "speaker": "お茶(ちゃ)の先生(せんせい)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>お<ruby>茶<rp>(</rp><rt>ちゃ</rt><rp>)</rp></ruby>の<ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ。甘(あま)い お菓子(かし)を 食(た)べた あとで、お茶(ちゃ)を 飲(の)むと、おいしいんですよ。",
                  "japaneseHtml": "ええ。<ruby>甘<rp>(</rp><rt>あま</rt><rp>)</rp></ruby>い お<ruby>菓子<rp>(</rp><rt>かし</rt><rp>)</rp></ruby>を <ruby>食<rp>(</rp><rt>た</rt><rp>)</rp></ruby>べた あとで、お<ruby>茶<rp>(</rp><rt>ちゃ</rt><rp>)</rp></ruby>を <ruby>飲<rp>(</rp><rt>の</rt><rp>)</rp></ruby>むと、おいしいんですよ。",
                  "vietnamese": "Đúng vậy. Sau khi ăn bánh ngọt rồi thì khi uống trà vào sẽ rất ngon đấy.",
                  "vietnameseHtml": "Đúng vậy. Sau khi ăn bánh ngọt rồi thì khi uống trà vào sẽ rất ngon đấy."
                }
              ]
            },
            {
              "speaker": "クララ：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>クララ： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そうですか。",
                  "japaneseHtml": "そうですか。",
                  "vietnamese": "Vậy sao?",
                  "vietnameseHtml": "Vậy sao?"
                }
              ]
            },
            {
              "speaker": "お茶(ちゃ)の先生(せんせい)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>お<ruby>茶<rp>(</rp><rt>ちゃ</rt><rp>)</rp></ruby>の<ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "では、お茶(ちゃ)を 飲(の)みましょう。",
                  "japaneseHtml": "では、お<ruby>茶<rp>(</rp><rt>ちゃ</rt><rp>)</rp></ruby>を <ruby>飲<rp>(</rp><rt>の</rt><rp>)</rp></ruby>みましょう。",
                  "vietnamese": "Bây giờ thì hãy uống trà nào.",
                  "vietnameseHtml": "Bây giờ thì hãy uống trà nào."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "まず 右手(みぎて)で おちゃわんを 取(と)って、左手(ひだりて)に 載(の)せます。",
                  "japaneseHtml": "まず <ruby>右手<rp>(</rp><rt>みぎて</rt><rp>)</rp></ruby>で おちゃわんを <ruby>取<rp>(</rp><rt>と</rt><rp>)</rp></ruby>って、<ruby>左手<rp>(</rp><rt>ひだりて</rt><rp>)</rp></ruby>に <ruby>載<rp>(</rp><rt>の</rt><rp>)</rp></ruby>せます。",
                  "vietnamese": "Trước hết, lấy tách trà bằng tay phải và đặt lên bàn tay trái.",
                  "vietnameseHtml": "Trước hết, lấy tách trà bằng tay phải và đặt lên bàn tay trái."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "次(つぎ)に おちゃわんを 2回(かい) 回(まわ)して、それから 飲(の)みます。",
                  "japaneseHtml": "<ruby>次<rp>(</rp><rt>つぎ</rt><rp>)</rp></ruby>に おちゃわんを 2<ruby>回<rp>(</rp><rt>かい</rt><rp>)</rp></ruby> <ruby>回<rp>(</rp><rt>まわ</rt><rp>)</rp></ruby>して、それから <ruby>飲<rp>(</rp><rt>の</rt><rp>)</rp></ruby>みます。",
                  "vietnamese": "Tiếp theo hãy xoay tách trà 2 lần rồi uống.",
                  "vietnameseHtml": "Tiếp theo hãy xoay tách trà 2 lần rồi uống."
                }
              ]
            },
            {
              "speaker": "クララ：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>クララ： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "はい。",
                  "japaneseHtml": "はい。",
                  "vietnamese": "Vâng.",
                  "vietnameseHtml": "Vâng."
                }
              ]
            },
            {
              "speaker": "お茶(ちゃ)の先生(せんせい)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>お<ruby>茶<rp>(</rp><rt>ちゃ</rt><rp>)</rp></ruby>の<ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "じゃ、わたしが する とおりに、して くださいね。",
                  "japaneseHtml": "じゃ、わたしが する とおりに、して くださいね。",
                  "vietnamese": "Hãy làm theo như tôi làm nhé.",
                  "vietnameseHtml": "Hãy làm theo như tôi làm nhé."
                }
              ]
            },
            {
              "speaker": "クララ：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>クララ： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "これで いいですか。",
                  "japaneseHtml": "これで いいですか。",
                  "vietnamese": "Như vầy được chưa ạ?",
                  "vietnameseHtml": "Như vầy được chưa ạ?"
                }
              ]
            },
            {
              "speaker": "お茶(ちゃ)の先生(せんせい)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>お<ruby>茶<rp>(</rp><rt>ちゃ</rt><rp>)</rp></ruby>の<ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "はい。いかがですか。",
                  "japaneseHtml": "はい。いかがですか。",
                  "vietnamese": "Vâng. Chị thấy sao?",
                  "vietnameseHtml": "Vâng. Chị thấy sao?"
                }
              ]
            },
            {
              "speaker": "クララ：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>クララ：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "少(すこ)し 苦(にが)いですが、おいしいです。",
                  "japaneseHtml": "<ruby>少<rp>(</rp><rt>すこ</rt><rp>)</rp></ruby>し <ruby>苦<rp>(</rp><rt>にが</rt><rp>)</rp></ruby>いですが、おいしいです。",
                  "vietnamese": "Có hơi đắng một chút nhưng rất ngon.",
                  "vietnameseHtml": "Có hơi đắng một chút nhưng rất ngon."
                }
              ]
