          "kind": "dialogue",
          "rows": [
            {
              "speaker": "アナウンサー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>アナウンサー：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "きょうの お客様(きゃくさま)は ことし 80歳(さい)の 小川(おがわ)よねさんです。",
                  "japaneseHtml": "きょうの お<ruby>客様<rp>(</rp><rt>きゃくさま</rt><rp>)</rp></ruby>は ことし 80<ruby>歳<rp>(</rp><rt>さい</rt><rp>)</rp></ruby>の <ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>よねさんです。",
                  "vietnamese": "Vị khách ngày hôm nay là bà Ogawa Yone, năm nay 80 tuổi.",
                  "vietnameseHtml": "Vị khách ngày hôm nay là bà Ogawa Yone, năm nay 80 tuổi."
                }
              ]
            },
            {
              "speaker": "小川(おがわ) よね：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby> よね：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "こんにちは。",
                  "japaneseHtml": "こんにちは。",
                  "vietnamese": "Xin chào mọi người.",
                  "vietnameseHtml": "Xin chào mọi người."
                }
              ]
            },
            {
              "speaker": "アナウンサー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>アナウンサー： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "お元気(げんき)ですね。何(なに)か 特別(とくべつ)な ことを して いらっしゃいますか。",
                  "japaneseHtml": "お<ruby>元気<rp>(</rp><rt>げんき</rt><rp>)</rp></ruby>ですね。<ruby>何<rp>(</rp><rt>なに</rt><rp>)</rp></ruby>か <ruby>特別<rp>(</rp><rt>とくべつ</rt><rp>)</rp></ruby>な ことを して いらっしゃいますか。",
                  "vietnamese": "Bà trông thật khỏe mạnh. Bà có đang thực hiện phương pháp đặc biệt gì không?",
                  "vietnameseHtml": "Bà trông thật khỏe mạnh. Bà có đang thực hiện phương pháp đặc biệt gì không?"
                }
              ]
            },
            {
              "speaker": "小川(おがわ) よね：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby> よね：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "毎日(まいにち) 運動(うんどう)するように して います。",
                  "japaneseHtml": "<ruby>毎日<rp>(</rp><rt>まいにち</rt><rp>)</rp></ruby> <ruby>運動<rp>(</rp><rt>うんどう</rt><rp>)</rp></ruby>するように して います。",
                  "vietnamese": "Mỗi ngày tôi đều cố gắng vận động.",
                  "vietnameseHtml": "Mỗi ngày tôi đều cố gắng vận động."
                }
              ]
            },
            {
              "speaker": "アナウンサー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>アナウンサー： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "どんな 運動(うんどう)ですか。",
                  "japaneseHtml": "どんな <ruby>運動<rp>(</rp><rt>うんどう</rt><rp>)</rp></ruby>ですか。",
                  "vietnamese": "Vận động như thế nào ạ?",
                  "vietnameseHtml": "Vận động như thế nào ạ?"
                }
              ]
            },
            {
              "speaker": "小川(おがわ) よね：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby> よね： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ダンスとか、水泳(すいえい)とか ･････。",
                  "japaneseHtml": "ダンスとか、<ruby>水泳<rp>(</rp><rt>すいえい</rt><rp>)</rp></ruby>とか ･････。",
                  "vietnamese": "Nào là khiêu vũ, bơi lội,…",
                  "vietnameseHtml": "Nào là khiêu vũ, bơi lội,…"
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "最近(さいきん) ５００メートル 泳(およ)げるように なりました。",
                  "japaneseHtml": "<ruby>最近<rp>(</rp><rt>さいきん</rt><rp>)</rp></ruby> ５００メートル <ruby>泳<rp>(</rp><rt>およ</rt><rp>)</rp></ruby>げるように なりました。",
                  "vietnamese": "Dạo gần đây tôi cũng đã có thể bơi 500 mét.",
                  "vietnameseHtml": "Dạo gần đây tôi cũng đã có thể bơi 500 mét."
                }
              ]
            },
            {
              "speaker": "アナウンサー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong> アナウンサー：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "すごいですね。食(た)べ物(もの)は？",
                  "japaneseHtml": "すごいですね。<ruby>食<rp>(</rp><rt>た</rt><rp>)</rp></ruby>べ<ruby>物<rp>(</rp><rt>もの</rt><rp>)</rp></ruby>は？",
                  "vietnamese": "Thật là giỏi quá. Còn thức ăn thì sao ạ?",
                  "vietnameseHtml": "Thật là giỏi quá. Còn thức ăn thì sao ạ?"
                }
              ]
            },
            {
              "speaker": "小川(おがわ) よね：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong> <ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby> よね：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "何(なん)でも 食(た)べますが、特(とく)に 魚(さかな)が 好(す)きです。",
                  "japaneseHtml": "<ruby>何<rp>(</rp><rt>なん</rt><rp>)</rp></ruby>でも <ruby>食<rp>(</rp><rt>た</rt><rp>)</rp></ruby>べますが、<ruby>特<rp>(</rp><rt>とく</rt><rp>)</rp></ruby>に <ruby>魚<rp>(</rp><rt>さかな</rt><rp>)</rp></ruby>が <ruby>好<rp>(</rp><rt>す</rt><rp>)</rp></ruby>きです。",
                  "vietnamese": "Cái gì tôi cũng ăn nhưng tôi đặc biệt thích cá.",
                  "vietnameseHtml": "Cái gì tôi cũng ăn nhưng tôi đặc biệt thích cá."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "毎日(まいにち) 違(ちが)う 料理(りょうり)を 作(つく)るように して います。",
                  "japaneseHtml": "<ruby>毎日<rp>(</rp><rt>まいにち</rt><rp>)</rp></ruby> <ruby>違<rp>(</rp><rt>ちが</rt><rp>)</rp></ruby>う <ruby>料理<rp>(</rp><rt>りょうり</rt><rp>)</rp></ruby>を <ruby>作<rp>(</rp><rt>つく</rt><rp>)</rp></ruby>るように して います。",
                  "vietnamese": "Mỗi ngày tôi đều cố gắng làm những món khác nhau.",
                  "vietnameseHtml": "Mỗi ngày tôi đều cố gắng làm những món khác nhau."
                }
              ]
            },
            {
              "speaker": "アナウンサー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>アナウンサー： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "頭(あたま)と 体(からだ)を よく 使(つか)って いらっしゃるんですね。",
                  "japaneseHtml": "<ruby>頭<rp>(</rp><rt>あたま</rt><rp>)</rp></ruby>と <ruby>体<rp>(</rp><rt>からだ</rt><rp>)</rp></ruby>を よく <ruby>使<rp>(</rp><rt>つか</rt><rp>)</rp></ruby>って いらっしゃるんですね。",
                  "vietnamese": "Bà hay sử dụng trí óc và cơ thể thật.",
                  "vietnameseHtml": "Bà hay sử dụng trí óc và cơ thể thật."
                }
              ]
            },
            {
              "speaker": "小川(おがわ) よね：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby> よね：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ。来年(らいねん) フランスへ 行(い)きたいと 思(おも)っています。",
                  "japaneseHtml": "ええ。<ruby>来年<rp>(</rp><rt>らいねん</rt><rp>)</rp></ruby> フランスへ <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>きたいと <ruby>思<rp>(</rp><rt>おも</rt><rp>)</rp></ruby>っています。",
                  "vietnamese": "Đúng vậy. Tôi muốn đến Pháp vào năm sau.",
                  "vietnameseHtml": "Đúng vậy. Tôi muốn đến Pháp vào năm sau."
                },
                {
                  "kind": "tudich",
                  "japanese": "それで フランス語(ご)の 勉強(べんきょう)も 始(はじ)めました。",
                  "japaneseHtml": "それで フランス<ruby>語<rp>(</rp><rt>ご</rt><rp>)</rp></ruby>の <ruby>勉強<rp>(</rp><rt>べんきょう</rt><rp>)</rp></ruby>も <ruby>始<rp>(</rp><rt>はじ</rt><rp>)</rp></ruby>めました。",
                  "vietnamese": "Vì thế tôi cũng đã bắt đầu học tiếng Pháp.",
                  "vietnameseHtml": "Vì thế tôi cũng đã bắt đầu học tiếng Pháp."
                }
              ]
            },
            {
              "speaker": "アナウンサー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>アナウンサー： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "何(なん)でも チャレンジする 気持(きも)ちが 大切(たいせつ)ですね。",
                  "japaneseHtml": "<ruby>何<rp>(</rp><rt>なん</rt><rp>)</rp></ruby>でも チャレンジする <ruby>気持<rp>(</rp><rt>きも</rt><rp>)</rp></ruby>ちが <ruby>大切<rp>(</rp><rt>たいせつ</rt><rp>)</rp></ruby>ですね。",
                  "vietnamese": "Tinh thần thử thách với bất cứ mọi việc mới là quan trọng nhỉ.",
                  "vietnameseHtml": "Tinh thần thử thách với bất cứ mọi việc mới là quan trọng nhỉ."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "楽(たの)しい お話(はなし)、どうも ありがとう ございました。",
