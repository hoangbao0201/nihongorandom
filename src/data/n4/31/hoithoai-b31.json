          "kind": "dialogue",
          "rows": [
            {
              "speaker": "小川(おがわ)：",
              "speakerHtml": "<p> <span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>：</strong></span></p>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "来月(らいげつ)から 独身(どくしん)です。",
                  "japaneseHtml": "<ruby>来月<rp>(</rp><rt>らいげつ</rt><rp>)</rp></ruby>から <ruby>独身<rp>(</rp><rt>どくしん</rt><rp>)</rp></ruby>です。",
                  "vietnamese": "Từ tháng sau tôi sẽ độc thân đấy.",
                  "vietnameseHtml": "Từ tháng sau tôi sẽ độc thân đấy."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>ミラー：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "えっ？",
                  "japaneseHtml": "えっ？",
                  "vietnamese": "Hả?",
                  "vietnameseHtml": "Hả?"
                }
              ]
            },
            {
              "speaker": "小川(おがわ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "実(じつ)は 大阪(おおさか)の 本社(ほんしゃ)に 転勤(てんきん)なんです。",
                  "japaneseHtml": "<ruby>実<rp>(</rp><rt>じつ</rt><rp>)</rp></ruby>は <ruby>大阪<rp>(</rp><rt>おおさか</rt><rp>)</rp></ruby>の <ruby>本社<rp>(</rp><rt>ほんしゃ</rt><rp>)</rp></ruby>に <ruby>転勤<rp>(</rp><rt>てんきん</rt><rp>)</rp></ruby>なんです。",
                  "vietnamese": "Thật ra là tôi sẽ chuyển đến làm việc tại tổng công ty ở Osaka.",
                  "vietnameseHtml": "Thật ra là tôi sẽ chuyển đến làm việc tại tổng công ty ở Osaka."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>ミラー：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "本社(ほんしゃ)ですか。それは おめでとう ございます。でも、どうして 独身(どくしん)に なるんですか。",
                  "japaneseHtml": "<ruby>本社<rp>(</rp><rt>ほんしゃ</rt><rp>)</rp></ruby>ですか。それは おめでとう ございます。でも、どうして <ruby>独身<rp>(</rp><rt>どくしん</rt><rp>)</rp></ruby>に なるんですか。",
                  "vietnamese": "Tổng công ty à? Vậy thì chúc mừng anh nhé. Nhưng mà, tại sao anh lại trở thành độc thân vậy?",
                  "vietnameseHtml": "Tổng công ty à? Vậy thì chúc mừng anh nhé. Nhưng mà, tại sao anh lại trở thành độc thân vậy?"
                }
              ]
            },
            {
              "speaker": "小川(おがわ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "妻(つま)と 子(こ)どもは 東京(とうきょう)に 残(のこ)るんです。",
                  "japaneseHtml": "<ruby>妻<rp>(</rp><rt>つま</rt><rp>)</rp></ruby>と <ruby>子<rp>(</rp><rt>こ</rt><rp>)</rp></ruby>どもは <ruby>東京<rp>(</rp><rt>とうきょう</rt><rp>)</rp></ruby>に <ruby>残<rp>(</rp><rt>のこ</rt><rp>)</rp></ruby>るんです。",
                  "vietnamese": "Vì vợ và con tôi sẽ ở lại Tokyo.",
                  "vietnameseHtml": "Vì vợ và con tôi sẽ ở lại Tokyo."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>ミラー： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "えっ、いっしょに 行(い)かないんですか。",
                  "japaneseHtml": "えっ、いっしょに <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>かないんですか。",
                  "vietnamese": "Ồ, họ không đi cùng à?",
                  "vietnameseHtml": "Ồ, họ không đi cùng à?"
                }
              ]
            },
            {
              "speaker": "小川(おがわ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ。息子(むすこ)は 来年(らいねん) 大学(だいがく)の 入学(にゅうがく)試験(しけん)が あるから、東京(とうきょう)に残(のこ)るというし、 妻(つま)も今(いま)の 会社(かいしゃ)を やめたくないと 言(い)うんです。",
                  "japaneseHtml": "ええ。<ruby>息子<rp>(</rp><rt>むすこ</rt><rp>)</rp></ruby>は <ruby>来年<rp>(</rp><rt>らいねん</rt><rp>)</rp></ruby> <ruby>大学<rp>(</rp><rt>だいがく</rt><rp>)</rp></ruby>の <ruby>入学<rp>(</rp><rt>にゅうがく</rt><rp>)</rp></ruby><ruby>試験<rp>(</rp><rt>しけん</rt><rp>)</rp></ruby>が あるから、<ruby>東京<rp>(</rp><rt>とうきょう</rt><rp>)</rp></ruby>に<ruby>残<rp>(</rp><rt>のこ</rt><rp>)</rp></ruby>るというし、 <ruby>妻<rp>(</rp><rt>つま</rt><rp>)</rp></ruby>も<ruby>今<rp>(</rp><rt>いま</rt><rp>)</rp></ruby>の <ruby>会社<rp>(</rp><rt>かいしゃ</rt><rp>)</rp></ruby>を やめたくないと <ruby>言<rp>(</rp><rt>い</rt><rp>)</rp></ruby>うんです。",
                  "vietnamese": "Vâng. Con trai tôi thì nói là có kỳ thi đại học vào năm sau, còn vợ tôi thì không muốn nghỉ việc ở công ty hiện tại.",
                  "vietnameseHtml": "Vâng. Con trai tôi thì nói là có kỳ thi đại học vào năm sau, còn vợ tôi thì không muốn nghỉ việc ở công ty hiện tại."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>ミラー： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "それで、別(べつ)々に 住(す)むんですか。",
                  "japaneseHtml": "それで、<ruby>別<rp>(</rp><rt>べつ</rt><rp>)</rp></ruby>々に <ruby>住<rp>(</rp><rt>す</rt><rp>)</rp></ruby>むんですか。",
                  "vietnamese": "Vì thế nên anh sống riêng à?",
                  "vietnameseHtml": "Vì thế nên anh sống riêng à?"
                }
              ]
            },
            {
              "speaker": "小川(おがわ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ、でも、月(つき)に 2、3回(かい) 週末(しゅうまつ)に 帰(かえ)る つもりです。",
                  "japaneseHtml": "ええ、でも、<ruby>月<rp>(</rp><rt>つき</rt><rp>)</rp></ruby>に 2、3<ruby>回<rp>(</rp><rt>かい</rt><rp>)</rp></ruby> <ruby>週末<rp>(</rp><rt>しゅうまつ</rt><rp>)</rp></ruby>に <ruby>帰<rp>(</rp><rt>かえ</rt><rp>)</rp></ruby>る つもりです。",
                  "vietnamese": "Vâng. Nhưng mà một tháng tôi tính về nhà 2, 3 lần vào cuối tuần.",
                  "vietnameseHtml": "Vâng. Nhưng mà một tháng tôi tính về nhà 2, 3 lần vào cuối tuần."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>ミラー： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "大変(たいへん)ですね。",
                  "japaneseHtml": "<ruby>大変<rp>(</rp><rt>たいへん</rt><rp>)</rp></ruby>ですね。",
                  "vietnamese": "Vất vả thật đấy.",
                  "vietnameseHtml": "Vất vả thật đấy."
                }
              ]
            },
            {
              "speaker": "小川(おがわ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "でも、いい チャンスですから、料理(りょうり)を 習(なら)おうと 思(おも)って います。",
                  "japaneseHtml": "でも、いい チャンスですから、<ruby>料理<rp>(</rp><rt>りょうり</rt><rp>)</rp></ruby>を <ruby>習<rp>(</rp><rt>なら</rt><rp>)</rp></ruby>おうと <ruby>思<rp>(</rp><rt>おも</rt><rp>)</rp></ruby>って います。",
                  "vietnamese": "Nhưng mà, đó là cơ hội tốt nên tôi tính học nấu ăn.",
                  "vietnameseHtml": "Nhưng mà, đó là cơ hội tốt nên tôi tính học nấu ăn."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>ミラー： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "それは いいですね。",
                  "japaneseHtml": "それは いいですね。",
                  "vietnamese": "Vậy tốt đấy nhỉ.",
                  "vietnameseHtml": "Vậy tốt đấy nhỉ."
                }
              ]
            }
          ],
          "contentHtml": "<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"khung\" style=\" width: 100%;\"> <tbody> <tr> <td style=\"width: 13%;\"> <p> <span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>：</strong></span></p> </td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>来月<rp>(</rp><rt>らいげつ</rt><rp>)</rp></ruby>から <ruby>独身<rp>(</rp><rt>どくしん</rt><rp>)</rp></ruby>です。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Từ tháng sau tôi sẽ độc thân đấy.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>ミラー：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">えっ？</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Hả?</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\"> <ruby>実<rp>(</rp><rt>じつ</rt><rp>)</rp></ruby>は <ruby>大阪<rp>(</rp><rt>おおさか</rt><rp>)</rp></ruby>の <ruby>本社<rp>(</rp><rt>ほんしゃ</rt><rp>)</rp></ruby>に <ruby>転勤<rp>(</rp><rt>てんきん</rt><rp>)</rp></ruby>なんです。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Thật ra là tôi sẽ chuyển đến làm việc tại tổng công ty ở Osaka.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>ミラー：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>本社<rp>(</rp><rt>ほんしゃ</rt><rp>)</rp></ruby>ですか。それは おめでとう ございます。でも、どうして <ruby>独身<rp>(</rp><rt>どくしん</rt><rp>)</rp></ruby>に なるんですか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Tổng công ty à? Vậy thì chúc mừng anh nhé. Nhưng mà, tại sao anh lại trở thành độc thân vậy?</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>妻<rp>(</rp><rt>つま</rt><rp>)</rp></ruby>と <ruby>子<rp>(</rp><rt>こ</rt><rp>)</rp></ruby>どもは <ruby>東京<rp>(</rp><rt>とうきょう</rt><rp>)</rp></ruby>に <ruby>残<rp>(</rp><rt>のこ</rt><rp>)</rp></ruby>るんです。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vì vợ và con tôi sẽ ở lại Tokyo.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>ミラー： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">えっ、いっしょに <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>かないんですか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Ồ, họ không đi cùng à?</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">ええ。<ruby>息子<rp>(</rp><rt>むすこ</rt><rp>)</rp></ruby>は <ruby>来年<rp>(</rp><rt>らいねん</rt><rp>)</rp></ruby> <ruby>大学<rp>(</rp><rt>だいがく</rt><rp>)</rp></ruby>の <ruby>入学<rp>(</rp><rt>にゅうがく</rt><rp>)</rp></ruby><ruby>試験<rp>(</rp><rt>しけん</rt><rp>)</rp></ruby>が あるから、<ruby>東京<rp>(</rp><rt>とうきょう</rt><rp>)</rp></ruby>に<ruby>残<rp>(</rp><rt>のこ</rt><rp>)</rp></ruby>るというし、 <ruby>妻<rp>(</rp><rt>つま</rt><rp>)</rp></ruby>も<ruby>今<rp>(</rp><rt>いま</rt><rp>)</rp></ruby>の <ruby>会社<rp>(</rp><rt>かいしゃ</rt><rp>)</rp></ruby>を やめたくないと <ruby>言<rp>(</rp><rt>い</rt><rp>)</rp></ruby>うんです。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vâng. Con trai tôi thì nói là có kỳ thi đại học vào năm sau, còn vợ tôi thì không muốn nghỉ việc ở công ty hiện tại.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>ミラー： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">それで、<ruby>別<rp>(</rp><rt>べつ</rt><rp>)</rp></ruby>々に <ruby>住<rp>(</rp><rt>す</rt><rp>)</rp></ruby>むんですか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vì thế nên anh sống riêng à?</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">ええ、でも、<ruby>月<rp>(</rp><rt>つき</rt><rp>)</rp></ruby>に 2、3<ruby>回<rp>(</rp><rt>かい</rt><rp>)</rp></ruby> <ruby>週末<rp>(</rp><rt>しゅうまつ</rt><rp>)</rp></ruby>に <ruby>帰<rp>(</rp><rt>かえ</rt><rp>)</rp></ruby>る つもりです。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vâng. Nhưng mà một tháng tôi tính về nhà 2, 3 lần vào cuối tuần.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>ミラー： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>大変<rp>(</rp><rt>たいへん</rt><rp>)</rp></ruby>ですね。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vất vả thật đấy.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">でも、いい チャンスですから、<ruby>料理<rp>(</rp><rt>りょうり</rt><rp>)</rp></ruby>を <ruby>習<rp>(</rp><rt>なら</rt><rp>)</rp></ruby>おうと <ruby>思<rp>(</rp><rt>おも</rt><rp>)</rp></ruby>って います。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Nhưng mà, đó là cơ hội tốt nên tôi tính học nấu ăn.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>ミラー： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">それは いいですね。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vậy tốt đấy nhỉ.</div></div></div></td> </tr> </tbody> </table>"
        }
      ]
    },
