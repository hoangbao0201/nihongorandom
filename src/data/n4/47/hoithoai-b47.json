          "kind": "dialogue",
          "rows": [
            {
              "speaker": "渡辺(わたなべ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>渡辺<rp>(</rp><rt>わたなべ</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "お先(さき)に 失礼(しつれい)します。",
                  "japaneseHtml": "お<ruby>先<rp>(</rp><rt>さき</rt><rp>)</rp></ruby>に <ruby>失礼<rp>(</rp><rt>しつれい</rt><rp>)</rp></ruby>します。",
                  "vietnamese": "Tôi xin phép về trước.",
                  "vietnameseHtml": "Tôi xin phép về trước."
                }
              ]
            },
            {
              "speaker": "高橋(たかはし)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>高橋<rp>(</rp><rt>たかはし</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "あっ、渡辺(わたなべ)さん、ちょっと 待(ま)って。僕(ぼく)も 帰(かえ)ります。",
                  "japaneseHtml": "あっ、<ruby>渡辺<rp>(</rp><rt>わたなべ</rt><rp>)</rp></ruby>さん、ちょっと <ruby>待<rp>(</rp><rt>ま</rt><rp>)</rp></ruby>って。<ruby>僕<rp>(</rp><rt>ぼく</rt><rp>)</rp></ruby>も <ruby>帰<rp>(</rp><rt>かえ</rt><rp>)</rp></ruby>ります。",
                  "vietnamese": "A, cô Watanabe, đợi tôi chút. Tôi cũng về.",
                  "vietnameseHtml": "A, cô Watanabe, đợi tôi chút. Tôi cũng về."
                }
              ]
            },
            {
              "speaker": "渡辺(わたなべ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>渡辺<rp>(</rp><rt>わたなべ</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "すみません。ちょっと 急(いそ)ぎますから。",
                  "japaneseHtml": "すみません。ちょっと <ruby>急<rp>(</rp><rt>いそ</rt><rp>)</rp></ruby>ぎますから。",
                  "vietnamese": "Xin lỗi, tôi đang vội.",
                  "vietnameseHtml": "Xin lỗi, tôi đang vội."
                }
              ]
            },
            {
              "speaker": "高橋(たかはし)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>高橋<rp>(</rp><rt>たかはし</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "渡辺(わたなべ)さん、このごろ 早(はや)く 帰(かえ)りますね。",
                  "japaneseHtml": "<ruby>渡辺<rp>(</rp><rt>わたなべ</rt><rp>)</rp></ruby>さん、このごろ <ruby>早<rp>(</rp><rt>はや</rt><rp>)</rp></ruby>く <ruby>帰<rp>(</rp><rt>かえ</rt><rp>)</rp></ruby>りますね。",
                  "vietnamese": "Cô Watanabe, dạo này hay về sớm nhỉ.",
                  "vietnameseHtml": "Cô Watanabe, dạo này hay về sớm nhỉ."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "どうも 恋人(こいびと)が できたようですね。",
                  "japaneseHtml": "どうも <ruby>恋人<rp>(</rp><rt>こいびと</rt><rp>)</rp></ruby>が できたようですね。",
                  "vietnamese": "Hình như cô ấy có người yêu rồi thì phải.",
                  "vietnameseHtml": "Hình như cô ấy có người yêu rồi thì phải."
                }
              ]
            },
            {
              "speaker": "林(はやし)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>林<rp>(</rp><rt>はやし</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "あ、知(し)らないですか。この間(あいだ) 婚約(こんやく)したそうですよ。",
                  "japaneseHtml": "あ、<ruby>知<rp>(</rp><rt>し</rt><rp>)</rp></ruby>らないですか。この<ruby>間<rp>(</rp><rt>あいだ</rt><rp>)</rp></ruby> <ruby>婚約<rp>(</rp><rt>こんやく</rt><rp>)</rp></ruby>したそうですよ。",
                  "vietnamese": "A, anh không biết sao. Nghe nói gần đây chị ấy mới đính hôn đấy,",
                  "vietnameseHtml": "A, anh không biết sao. Nghe nói gần đây chị ấy mới đính hôn đấy,"
                }
              ]
            },
            {
              "speaker": "高橋(たかはし)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>高橋<rp>(</rp><rt>たかはし</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "えっ、だれですか 、相手(あいて)は。",
                  "japaneseHtml": "えっ、だれですか 、<ruby>相手<rp>(</rp><rt>あいて</rt><rp>)</rp></ruby>は。",
                  "vietnamese": "Hả, đối tượng là ai vậy?",
                  "vietnameseHtml": "Hả, đối tượng là ai vậy?"
                }
              ]
            },
            {
              "speaker": "林(はやし)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>林<rp>(</rp><rt>はやし</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ＩＭＣの 鈴木(すずき)さんですよ。",
                  "japaneseHtml": "ＩＭＣの <ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>さんですよ。",
                  "vietnamese": "Anh Suzuki của IMC đấy.",
                  "vietnameseHtml": "Anh Suzuki của IMC đấy."
                }
              ]
            },
            {
              "speaker": "高橋(たかはし)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>高橋<rp>(</rp><rt>たかはし</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "えっ、鈴木(すずき)さん？",
                  "japaneseHtml": "えっ、<ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>さん？",
                  "vietnamese": "Hả, Suzuki sao?",
                  "vietnameseHtml": "Hả, Suzuki sao?"
                }
              ]
            },
            {
              "speaker": "林(はやし)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>林<rp>(</rp><rt>はやし</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ワットさんの 結婚式(けっこんしき)で 知(し)り合(あ)ったそうですよ。",
                  "japaneseHtml": "ワットさんの <ruby>結婚式<rp>(</rp><rt>けっこんしき</rt><rp>)</rp></ruby>で <ruby>知<rp>(</rp><rt>し</rt><rp>)</rp></ruby>り<ruby>合<rp>(</rp><rt>あ</rt><rp>)</rp></ruby>ったそうですよ。",
                  "vietnamese": "Nghe nói họ đã quen nhau tại đám cưới của ông Watt.",
                  "vietnameseHtml": "Nghe nói họ đã quen nhau tại đám cưới của ông Watt."
                }
              ]
            },
            {
              "speaker": "高橋(たかはし)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>高橋<rp>(</rp><rt>たかはし</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そうですか。",
                  "japaneseHtml": "そうですか。",
                  "vietnamese": "Vậy à.",
                  "vietnameseHtml": "Vậy à."
                }
              ]
            },
            {
              "speaker": "林(はやし)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>林<rp>(</rp><rt>はやし</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ところで、高橋(たかはし)さんは？",
                  "japaneseHtml": "ところで、<ruby>高橋<rp>(</rp><rt>たかはし</rt><rp>)</rp></ruby>さんは？",
                  "vietnamese": "Nhân tiện, còn anh Takahashi thì sao?",
                  "vietnameseHtml": "Nhân tiện, còn anh Takahashi thì sao?"
                }
              ]
            },
            {
              "speaker": "高橋(たかはし)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>高橋<rp>(</rp><rt>たかはし</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "僕(ぼく)ですか。僕(ぼく)は 仕事(しごと)が 恋人(こいびと)です。",
                  "japaneseHtml": "<ruby>僕<rp>(</rp><rt>ぼく</rt><rp>)</rp></ruby>ですか。<ruby>僕<rp>(</rp><rt>ぼく</rt><rp>)</rp></ruby>は <ruby>仕事<rp>(</rp><rt>しごと</rt><rp>)</rp></ruby>が <ruby>恋人<rp>(</rp><rt>こいびと</rt><rp>)</rp></ruby>です。",
                  "vietnamese": "Tôi ấy à. Tôi thì công việc là người yêu đấy.",
                  "vietnameseHtml": "Tôi ấy à. Tôi thì công việc là người yêu đấy."
                }
