            {
              "speaker": "鈴木(すずき)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "林(はやし)さん、ボーナスは いつ 出(で)るんですか。",
                  "japaneseHtml": "<ruby>林<rp>(</rp><rt>はやし</rt><rp>)</rp></ruby>さん、ボーナスは いつ <ruby>出<rp>(</rp><rt>で</rt><rp>)</rp></ruby>るんですか。",
                  "vietnamese": "Cô Hayashi này, chừng nào có thưởng vậy?",
                  "vietnameseHtml": "Cô Hayashi này, chừng nào có thưởng vậy?"
                }
              ]
