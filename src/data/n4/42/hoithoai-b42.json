            {
              "speaker": "林(はやし)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>林<rp>(</rp><rt>はやし</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "来週(らいしゅう)です。鈴木(すずき)さんの会社(かいしゃ)は？",
                  "japaneseHtml": "<ruby>来週<rp>(</rp><rt>らいしゅう</rt><rp>)</rp></ruby>です。<ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>さんの<ruby>会社<rp>(</rp><rt>かいしゃ</rt><rp>)</rp></ruby>は？",
                  "vietnamese": "Tuần sau cơ. Còn công ty anh Suzuki thì sao?",
                  "vietnameseHtml": "Tuần sau cơ. Còn công ty anh Suzuki thì sao?"
                }
              ]
            },
            {
              "speaker": "鈴木(すずき)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "あしたです。楽(たの)しみですね。",
                  "japaneseHtml": "あしたです。<ruby>楽<rp>(</rp><rt>たの</rt><rp>)</rp></ruby>しみですね。",
                  "vietnamese": "Ngày mai đấy. Tôi đang trông chờ đây.",
                  "vietnameseHtml": "Ngày mai đấy. Tôi đang trông chờ đây."
                }
              ]
            },
            {
              "speaker": "林(はやし)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>林<rp>(</rp><rt>はやし</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ。鈴木(すずき)さんは 何(なに)に 使(つか)いますか。",
                  "japaneseHtml": "ええ。<ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>さんは <ruby>何<rp>(</rp><rt>なに</rt><rp>)</rp></ruby>に <ruby>使<rp>(</rp><rt>つか</rt><rp>)</rp></ruby>いますか。",
                  "vietnamese": "Vâng, anh Suzuki dùng cho việc gì?",
                  "vietnameseHtml": "Vâng, anh Suzuki dùng cho việc gì?"
                }
              ]
            },
            {
              "speaker": "鈴木(すずき)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "まず 新(あたら)しい 自転車(じてんしゃ)を 買(か)って、それから 旅行(りょこう)に 行(い)って･････。",
                  "japaneseHtml": "まず <ruby>新<rp>(</rp><rt>あたら</rt><rp>)</rp></ruby>しい <ruby>自転車<rp>(</rp><rt>じてんしゃ</rt><rp>)</rp></ruby>を <ruby>買<rp>(</rp><rt>か</rt><rp>)</rp></ruby>って、それから <ruby>旅行<rp>(</rp><rt>りょこう</rt><rp>)</rp></ruby>に <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>って･････。",
                  "vietnamese": "Trước tiên tôi sẽ mua xe hơi mới, rồi sau đó sẽ đi du lịch…",
                  "vietnameseHtml": "Trước tiên tôi sẽ mua xe hơi mới, rồi sau đó sẽ đi du lịch…"
                }
              ]
            },
            {
              "speaker": "小川(おがわ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "貯金(ちょきん)は しないんですか。",
                  "japaneseHtml": "<ruby>貯金<rp>(</rp><rt>ちょきん</rt><rp>)</rp></ruby>は しないんですか。",
                  "vietnamese": "Anh không để dành tiền à?",
                  "vietnameseHtml": "Anh không để dành tiền à?"
                }
              ]
            },
            {
              "speaker": "鈴木(すずき)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "僕(ぼく)は あまり 考(かんが)えた こと、ありませんね。",
                  "japaneseHtml": "<ruby>僕<rp>(</rp><rt>ぼく</rt><rp>)</rp></ruby>は あまり <ruby>考<rp>(</rp><rt>かんが</rt><rp>)</rp></ruby>えた こと、ありませんね。",
                  "vietnamese": "Tôi không nghĩ đến cho lắm đâu.",
                  "vietnameseHtml": "Tôi không nghĩ đến cho lắm đâu."
                }
              ]
            },
            {
              "speaker": "林(はやし)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>林<rp>(</rp><rt>はやし</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "わたしは 半分(はんぶん)は 貯金(ちょきん)する つもりです。",
                  "japaneseHtml": "わたしは <ruby>半分<rp>(</rp><rt>はんぶん</rt><rp>)</rp></ruby>は <ruby>貯金<rp>(</rp><rt>ちょきん</rt><rp>)</rp></ruby>する つもりです。",
                  "vietnamese": "Tôi thì dự định để dành một nữa.",
                  "vietnameseHtml": "Tôi thì dự định để dành một nữa."
                }
              ]
            },
            {
              "speaker": "鈴木(すずき)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>鈴木<rp>(</rp><rt>すずき</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "えっ、半分(はんぶん)も 貯金(ちょきん)するんですか。",
                  "japaneseHtml": "えっ、<ruby>半分<rp>(</rp><rt>はんぶん</rt><rp>)</rp></ruby>も <ruby>貯金<rp>(</rp><rt>ちょきん</rt><rp>)</rp></ruby>するんですか。",
                  "vietnamese": "Ủa, để dành một nữa cơ à?",
                  "vietnameseHtml": "Ủa, để dành một nữa cơ à?"
                }
              ]
            },
            {
              "speaker": "林(はやし)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>林<rp>(</rp><rt>はやし</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ。いつか イギリスへ 留学(りゅうがく)しようと 思(おも)って いるんです。",
                  "japaneseHtml": "ええ。いつか イギリスへ <ruby>留学<rp>(</rp><rt>りゅうがく</rt><rp>)</rp></ruby>しようと <ruby>思<rp>(</rp><rt>おも</rt><rp>)</rp></ruby>って いるんです。",
                  "vietnamese": "Vâng. Tôi dự định lúc nào đó sẽ đi du học ở Anh.",
                  "vietnameseHtml": "Vâng. Tôi dự định lúc nào đó sẽ đi du học ở Anh."
                }
              ]
            },
            {
              "speaker": "小川(おがわ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>小川<rp>(</rp><rt>おがわ</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "へえ、独身(どくしん)の 人(ひと)は いいですね。全部(ぜんぶ) 自分(じぶん)の ために 使(つか)えて。",
                  "japaneseHtml": "へえ、<ruby>独身<rp>(</rp><rt>どくしん</rt><rp>)</rp></ruby>の <ruby>人<rp>(</rp><rt>ひと</rt><rp>)</rp></ruby>は いいですね。<ruby>全部<rp>(</rp><rt>ぜんぶ</rt><rp>)</rp></ruby> <ruby>自分<rp>(</rp><rt>じぶん</rt><rp>)</rp></ruby>の ために <ruby>使<rp>(</rp><rt>つか</rt><rp>)</rp></ruby>えて。",
                  "vietnamese": "Ôi, người độc thân sướng nhỉ. Có thể dùng toàn bộ cho bản thân mình.",
                  "vietnameseHtml": "Ôi, người độc thân sướng nhỉ. Có thể dùng toàn bộ cho bản thân mình."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "わたしは 家(いえ)の ローンを 払(はら)って、子(こ)どもの 教育(きょういく)の ために、貯金(ちょきん)したら、ほとんど 残(のこ)りませんよ。",
                  "japaneseHtml": "わたしは <ruby>家<rp>(</rp><rt>いえ</rt><rp>)</rp></ruby>の ローンを <ruby>払<rp>(</rp><rt>はら</rt><rp>)</rp></ruby>って、<ruby>子<rp>(</rp><rt>こ</rt><rp>)</rp></ruby>どもの <ruby>教育<rp>(</rp><rt>きょういく</rt><rp>)</rp></ruby>の ために、<ruby>貯金<rp>(</rp><rt>ちょきん</rt><rp>)</rp></ruby>したら、ほとんど <ruby>残<rp>(</rp><rt>のこ</rt><rp>)</rp></ruby>りませんよ。",
                  "vietnamese": "Tôi thì vì phải trả góp cho căn nhà, rồi phải để dành chi tiền học cho con, nên chẳng còn lại bao nhiêu.",
                  "vietnameseHtml": "Tôi thì vì phải trả góp cho căn nhà, rồi phải để dành chi tiền học cho con, nên chẳng còn lại bao nhiêu."
                }
              ]
