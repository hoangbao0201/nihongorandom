            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>ミラー：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "明(あか)るくて、いい 部屋(へや)ですね。",
                  "japaneseHtml": "<ruby>明<rp>(</rp><rt>あか</rt><rp>)</rp></ruby>るくて、いい <ruby>部屋<rp>(</rp><rt>へや</rt><rp>)</rp></ruby>ですね。",
                  "vietnamese": "Căn phòng sáng sủa và tốt thật.",
                  "vietnameseHtml": "Căn phòng sáng sủa và tốt thật."
                }
              ]
            },
            {
              "speaker": "鈴(すず) 木(き)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby> <ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ。天気(てんき)が いい 日(ひ)には 海(うみ)が 見(み)えるんです。",
                  "japaneseHtml": "ええ。<ruby>天気<rp>(</rp><rt>てんき</rt><rp>)</rp></ruby>が いい <ruby>日<rp>(</rp><rt>ひ</rt><rp>)</rp></ruby>には <ruby>海<rp>(</rp><rt>うみ</rt><rp>)</rp></ruby>が <ruby>見<rp>(</rp><rt>み</rt><rp>)</rp></ruby>えるんです。",
                  "vietnamese": "Vâng. Vào những ngày thời tiết tốt sẽ nhìn thấy biển đấy.",
                  "vietnameseHtml": "Vâng. Vào những ngày thời tiết tốt sẽ nhìn thấy biển đấy."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>ミラー：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "この テーブルは おもしろい デザインですね。",
                  "japaneseHtml": "この テーブルは おもしろい デザインですね。",
                  "vietnamese": "Cái bàn này có thiết kế đẹp thật.",
                  "vietnameseHtml": "Cái bàn này có thiết kế đẹp thật."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "どこで 買(か)ったんですか。",
                  "japaneseHtml": "どこで <ruby>買<rp>(</rp><rt>か</rt><rp>)</rp></ruby>ったんですか。",
                  "vietnamese": "Anh đã mua ở đâu vậy?",
                  "vietnameseHtml": "Anh đã mua ở đâu vậy?"
                }
              ]
            },
            {
              "speaker": "鈴(すず) 木(き)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby> <ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "これは わたしが 作(つく)ったんですよ。",
                  "japaneseHtml": "これは わたしが <ruby>作<rp>(</rp><rt>つく</rt><rp>)</rp></ruby>ったんですよ。",
                  "vietnamese": "Cái này là tôi đã tự làm đấy.",
                  "vietnameseHtml": "Cái này là tôi đã tự làm đấy."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>ミラー：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "えっ、ほんとうですか。",
                  "japaneseHtml": "えっ、ほんとうですか。",
                  "vietnamese": "Hả, thật à?",
                  "vietnameseHtml": "Hả, thật à?"
                }
              ]
            },
            {
              "speaker": "鈴(すず) 木(き)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby> <ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ。趣味(しゅみ)は 自分(じぶん)で 家具(かぐ)を 作(つく)る ことなんです。",
                  "japaneseHtml": "ええ。<ruby>趣味<rp>(</rp><rt>しゅみ</rt><rp>)</rp></ruby>は <ruby>自分<rp>(</rp><rt>じぶん</rt><rp>)</rp></ruby>で <ruby>家具<rp>(</rp><rt>かぐ</rt><rp>)</rp></ruby>を <ruby>作<rp>(</rp><rt>つく</rt><rp>)</rp></ruby>る ことなんです。",
                  "vietnamese": "Vâng. Sở thích của tôi là làm dụng cụ tại nhà.",
                  "vietnameseHtml": "Vâng. Sở thích của tôi là làm dụng cụ tại nhà."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>ミラー：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "へえ。じゃ、あの 本棚(ほんだな)も 作(つく)ったんですか。",
                  "japaneseHtml": "へえ。じゃ、あの <ruby>本棚<rp>(</rp><rt>ほんだな</rt><rp>)</rp></ruby>も <ruby>作<rp>(</rp><rt>つく</rt><rp>)</rp></ruby>ったんですか。",
                  "vietnamese": "Ồ. Vậy cái kệ sách này chắc anh cũng tự làm hả?",
                  "vietnameseHtml": "Ồ. Vậy cái kệ sách này chắc anh cũng tự làm hả?"
                }
              ]
            },
            {
              "speaker": "鈴(すず) 木(き)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby> <ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ。",
                  "japaneseHtml": "ええ。",
                  "vietnamese": "Đúng vậy.",
                  "vietnameseHtml": "Đúng vậy."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>ミラー：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "すごいですね。鈴(すず)木(き)さん、何(なん)でも 作(つく)れるんですね。",
                  "japaneseHtml": "すごいですね。<ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby><ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>さん、<ruby>何<rp>(</rp><rt>なん</rt><rp>)</rp></ruby>でも <ruby>作<rp>(</rp><rt>つく</rt><rp>)</rp></ruby>れるんですね。",
                  "vietnamese": "Anh giỏi thật. Anh Suzuki, cái gì cũng có thể làm được ấy nhỉ.",
                  "vietnameseHtml": "Anh giỏi thật. Anh Suzuki, cái gì cũng có thể làm được ấy nhỉ."
                }
              ]
            },
            {
              "speaker": "鈴(すず) 木(き)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby> <ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "わたしの 夢(ゆめ)は いつか 自分(じぶん)で 家(いえ)を 建(た)てる ことなんです。",
                  "japaneseHtml": "わたしの <ruby>夢<rp>(</rp><rt>ゆめ</rt><rp>)</rp></ruby>は いつか <ruby>自分<rp>(</rp><rt>じぶん</rt><rp>)</rp></ruby>で <ruby>家<rp>(</rp><rt>いえ</rt><rp>)</rp></ruby>を <ruby>建<rp>(</rp><rt>た</rt><rp>)</rp></ruby>てる ことなんです。",
                  "vietnamese": "Giấc mơ của tôi là ngày nào đó sẽ tự mình xây nhà mà.",
                  "vietnameseHtml": "Giấc mơ của tôi là ngày nào đó sẽ tự mình xây nhà mà."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>ミラー：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "すばらしい 夢(ゆめ)ですね。",
                  "japaneseHtml": "すばらしい <ruby>夢<rp>(</rp><rt>ゆめ</rt><rp>)</rp></ruby>ですね。",
                  "vietnamese": "Giấc mơ tuyệt thật đấy.",
                  "vietnameseHtml": "Giấc mơ tuyệt thật đấy."
                }
              ]
            }
          ],
          "contentHtml": "<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"khung\" style=\" width: 100%;\"> <tbody> <tr> <td style=\"width: 120px;\"> <span style=\"color:#000080;\"><strong>ミラー：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>明<rp>(</rp><rt>あか</rt><rp>)</rp></ruby>るくて、いい <ruby>部屋<rp>(</rp><rt>へや</rt><rp>)</rp></ruby>ですね。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Căn phòng sáng sủa và tốt thật.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby> <ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">ええ。<ruby>天気<rp>(</rp><rt>てんき</rt><rp>)</rp></ruby>が いい <ruby>日<rp>(</rp><rt>ひ</rt><rp>)</rp></ruby>には <ruby>海<rp>(</rp><rt>うみ</rt><rp>)</rp></ruby>が <ruby>見<rp>(</rp><rt>み</rt><rp>)</rp></ruby>えるんです。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vâng. Vào những ngày thời tiết tốt sẽ nhìn thấy biển đấy.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>ミラー：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">この テーブルは おもしろい デザインですね。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Cái bàn này có thiết kế đẹp thật.</div></div></div></td> </tr> <tr> <td> </td> <td> <div class=\"tudich\"><div class=\"candich\">どこで <ruby>買<rp>(</rp><rt>か</rt><rp>)</rp></ruby>ったんですか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Anh đã mua ở đâu vậy?</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby> <ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\"> これは わたしが <ruby>作<rp>(</rp><rt>つく</rt><rp>)</rp></ruby>ったんですよ。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Cái này là tôi đã tự làm đấy.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>ミラー：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">えっ、ほんとうですか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Hả, thật à?</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby> <ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\"> ええ。<ruby>趣味<rp>(</rp><rt>しゅみ</rt><rp>)</rp></ruby>は <ruby>自分<rp>(</rp><rt>じぶん</rt><rp>)</rp></ruby>で <ruby>家具<rp>(</rp><rt>かぐ</rt><rp>)</rp></ruby>を <ruby>作<rp>(</rp><rt>つく</rt><rp>)</rp></ruby>る ことなんです。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vâng. Sở thích của tôi là làm dụng cụ tại nhà.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>ミラー：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">へえ。じゃ、あの <ruby>本棚<rp>(</rp><rt>ほんだな</rt><rp>)</rp></ruby>も <ruby>作<rp>(</rp><rt>つく</rt><rp>)</rp></ruby>ったんですか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Ồ. Vậy cái kệ sách này chắc anh cũng tự làm hả?</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby> <ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">ええ。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Đúng vậy.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>ミラー：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">すごいですね。<ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby><ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>さん、<ruby>何<rp>(</rp><rt>なん</rt><rp>)</rp></ruby>でも <ruby>作<rp>(</rp><rt>つく</rt><rp>)</rp></ruby>れるんですね。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Anh giỏi thật. Anh Suzuki, cái gì cũng có thể làm được ấy nhỉ.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>鈴<rp>(</rp><rt>すず</rt><rp>)</rp></ruby> <ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">わたしの <ruby>夢<rp>(</rp><rt>ゆめ</rt><rp>)</rp></ruby>は いつか <ruby>自分<rp>(</rp><rt>じぶん</rt><rp>)</rp></ruby>で <ruby>家<rp>(</rp><rt>いえ</rt><rp>)</rp></ruby>を <ruby>建<rp>(</rp><rt>た</rt><rp>)</rp></ruby>てる ことなんです。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Giấc mơ của tôi là ngày nào đó sẽ tự mình xây nhà mà.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>ミラー：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">すばらしい <ruby>夢<rp>(</rp><rt>ゆめ</rt><rp>)</rp></ruby>ですね。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Giấc mơ tuyệt thật đấy.</div></div></div></td> </tr> </tbody> </table>"
        }
      ]
