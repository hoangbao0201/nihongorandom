              ]
            },
            {
              "speaker": "皆(みな)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>皆<rp>(</rp><rt>みな</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "乾杯(かんぱい)",
                  "japaneseHtml": "<ruby>乾杯<rp>(</rp><rt>かんぱい</rt><rp>)</rp></ruby>",
                  "vietnamese": "Cạn ly.",
                  "vietnameseHtml": "Cạn ly."
                }
              ]
            },
            {
              "speaker": "司会者(しかいしゃ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>司会者<rp>(</rp><rt>しかいしゃ</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "次(つぎ)に こちらの 皆(みな)さんに ひとことずつ お願(ねが)いします。",
                  "japaneseHtml": "<ruby>次<rp>(</rp><rt>つぎ</rt><rp>)</rp></ruby>に こちらの <ruby>皆<rp>(</rp><rt>みな</rt><rp>)</rp></ruby>さんに ひとことずつ お<ruby>願<rp>(</rp><rt>ねが</rt><rp>)</rp></ruby>いします。",
                  "vietnamese": "Tiếp theo thì xin mọi người ở đây lần lượt nói đôi lời.",
                  "vietnameseHtml": "Tiếp theo thì xin mọi người ở đây lần lượt nói đôi lời."
                }
              ]
            },
            {
              "speaker": "松本良子(まつもとよしこ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>松本良子<rp>(</rp><rt>まつもとよしこ</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "わたしは 去年(きょねん)の 夏(なつ)の クラスで ワット先生(せんせい)に 英語(えいご)を 教(おし)えて いたたきました。",
                  "japaneseHtml": "わたしは <ruby>去年<rp>(</rp><rt>きょねん</rt><rp>)</rp></ruby>の <ruby>夏<rp>(</rp><rt>なつ</rt><rp>)</rp></ruby>の クラスで ワット<ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>に <ruby>英語<rp>(</rp><rt>えいご</rt><rp>)</rp></ruby>を <ruby>教<rp>(</rp><rt>おし</rt><rp>)</rp></ruby>えて いたたきました。",
                  "vietnamese": "Tôi thì vào mùa hè năm ngoái được thầy Watt dạy tiếng Anh tại lớp học.",
                  "vietnameseHtml": "Tôi thì vào mùa hè năm ngoái được thầy Watt dạy tiếng Anh tại lớp học."
                },
                {
                  "kind": "tudich",
                  "japanese": "先生(せんせい)の 授業(じゅぎょう)は ユーモアがあって、楽(たの)しかったです。",
                  "japaneseHtml": "<ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>の <ruby>授業<rp>(</rp><rt>じゅぎょう</rt><rp>)</rp></ruby>は ユーモアがあって、<ruby>楽<rp>(</rp><rt>たの</rt><rp>)</rp></ruby>しかったです。",
                  "vietnamese": "Giờ học của thầy hài hước và vui vẻ.",
                  "vietnameseHtml": "Giờ học của thầy hài hước và vui vẻ."
                },
                {
                  "kind": "tudich",
                  "japanese": "実(じつ)は その クラスに いずみさんも いらっしゃったんです。",
                  "japaneseHtml": "<ruby>実<rp>(</rp><rt>じつ</rt><rp>)</rp></ruby>は その クラスに いずみさんも いらっしゃったんです。",
                  "vietnamese": "Thực ra thì lớp học đó cũng có chị Izumi.",
                  "vietnameseHtml": "Thực ra thì lớp học đó cũng có chị Izumi."
                }
              ]
            },
            {
              "speaker": "大学職員(だいがくしょくいん)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>大学職員<rp>(</rp><rt>だいがくしょくいん</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "わたしは 先生(せんせい)に 「上手(じょうず)な 整理(せいり)の 方法(ほうほう)」と いう 本(ほん)を いただきました。",
                  "japaneseHtml": "わたしは <ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>に 「<ruby>上手<rp>(</rp><rt>じょうず</rt><rp>)</rp></ruby>な <ruby>整理<rp>(</rp><rt>せいり</rt><rp>)</rp></ruby>の <ruby>方法<rp>(</rp><rt>ほうほう</rt><rp>)</rp></ruby>」と いう <ruby>本<rp>(</rp><rt>ほん</rt><rp>)</rp></ruby>を いただきました。",
                  "vietnamese": "Tôi thì nhận được quyển sách “Cách sắp xếp giỏi” từ thầy.",
                  "vietnameseHtml": "Tôi thì nhận được quyển sách “Cách sắp xếp giỏi” từ thầy."
                },
                {
                  "kind": "tudich",
                  "japanese": "先生(せんせい)は 整理(せいり)するのが上手(じょうず)で、研究室(けんきゅうしつ)は いつも きれいです。",
                  "japaneseHtml": "<ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>は <ruby>整理<rp>(</rp><rt>せいり</rt><rp>)</rp></ruby>するのが<ruby>上手<rp>(</rp><rt>じょうず</rt><rp>)</rp></ruby>で、<ruby>研究室<rp>(</rp><rt>けんきゅうしつ</rt><rp>)</rp></ruby>は いつも きれいです。",
                  "vietnamese": "Thầy sắp xếp giỏi, phòng nghiên cứu lúc nào cũng sạch đẹp.",
                  "vietnameseHtml": "Thầy sắp xếp giỏi, phòng nghiên cứu lúc nào cũng sạch đẹp."
                },
                {
                  "kind": "tudich",
                  "japanese": "きっと お二人(ふたり)の お宅(たく)も すてきだと 思(おも)います。",
                  "japaneseHtml": "きっと お<ruby>二人<rp>(</rp><rt>ふたり</rt><rp>)</rp></ruby>の お<ruby>宅<rp>(</rp><rt>たく</rt><rp>)</rp></ruby>も すてきだと <ruby>思<rp>(</rp><rt>おも</rt><rp>)</rp></ruby>います。",
                  "vietnamese": "Tôi nghĩ căn nhà của hai người chắc sẽ tuyệt vời lắm đấy.",
                  "vietnameseHtml": "Tôi nghĩ căn nhà của hai người chắc sẽ tuyệt vời lắm đấy."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong>ミラー：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ワットさん、今度(こんど)は 「すてきな 人(ひと)と 結婚(けっこん)する 方法(ほうほう)」 という 本(ほん)を 書(か)いて くださいませんか。",
                  "japaneseHtml": "ワットさん、<ruby>今度<rp>(</rp><rt>こんど</rt><rp>)</rp></ruby>は 「すてきな <ruby>人<rp>(</rp><rt>ひと</rt><rp>)</rp></ruby>と <ruby>結婚<rp>(</rp><rt>けっこん</rt><rp>)</rp></ruby>する <ruby>方法<rp>(</rp><rt>ほうほう</rt><rp>)</rp></ruby>」 という <ruby>本<rp>(</rp><rt>ほん</rt><rp>)</rp></ruby>を <ruby>書<rp>(</rp><rt>か</rt><rp>)</rp></ruby>いて くださいませんか。",
                  "vietnamese": "Thầy Watt, sắp tới thầy viết cho tôi sách “Phương pháp kết hôn với người tuyệt vời” được không?",
                  "vietnameseHtml": "Thầy Watt, sắp tới thầy viết cho tôi sách “Phương pháp kết hôn với người tuyệt vời” được không?"
                },
                {
                  "kind": "tudich",
                  "japanese": "ぜひ よんで、勉強(べんきょう)したいです。どうぞ お幸(しあわ)せに。",
                  "japaneseHtml": "ぜひ よんで、<ruby>勉強<rp>(</rp><rt>べんきょう</rt><rp>)</rp></ruby>したいです。どうぞ お<ruby>幸<rp>(</rp><rt>しあわ</rt><rp>)</rp></ruby>せに。",
                  "vietnamese": "Nhất định tôi muốn đọc và học tập. Chúc hạnh phúc.",
                  "vietnameseHtml": "Nhất định tôi muốn đọc và học tập. Chúc hạnh phúc."
                }
              ]
            }
          ],
          "contentHtml": "<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"khung\" style=\" width: 100%;\"> <tbody> <tr> <td style=\"width: 120px;\"> <span style=\"color:#000080;\"><strong><ruby>学長<rp>(</rp><rt>がくちょう</rt><rp>)</rp></ruby>：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">ワットさん、いずみさん、ご<ruby>結婚<rp>(</rp><rt>けっこん</rt><rp>)</rp></ruby> おめでとうございます。<ruby>乾杯<rp>(</rp><rt>かんぱい</rt><rp>)</rp></ruby>。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Chúc mừng ông Watt, chị Izumi kết hôn. Cạn ly.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>皆<rp>(</rp><rt>みな</rt><rp>)</rp></ruby>：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>乾杯<rp>(</rp><rt>かんぱい</rt><rp>)</rp></ruby></div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Cạn ly.</div></div></div></td> </tr> <tr> <td> </td> <td> —————–</td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>司会者<rp>(</rp><rt>しかいしゃ</rt><rp>)</rp></ruby>：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>次<rp>(</rp><rt>つぎ</rt><rp>)</rp></ruby>に こちらの <ruby>皆<rp>(</rp><rt>みな</rt><rp>)</rp></ruby>さんに ひとことずつ お<ruby>願<rp>(</rp><rt>ねが</rt><rp>)</rp></ruby>いします。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Tiếp theo thì xin mọi người ở đây lần lượt nói đôi lời.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>松本良子<rp>(</rp><rt>まつもとよしこ</rt><rp>)</rp></ruby>： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">わたしは <ruby>去年<rp>(</rp><rt>きょねん</rt><rp>)</rp></ruby>の <ruby>夏<rp>(</rp><rt>なつ</rt><rp>)</rp></ruby>の クラスで ワット<ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>に <ruby>英語<rp>(</rp><rt>えいご</rt><rp>)</rp></ruby>を <ruby>教<rp>(</rp><rt>おし</rt><rp>)</rp></ruby>えて いたたきました。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Tôi thì vào mùa hè năm ngoái được thầy Watt dạy tiếng Anh tại lớp học.</div></div></div> <div class=\"tudich\"><div class=\"candich\"><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>の <ruby>授業<rp>(</rp><rt>じゅぎょう</rt><rp>)</rp></ruby>は ユーモアがあって、<ruby>楽<rp>(</rp><rt>たの</rt><rp>)</rp></ruby>しかったです。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Giờ học của thầy hài hước và vui vẻ.</div></div></div> <div class=\"tudich\"><div class=\"candich\"><ruby>実<rp>(</rp><rt>じつ</rt><rp>)</rp></ruby>は その クラスに いずみさんも いらっしゃったんです。 </div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Thực ra thì lớp học đó cũng có chị Izumi.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><ruby>大学職員<rp>(</rp><rt>だいがくしょくいん</rt><rp>)</rp></ruby>： </strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">わたしは <ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>に 「<ruby>上手<rp>(</rp><rt>じょうず</rt><rp>)</rp></ruby>な <ruby>整理<rp>(</rp><rt>せいり</rt><rp>)</rp></ruby>の <ruby>方法<rp>(</rp><rt>ほうほう</rt><rp>)</rp></ruby>」と いう <ruby>本<rp>(</rp><rt>ほん</rt><rp>)</rp></ruby>を いただきました。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Tôi thì nhận được quyển sách “Cách sắp xếp giỏi” từ thầy.</div></div></div> <div class=\"tudich\"><div class=\"candich\"><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>は <ruby>整理<rp>(</rp><rt>せいり</rt><rp>)</rp></ruby>するのが<ruby>上手<rp>(</rp><rt>じょうず</rt><rp>)</rp></ruby>で、<ruby>研究室<rp>(</rp><rt>けんきゅうしつ</rt><rp>)</rp></ruby>は いつも きれいです。 </div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Thầy sắp xếp giỏi, phòng nghiên cứu lúc nào cũng sạch đẹp.</div></div></div> <div class=\"tudich\"><div class=\"candich\">きっと お<ruby>二人<rp>(</rp><rt>ふたり</rt><rp>)</rp></ruby>の お<ruby>宅<rp>(</rp><rt>たく</rt><rp>)</rp></ruby>も すてきだと <ruby>思<rp>(</rp><rt>おも</rt><rp>)</rp></ruby>います。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Tôi nghĩ căn nhà của hai người chắc sẽ tuyệt vời lắm đấy.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong>ミラー：</strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\"> ワットさん、<ruby>今度<rp>(</rp><rt>こんど</rt><rp>)</rp></ruby>は 「すてきな <ruby>人<rp>(</rp><rt>ひと</rt><rp>)</rp></ruby>と <ruby>結婚<rp>(</rp><rt>けっこん</rt><rp>)</rp></ruby>する <ruby>方法<rp>(</rp><rt>ほうほう</rt><rp>)</rp></ruby>」 という <ruby>本<rp>(</rp><rt>ほん</rt><rp>)</rp></ruby>を <ruby>書<rp>(</rp><rt>か</rt><rp>)</rp></ruby>いて くださいませんか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Thầy Watt, sắp tới thầy viết cho tôi sách “Phương pháp kết hôn với người tuyệt vời” được không?</div></div></div> <div class=\"tudich\"><div class=\"candich\">ぜひ よんで、<ruby>勉強<rp>(</rp><rt>べんきょう</rt><rp>)</rp></ruby>したいです。どうぞ お<ruby>幸<rp>(</rp><rt>しあわ</rt><rp>)</rp></ruby>せに。 </div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Nhất định tôi muốn đọc và học tập. Chúc hạnh phúc.</div></div></div><p></p> </td> </tr> </tbody> </table>"
        }
      ]
