              "speaker": "学長(がくちょう)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><ruby>学長<rp>(</rp><rt>がくちょう</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ワットさん、いずみさん、ご結婚(けっこん) おめでとうございます。乾杯(かんぱい)。",
                  "japaneseHtml": "ワットさん、いずみさん、ご<ruby>結婚<rp>(</rp><rt>けっこん</rt><rp>)</rp></ruby> おめでとうございます。<ruby>乾杯<rp>(</rp><rt>かんぱい</rt><rp>)</rp></ruby>。",
                  "vietnamese": "Chúc mừng ông Watt, chị Izumi kết hôn. Cạn ly.",
                  "vietnameseHtml": "Chúc mừng ông Watt, chị Izumi kết hôn. Cạn ly."
