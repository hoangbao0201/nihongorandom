            {
              "speaker": "図書館(としょかん)の人(ひと)：",
              "speakerHtml": "<span><span style=\"color: rgb(0, 0, 128);\"><u><strong><ruby>図書館<rp>(</rp><rt>としょかん</rt><rp>)</rp></ruby>の<ruby>人<rp>(</rp><rt>ひと</rt><rp>)</rp></ruby>：</strong></u></span></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "はい、みどり図書館(としょかん)です。",
                  "japaneseHtml": "はい、みどり<ruby>図書館<rp>(</rp><rt>としょかん</rt><rp>)</rp></ruby>です。",
                  "vietnamese": "Vâng, thư viện Midori xin nghe.",
                  "vietnameseHtml": "Vâng, thư viện Midori xin nghe."
                }
              ]
            },
            {
              "speaker": "カリナ：",
              "speakerHtml": "<span><span style=\"color: rgb(0, 0, 128);\"><u><strong>カリナ：</strong></u></span></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "あのう、そちらまで どうやって 行(い)きますか。",
                  "japaneseHtml": "あのう、そちらまで どうやって <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>きますか。",
                  "vietnamese": "Cho hỏi đi như thế nào đến đó vậy?",
                  "vietnameseHtml": "Cho hỏi đi như thế nào đến đó vậy?"
                }
              ]
            },
            {
              "speaker": "図書館(としょかん)の人(ひと)：",
              "speakerHtml": "<span><span style=\"color: rgb(0, 0, 128);\"><u><strong><ruby>図書館<rp>(</rp><rt>としょかん</rt><rp>)</rp></ruby>の<ruby>人<rp>(</rp><rt>ひと</rt><rp>)</rp></ruby>：</strong></u></span></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "本田(ほんでん)駅(えき)から 12番(ばん)の バスに 乗(の)って、図書館(としょかん)前(まえ)で 降(お)りて ください。3つ目(め)です。",
                  "japaneseHtml": "<ruby>本田<rp>(</rp><rt>ほんでん</rt><rp>)</rp></ruby><ruby>駅<rp>(</rp><rt>えき</rt><rp>)</rp></ruby>から 12<ruby>番<rp>(</rp><rt>ばん</rt><rp>)</rp></ruby>の バスに <ruby>乗<rp>(</rp><rt>の</rt><rp>)</rp></ruby>って、<ruby>図書館<rp>(</rp><rt>としょかん</rt><rp>)</rp></ruby><ruby>前<rp>(</rp><rt>まえ</rt><rp>)</rp></ruby>で <ruby>降<rp>(</rp><rt>お</rt><rp>)</rp></ruby>りて ください。3つ<ruby>目<rp>(</rp><rt>め</rt><rp>)</rp></ruby>です。",
                  "vietnamese": "Từ nhà ga Honda, hãy lên xe buýt số 12 và đi đến trước thư việc. Là điểm đỗ thứ 3 đấy.",
                  "vietnameseHtml": "Từ nhà ga Honda, hãy lên xe buýt số 12 và đi đến trước thư việc. Là điểm đỗ thứ 3 đấy."
                }
              ]
            },
            {
              "speaker": "カリナ：",
              "speakerHtml": "<span><span style=\"color: rgb(0, 0, 128);\"><u><strong>カリナ：</strong></u></span></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "3つ目(め)ですね。",
                  "japaneseHtml": "3つ<ruby>目<rp>(</rp><rt>め</rt><rp>)</rp></ruby>ですね。",
                  "vietnamese": "Điểm thứ 3 đúng không ạ.",
                  "vietnameseHtml": "Điểm thứ 3 đúng không ạ."
                }
              ]
            },
            {
              "speaker": "図書館(としょかん)の人(ひと)：",
              "speakerHtml": "<span><span style=\"color: rgb(0, 0, 128);\"><u><strong><ruby>図書館<rp>(</rp><rt>としょかん</rt><rp>)</rp></ruby>の<ruby>人<rp>(</rp><rt>ひと</rt><rp>)</rp></ruby>：</strong></u></span></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ。降(お)りると、前(まえ)に 公園(こうえん)が あります。",
                  "japaneseHtml": "ええ。<ruby>降<rp>(</rp><rt>お</rt><rp>)</rp></ruby>りると、<ruby>前<rp>(</rp><rt>まえ</rt><rp>)</rp></ruby>に <ruby>公園<rp>(</rp><rt>こうえん</rt><rp>)</rp></ruby>が あります。",
                  "vietnamese": "Đúng vậy. Khi xuống xe, phía trước sẽ có công viên.",
                  "vietnameseHtml": "Đúng vậy. Khi xuống xe, phía trước sẽ có công viên."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "図書館(としょかん)は 公園(こうえん)の 中(なか)の 白(しろ)い 建物(たてもの)です。",
                  "japaneseHtml": "<ruby>図書館<rp>(</rp><rt>としょかん</rt><rp>)</rp></ruby>は <ruby>公園<rp>(</rp><rt>こうえん</rt><rp>)</rp></ruby>の <ruby>中<rp>(</rp><rt>なか</rt><rp>)</rp></ruby>の <ruby>白<rp>(</rp><rt>しろ</rt><rp>)</rp></ruby>い <ruby>建物<rp>(</rp><rt>たてもの</rt><rp>)</rp></ruby>です。",
                  "vietnamese": "Thư viện là tòa nhà màu trắng nằm bên trong công viên.",
                  "vietnameseHtml": "Thư viện là tòa nhà màu trắng nằm bên trong công viên."
                }
              ]
            },
            {
              "speaker": "カリナ：",
              "speakerHtml": "<span><span style=\"color: rgb(0, 0, 128);\"><u><strong>カリナ： </strong></u></span></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "わかりました。",
                  "japaneseHtml": "わかりました。",
                  "vietnamese": "Tôi hiểu rồi.",
                  "vietnameseHtml": "Tôi hiểu rồi."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "それから 本(ほん)を 借(か)りる とき、何(なに)か 要(い)ります。",
                  "japaneseHtml": "それから <ruby>本<rp>(</rp><rt>ほん</rt><rp>)</rp></ruby>を <ruby>借<rp>(</rp><rt>か</rt><rp>)</rp></ruby>りる とき、<ruby>何<rp>(</rp><rt>なに</rt><rp>)</rp></ruby>か <ruby>要<rp>(</rp><rt>い</rt><rp>)</rp></ruby>ります。",
                  "vietnamese": "Và thêm nữa là khi mượn sách thì có cần gì không ạ?",
                  "vietnameseHtml": "Và thêm nữa là khi mượn sách thì có cần gì không ạ?"
                }
              ]
            },
            {
              "speaker": "図書館(としょかん)の人(ひと)：",
              "speakerHtml": "<span><span style=\"color: rgb(0, 0, 128);\"><u><strong><ruby>図書館<rp>(</rp><rt>としょかん</rt><rp>)</rp></ruby>の<ruby>人<rp>(</rp><rt>ひと</rt><rp>)</rp></ruby>：</strong></u></span></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "お名前(なまえ)と 住所(じゅうしょ) が わかる 物(もの)を 持(も)って 来(き)て ください。",
                  "japaneseHtml": "お<ruby>名前<rp>(</rp><rt>なまえ</rt><rp>)</rp></ruby>と <ruby>住所<rp>(</rp><rt>じゅうしょ</rt><rp>)</rp> </ruby>が わかる <ruby>物<rp>(</rp><rt>もの</rt><rp>)</rp></ruby>を <ruby>持<rp>(</rp><rt>も</rt><rp>)</rp></ruby>って <ruby>来<rp>(</rp><rt>き</rt><rp>)</rp></ruby>て ください。",
                  "vietnamese": "Chị hãy cầm theo thứ có thể biết được tên và địa chỉ..",
                  "vietnameseHtml": "Chị hãy cầm theo thứ có thể biết được tên và địa chỉ.."
                }
              ]
            },
            {
              "speaker": "カリナ：",
              "speakerHtml": "<span><span style=\"color: rgb(0, 0, 128);\"><u><strong>カリナ： </strong></u></span></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "はい。どうも ありがとう ございました。",
                  "japaneseHtml": "はい。どうも ありがとう ございました。",
                  "vietnamese": "Vâng. Xin cảm ơn chị nhiều.",
                  "vietnameseHtml": "Vâng. Xin cảm ơn chị nhiều."
                }
              ]
            }
