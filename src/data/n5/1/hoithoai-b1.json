              "speaker": "佐藤(さとう)：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><strong><span><ruby>佐藤<rp>(</rp><rt>さとう</rt><rp>)</rp></ruby>：</span></strong></u></span>",
