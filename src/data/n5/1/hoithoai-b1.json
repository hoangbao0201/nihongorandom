                }
              ]
            },
            {
              "speaker": "山田(やまだ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><strong><span><ruby>山田<rp>(</rp><rt>やまだ</rt><rp>)</rp></ruby>：</span></strong></u></span>",
              "lines": [
                {
