                  "japanese": "おはよう ございます。",
                  "japaneseHtml": "<span>おはよう ございます。</span>",
                  "vietnamese": "Chào chị!",
                  "vietnameseHtml": "<span style=\"font-family: arial,helvetica,sans-serif;\"><span style=\"font-size: 16px;\">Chào chị!</span></span>"
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "佐藤(さとう)さん、こちらは マイク・ミラーさんです。",
                  "japaneseHtml": "<span><ruby>佐藤<rp>(</rp><rt>さとう</rt><rp>)</rp></ruby>さん、こちらは マイク・ミラーさんです。</span>",
                  "vietnamese": "Chị Sato, đây là anh Mike Miller.",
                  "vietnameseHtml": "<span style=\"font-family: arial,helvetica,sans-serif;\"><span style=\"font-size: 16px;\">Chị Sato, đây là anh Mike Miller.</span></span>"
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><strong><span>ミラー：</span></strong></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "初(はじ)めまして。",
                  "japaneseHtml": "<span><ruby>初<rp>(</rp><rt>はじ</rt><rp>)</rp></ruby>めまして。</span>",
                  "vietnamese": "Rất vui được làm quen với chị.",
                  "vietnameseHtml": "<span style=\"font-family: arial,helvetica,sans-serif;\"><span style=\"font-size: 16px;\">Rất vui được làm quen với chị.</span></span>"
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "マイク・ミラーです。",
                  "japaneseHtml": "<span>マイク・ミラーです。</span>",
                  "vietnamese": "Tôi là Mike Miller.",
                  "vietnameseHtml": "<span style=\"font-family: arial,helvetica,sans-serif;\"><span style=\"font-size: 16px;\">Tôi là Mike Miller.</span></span>"
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "アメリカから 来(き)ました。",
                  "japaneseHtml": "<span>アメリカから <ruby>来<rp>(</rp><rt>き</rt><rp>)</rp></ruby>ました。</span>",
                  "vietnamese": "Tôi đến từ Mỹ.",
                  "vietnameseHtml": "<span style=\"font-family: arial,helvetica,sans-serif;\"><span style=\"font-size: 16px;\">Tôi đến từ Mỹ.</span></span>"
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "どうぞ よろしく。",
                  "japaneseHtml": "<span>どうぞ よろしく。</span>",
                  "vietnamese": "Rất mong sẽ nhận được sự giúp đỡ của chị.",
                  "vietnameseHtml": "<span style=\"font-family: arial,helvetica,sans-serif;\"><span style=\"font-size: 16px;\">Rất mong sẽ nhận được sự giúp đỡ của chị.</span></span>"
                }
