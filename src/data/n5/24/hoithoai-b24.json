          "kind": "dialogue",
          "rows": [
            {
              "speaker": "カリナ：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\">カリナ：</span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ワンさん、日曜日(にちようび) 引(ひ)っ越(こ)しですね。",
                  "japaneseHtml": "ワンさん、<ruby>日曜日<rp>(</rp><rt>にちようび</rt><rp>)</rp></ruby> <ruby>引<rp>(</rp><rt>ひ</rt><rp>)</rp></ruby>っ<ruby>越<rp>(</rp><rt>こ</rt><rp>)</rp></ruby>しですね。",
                  "vietnamese": "Anh Wang này, ngày mai anh chuyển nhà nhỉ.",
                  "vietnameseHtml": "Anh Wang này, ngày mai anh chuyển nhà nhỉ."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "手伝(てつだ)いに 行(い)きましょうか。",
                  "japaneseHtml": "<ruby>手伝<rp>(</rp><rt>てつだ</rt><rp>)</rp></ruby>いに <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>きましょうか。",
                  "vietnamese": "Tôi đến giúp nhé?",
                  "vietnameseHtml": "Tôi đến giúp nhé?"
                }
              ]
            },
            {
              "speaker": "ワン：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\">ワン：</span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ありがとう ございます。",
                  "japaneseHtml": "ありがとう ございます。",
                  "vietnamese": "Cảm ơn chị.",
                  "vietnameseHtml": "Cảm ơn chị."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "じゃ、すみませんが、９時(とき)ごろ お願(ねが)いします。",
                  "japaneseHtml": "じゃ、すみませんが、９<ruby>時<rp>(</rp><rt>とき</rt><rp>)</rp></ruby>ごろ お<ruby>願<rp>(</rp><rt>ねが</rt><rp>)</rp></ruby>いします。",
                  "vietnamese": "Vậy th&igrave;, xin lỗi, nhờ chị mai 9 giờ nhé.",
                  "vietnameseHtml": "Vậy th&igrave;, xin lỗi, nhờ chị mai 9 giờ nhé."
                }
              ]
            },
            {
              "speaker": "カリナ：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\">カリナ：</span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ほかに だれが 手伝(てつだ)いに 行(い)きますか。",
                  "japaneseHtml": "ほかに だれが <ruby>手伝<rp>(</rp><rt>てつだ</rt><rp>)</rp></ruby>いに <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>きますか。",
                  "vietnamese": "Ngoài ra c&ograve;n ai tới giúp không?",
                  "vietnameseHtml": "Ngoài ra c&ograve;n ai tới giúp không?"
                }
              ]
            },
            {
              "speaker": "ワン：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\">ワン： </span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "山田(やまだ)さんと ミラーさんが 来(き)て くれます。",
                  "japaneseHtml": "<ruby>山田<rp>(</rp><rt>やまだ</rt><rp>)</rp></ruby>さんと ミラーさんが <ruby>来<rp>(</rp><rt>き</rt><rp>)</rp></ruby>て くれます。",
                  "vietnamese": "Anh Yamada và anh Miller sẽ đến.",
                  "vietnameseHtml": "Anh Yamada và anh Miller sẽ đến."
                }
              ]
            },
            {
              "speaker": "カリナ：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\">カリナ：</span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "車(くるま)は？",
                  "japaneseHtml": "<ruby>車<rp>(</rp><rt>くるま</rt><rp>)</rp></ruby>は？",
                  "vietnamese": "C&ograve;n xe hơi th&igrave; sao?",
                  "vietnameseHtml": "C&ograve;n xe hơi th&igrave; sao?"
                }
              ]
            },
            {
              "speaker": "ワン：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\">ワン： </span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "山田(やまだ)さんに 貸(か)して もらいます。",
                  "japaneseHtml": "<ruby>山田<rp>(</rp><rt>やまだ</rt><rp>)</rp></ruby>さんに <ruby>貸<rp>(</rp><rt>か</rt><rp>)</rp></ruby>して もらいます。",
                  "vietnamese": "Anh Yamada sẽ cho tôi mượn.",
                  "vietnameseHtml": "Anh Yamada sẽ cho tôi mượn."
                }
              ]
            },
            {
              "speaker": "カリナ：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\">カリナ：</span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "昼(ひる)ごはんは どう しますか。",
                  "japaneseHtml": "<ruby>昼<rp>(</rp><rt>ひる</rt><rp>)</rp></ruby>ごはんは どう しますか。",
                  "vietnamese": "C&ograve;n bữa trưa th&igrave; sao?",
                  "vietnameseHtml": "C&ograve;n bữa trưa th&igrave; sao?"
                }
              ]
            },
            {
              "speaker": "ワン：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\">ワン： </span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "えーと･････。",
                  "japaneseHtml": "えーと･････。",
                  "vietnamese": "Ừm&hellip;",
                  "vietnameseHtml": "Ừm&hellip;"
                }
              ]
            },
            {
              "speaker": "カリナ：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\">カリナ：</span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "わたしが お弁当(べんとう)を 持(も)って 行(い)きましょうか。",
                  "japaneseHtml": "わたしが お<ruby>弁当<rp>(</rp><rt>べんとう</rt><rp>)</rp></ruby>を <ruby>持<rp>(</rp><rt>も</rt><rp>)</rp></ruby>って <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>きましょうか。",
                  "vietnamese": "Vậy tôi sẽ mang cơm hộp đến nhé?",
                  "vietnameseHtml": "Vậy tôi sẽ mang cơm hộp đến nhé?"
                }
              ]
            },
            {
              "speaker": "ワン：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\">ワン： </span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "すみません。お願(ねが)いします。",
                  "japaneseHtml": "すみません。お<ruby>願<rp>(</rp><rt>ねが</rt><rp>)</rp></ruby>いします。",
                  "vietnamese": "Xin lỗi, Xin nhờ chị vậy.",
                  "vietnameseHtml": "Xin lỗi, Xin nhờ chị vậy."
                }
              ]
            },
            {
              "speaker": "カリナ：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\">カリナ： </span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "じゃ、日曜日(にちようび)に。",
                  "japaneseHtml": "じゃ、<ruby>日曜日<rp>(</rp><rt>にちようび</rt><rp>)</rp></ruby>に。",
                  "vietnamese": "Vậy, hẹn chủ nhật.",
                  "vietnameseHtml": "Vậy, hẹn chủ nhật."
                }
              ]
            }
          ],
