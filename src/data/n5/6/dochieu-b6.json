          "contentHtml": "<div class=\"kqdich\"><div class=\"nddich\">Chị Anne đã đọc ‘Cùng đi ngắm hoa nhé’. </div></div></div> <p></p>"
        },
        {
          "kind": "tudich",
          "japanese": "メルさんに 会（あ）いました。",
          "japaneseHtml": "メルさんに <ruby>会<rp>（</rp><rt>あ</rt><rp>）</rp></ruby>いました。",
