              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "わたしは 天(てん)ぷら定食(ていしょく)。",
                  "japaneseHtml": "<span>わたしは <ruby>天<rp>(</rp><rt>てん</rt><rp>)</rp></ruby>ぷら<ruby>定食<rp>(</rp><rt>ていしょく</rt><rp>)</rp></ruby>。</span>",
                  "vietnamese": "Tôi thì cơm suất Tempura.",
                  "vietnameseHtml": "Tôi thì cơm suất Tempura."
