              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong>ミラー：</strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "すみません。別(べつ)々に お願(ねが)いします。",
                  "japaneseHtml": "<span>すみません。<ruby>別<rp>(</rp><rt>べつ</rt><rp>)</rp></ruby>々に お<ruby>願<rp>(</rp><rt>ねが</rt><rp>)</rp></ruby>いします。</span>",
                  "vietnamese": "Xin lỗi, nhờ chị tính riêng giùm.",
