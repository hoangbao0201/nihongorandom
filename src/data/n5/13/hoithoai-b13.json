            {
              "speaker": "店(みせ)の 人(ひと)：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong><ruby>店<rp>(</rp><rt>みせ</rt><rp>)</rp></ruby>の <ruby>人<rp>(</rp><rt>ひと</rt><rp>)</rp></ruby>：</strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "1,680円(えん)で ございます。",
                  "japaneseHtml": "<span>1,680<ruby>円<rp>(</rp><rt>えん</rt><rp>)</rp></ruby>で ございます。</span>",
