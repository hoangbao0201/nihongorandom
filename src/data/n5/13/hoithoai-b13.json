              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong><ruby>店<rp>(</rp><rt>みせ</rt><rp>)</rp></ruby>の <ruby>人<rp>(</rp><rt>ひと</rt><rp>)</rp></ruby>：</strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "天(てん)ぷら定食(ていしょく)と 牛(ぎゅう)どんですね。少(すくな)々 お待(ま)ち ください。",
                  "japaneseHtml": "<span><ruby>天<rp>(</rp><rt>てん</rt><rp>)</rp></ruby>ぷら<ruby>定食<rp>(</rp><rt>ていしょく</rt><rp>)</rp></ruby>と <ruby>牛<rp>(</rp><rt>ぎゅう</rt><rp>)</rp></ruby>どんですね。<ruby>少<rp>(</rp><rt>すくな</rt><rp>)</rp></ruby>々 お<ruby>待<rp>(</rp><rt>ま</rt><rp>)</rp></ruby>ち ください。</span>",
