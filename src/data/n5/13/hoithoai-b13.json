            {
              "speaker": "山田(やまだ)：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong><ruby>山田<rp>(</rp><rt>やまだ</rt><rp>)</rp></ruby>：</strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "もう 12時(じ)ですよ。昼(ひる)ごはんを 食(た)べに 行(い)きませんか。",
                  "japaneseHtml": "<span>もう 12<ruby>時<rp>(</rp><rt>じ</rt><rp>)</rp></ruby>ですよ。<ruby>昼<rp>(</rp><rt>ひる</rt><rp>)</rp></ruby>ごはんを <ruby>食<rp>(</rp><rt>た</rt><rp>)</rp></ruby>べに <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>きませんか。</span>",
                  "vietnamese": "Đã 12 giờ rồi đấy. Đi ăn trưa không?",
                  "vietnameseHtml": "Đã 12 giờ rồi đấy. Đi ăn trưa không?"
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong>ミラー：</strong> </span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ。",
                  "japaneseHtml": "<span>ええ。 </span>",
                  "vietnamese": "Ừ.",
                  "vietnameseHtml": "Ừ."
                }
              ]
            },
            {
              "speaker": "山田(やまだ)：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong><ruby>山田<rp>(</rp><rt>やまだ</rt><rp>)</rp></ruby>：</strong> </span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "どこへ 行(い)きますか。",
                  "japaneseHtml": "<span>どこへ <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>きますか。 </span>",
                  "vietnamese": "Đi đâu đây?",
                  "vietnameseHtml": "Đi đâu đây?"
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong>ミラー：</strong> </span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そうですね。きょうは 日本(にほん)料理(りょうり)が 食(た)べたいですね。",
                  "japaneseHtml": "<span>そうですね。きょうは <ruby>日本<rp>(</rp><rt>にほん</rt><rp>)</rp></ruby><ruby>料理<rp>(</rp><rt>りょうり</rt><rp>)</rp></ruby>が <ruby>食<rp>(</rp><rt>た</rt><rp>)</rp></ruby>べたいですね。</span>",
                  "vietnamese": "Ử nhỉ. Hôm nay tôi muốn ăn món Nhật.",
                  "vietnameseHtml": "Ử nhỉ. Hôm nay tôi muốn ăn món Nhật."
                }
              ]
            },
            {
              "speaker": "山田(やまだ)：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong><ruby>山田<rp>(</rp><rt>やまだ</rt><rp>)</rp></ruby>：</strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "じゃ、「つるや」へ 行(い)きましょう。",
                  "japaneseHtml": "<span> じゃ、「つるや」へ <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>きましょう。</span>",
                  "vietnamese": "Vậy thì hãy đến “Tsuruya” thôi.",
                  "vietnameseHtml": "Vậy thì hãy đến “Tsuruya” thôi."
                }
              ]
            },
            {
              "speaker": "店(みせ)の 人(ひと)：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong><ruby>店<rp>(</rp><rt>みせ</rt><rp>)</rp></ruby>の <ruby>人<rp>(</rp><rt>ひと</rt><rp>)</rp></ruby>：</strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ご注文(ちゅうもん)は？",
                  "japaneseHtml": "<span>ご<ruby>注文<rp>(</rp><rt>ちゅうもん</rt><rp>)</rp></ruby>は？ </span>",
                  "vietnamese": "Các anh dùng gì?",
                  "vietnameseHtml": "Các anh dùng gì?"
