              "speaker": "山田(やまだ)：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong><ruby>山田<rp>(</rp><rt>やまだ</rt><rp>)</rp></ruby>：</strong> </span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "わたしは 牛(ぎゅう)どん。",
                  "japaneseHtml": "<span>わたしは <ruby>牛<rp>(</rp><rt>ぎゅう</rt><rp>)</rp></ruby>どん。 </span>",
