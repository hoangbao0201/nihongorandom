            {
              "speaker": "木(き) 村(むら)：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong><ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby> <ruby>村<rp>(</rp><rt>むら</rt><rp>)</rp></ruby>：</strong> </span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "いい 映画(えいが)でしたね。",
                  "japaneseHtml": "<span>いい <ruby>映画<rp>(</rp><rt>えいが</rt><rp>)</rp></ruby>でしたね。</span>",
                  "vietnamese": "Bộ phim hay nhỉ.",
                  "vietnameseHtml": "Bộ phim hay nhỉ."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong>ミラー：</strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ。わたしは 家族(かぞく)を 思(おも)い出(だ)しました。",
                  "japaneseHtml": "<span>ええ。わたしは <ruby>家族<rp>(</rp><rt>かぞく</rt><rp>)</rp></ruby>を <ruby>思<rp>(</rp><rt>おも</rt><rp>)</rp></ruby>い<ruby>出<rp>(</rp><rt>だ</rt><rp>)</rp></ruby>しました。</span>",
                  "vietnamese": "Vâng. Tôi lại nhớ đến gia đình mình.",
                  "vietnameseHtml": "Vâng. Tôi lại nhớ đến gia đình mình."
                }
              ]
            },
            {
              "speaker": "木(き) 村(むら)：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong><ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby> <ruby>村<rp>(</rp><rt>むら</rt><rp>)</rp></ruby>：</strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そうですか。ミラーさんの ご家族(かぞく)は？",
                  "japaneseHtml": "<span>そうですか。ミラーさんの ご<ruby>家族<rp>(</rp><rt>かぞく</rt><rp>)</rp></ruby>は？</span>",
