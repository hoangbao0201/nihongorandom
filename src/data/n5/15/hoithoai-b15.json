            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "木村(きむら)さんの ご家族(かぞく)は？",
                  "japaneseHtml": "<span><ruby>木村<rp>(</rp><rt>きむら</rt><rp>)</rp></ruby>さんの ご<ruby>家族<rp>(</rp><rt>かぞく</rt><rp>)</rp></ruby>は？ </span>",
