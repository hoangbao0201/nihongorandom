              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong>ミラー：</strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "両親(りょうしん)と 姉(あね)が 1人(ひとり) います。",
                  "japaneseHtml": "<span><ruby>両親<rp>(</rp><rt>りょうしん</rt><rp>)</rp></ruby>と <ruby>姉<rp>(</rp><rt>あね</rt><rp>)</rp></ruby>が <ruby>1人<rp>(</rp><rt>ひとり</rt><rp>)</rp></ruby> います。</span>",
                  "vietnamese": "Tôi có bố mẹ và 1 người chị.",
                  "vietnameseHtml": "Tôi có bố mẹ và 1 người chị."
                }
              ]
            },
            {
              "speaker": "木(き) 村(むら)：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong><ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby> <ruby>村<rp>(</rp><rt>むら</rt><rp>)</rp></ruby>：</strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "どちらに いらっしゃいますか 。",
                  "japaneseHtml": "<span>どちらに いらっしゃいますか 。</span>",
