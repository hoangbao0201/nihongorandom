        {
          "kind": "dialogue",
          "rows": [
            {
              "speaker": "小林(こばやし)：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\"><ruby>小林<rp>(</rp><rt>こばやし</rt><rp>)</rp></ruby>：</span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "夏休(なつやす)みは 国(くに)へ 帰(かえ)る？",
                  "japaneseHtml": "<ruby>夏休<rp>(</rp><rt>なつやす</rt><rp>)</rp></ruby>みは <ruby>国<rp>(</rp><rt>くに</rt><rp>)</rp></ruby>へ <ruby>帰<rp>(</rp><rt>かえ</rt><rp>)</rp></ruby>る？",
                  "vietnamese": "Kỳ nghỉ hè cậu sẽ về nước à?",
                  "vietnameseHtml": "Kỳ nghỉ hè cậu sẽ về nước à?"
                }
              ]
            },
            {
              "speaker": "タワポン：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\">タワポン：</span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ううん。帰(かえ)りたいけど、･････。",
                  "japaneseHtml": "ううん。<ruby>帰<rp>(</rp><rt>かえ</rt><rp>)</rp></ruby>りたいけど、･････。",
                  "vietnamese": "Không. Mình muốn về nhưng mà…",
                  "vietnameseHtml": "Không. Mình muốn về nhưng mà…"
                }
              ]
            },
            {
              "speaker": "小林(こばやし)：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\"><ruby>小林<rp>(</rp><rt>こばやし</rt><rp>)</rp></ruby>：</span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そう。",
                  "japaneseHtml": "そう。",
                  "vietnamese": "Thế à.",
                  "vietnameseHtml": "Thế à."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "タワポン君(くん)、富士山(ふじさん)に 登(のぼ)った こと ある？",
                  "japaneseHtml": "タワポン<ruby>君<rp>(</rp><rt>くん</rt><rp>)</rp></ruby>、<ruby>富士山<rp>(</rp><rt>ふじさん</rt><rp>)</rp></ruby>に <ruby>登<rp>(</rp><rt>のぼ</rt><rp>)</rp></ruby>った こと ある？",
                  "vietnamese": "Mà Thawapong này, cậu đã từng leo núi Phú Sĩ chưa?",
                  "vietnameseHtml": "Mà Thawapong này, cậu đã từng leo núi Phú Sĩ chưa?"
                }
              ]
            },
            {
              "speaker": "タワポン：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\">タワポン：</span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ううん、ない。",
                  "japaneseHtml": "ううん、ない。",
                  "vietnamese": "Chưa.",
                  "vietnameseHtml": "Chưa."
                }
              ]
            },
            {
              "speaker": "小林(こばやし)：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\"><ruby>小林<rp>(</rp><rt>こばやし</rt><rp>)</rp></ruby>：</span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "じゃ、よかったら、いっしょに 行(い)かない？",
                  "japaneseHtml": "じゃ、よかったら、いっしょに <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>かない？",
                  "vietnamese": "Vậy nếu được, tụi mình đi không?",
                  "vietnameseHtml": "Vậy nếu được, tụi mình đi không?"
                }
              ]
            },
            {
              "speaker": "タワポン：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\">タワポン：</span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "うん。いつごろ？",
                  "japaneseHtml": "うん。いつごろ？",
                  "vietnamese": "Được chứ. Khoảng chừng nào?",
                  "vietnameseHtml": "Được chứ. Khoảng chừng nào?"
                }
              ]
            },
            {
              "speaker": "小林(こばやし)：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\"><ruby>小林<rp>(</rp><rt>こばやし</rt><rp>)</rp></ruby>：</span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "8月(がつ)の 初(はじ)めごろは どう？",
                  "japaneseHtml": "8<ruby>月<rp>(</rp><rt>がつ</rt><rp>)</rp></ruby>の <ruby>初<rp>(</rp><rt>はじ</rt><rp>)</rp></ruby>めごろは どう？",
                  "vietnamese": "Khoảng đầu tháng 8 thì sao?",
                  "vietnameseHtml": "Khoảng đầu tháng 8 thì sao?"
                }
              ]
            },
            {
              "speaker": "タワポン：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\">タワポン：</span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "いいよ。",
                  "japaneseHtml": "いいよ。",
                  "vietnamese": "Được đấy.",
                  "vietnameseHtml": "Được đấy."
                }
              ]
            },
            {
              "speaker": "小林(こばやし)：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\"><ruby>小林<rp>(</rp><rt>こばやし</rt><rp>)</rp></ruby>： </span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "じゃ、いろいろ 調(しら)べて、また 電話(でんわ)するよ。",
                  "japaneseHtml": "じゃ、いろいろ <ruby>調<rp>(</rp><rt>しら</rt><rp>)</rp></ruby>べて、また <ruby>電話<rp>(</rp><rt>でんわ</rt><rp>)</rp></ruby>するよ。",
                  "vietnamese": "Vậy tôi sẽ tìm hiểu nhiều thứ rồi gọi cho cậu sau.",
                  "vietnameseHtml": "Vậy tôi sẽ tìm hiểu nhiều thứ rồi gọi cho cậu sau."
                }
              ]
            },
            {
              "speaker": "タワポン：",
              "speakerHtml": "<u><strong><span style=\"color:#000080;\">タワポン： </span></strong></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ありがとう。待(ま)ってるよ。",
                  "japaneseHtml": "ありがとう。<ruby>待<rp>(</rp><rt>ま</rt><rp>)</rp></ruby>ってるよ。",
                  "vietnamese": "Cảm ơn cậu. Tôi chờ đấy.",
                  "vietnameseHtml": "Cảm ơn cậu. Tôi chờ đấy."
                }
              ]
            }
          ],
