          "kind": "dialogue",
          "rows": [
            {
              "speaker": "医者(いしゃ)：",
              "speakerHtml": "<span><strong><ruby>医者<rp>(</rp><rt>いしゃ</rt><rp>)</rp></ruby>：</strong> </span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "どう しましたか。",
                  "japaneseHtml": "<span>どう しましたか。</span>",
                  "vietnamese": "Anh bị sao vậy?",
                  "vietnameseHtml": "Anh bị sao vậy?"
                }
              ]
            },
            {
              "speaker": "松本(まつもと)：",
              "speakerHtml": "<span><strong><ruby>松本<rp>(</rp><rt>まつもと</rt><rp>)</rp></ruby>： </strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "きのうから のどが 痛(いた)くて、熱(ねつ)も 少(すこ)し あります。",
                  "japaneseHtml": "<span>きのうから のどが <ruby>痛<rp>(</rp><rt>いた</rt><rp>)</rp></ruby>くて、<ruby>熱<rp>(</rp><rt>ねつ</rt><rp>)</rp></ruby>も <ruby>少<rp>(</rp><rt>すこ</rt><rp>)</rp></ruby>し あります。</span>",
                  "vietnamese": "Từ hôm qua tôi đã bị đau cổ và có sốt một chút.",
                  "vietnameseHtml": "Từ hôm qua tôi đã bị đau cổ và có sốt một chút."
                }
              ]
            },
            {
              "speaker": "医者(いしゃ)：",
              "speakerHtml": "<span><strong><ruby>医者<rp>(</rp><rt>いしゃ</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そうですか。 ちょっと 口(くち)を 開(あ)けて ください。",
                  "japaneseHtml": "<span>そうですか。 ちょっと <ruby>口<rp>(</rp><rt>くち</rt><rp>)</rp></ruby>を <ruby>開<rp>(</rp><rt>あ</rt><rp>)</rp></ruby>けて ください。</span><span> </span>",
                  "vietnamese": "Vậy à. Anh hãy mở miệng ra một chút.",
                  "vietnameseHtml": "Vậy à. Anh hãy mở miệng ra một chút."
                }
              ]
            },
            {
              "speaker": "松本(まつもと)：",
              "speakerHtml": "<span><strong><ruby>松本<rp>(</rp><rt>まつもと</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "かぜですね。２、３日(にち) ゆっくり 休(やす)んで ください。",
                  "japaneseHtml": "<span> かぜですね。２、３<ruby>日<rp>(</rp><rt>にち</rt><rp>)</rp></ruby> ゆっくり <ruby>休<rp>(</rp><rt>やす</rt><rp>)</rp></ruby>んで ください。</span>",
                  "vietnamese": "Anh bị cảm rồi. Anh hãy nghỉ ngơi thong thả đi vài ngày.",
                  "vietnameseHtml": "Anh bị cảm rồi. Anh hãy nghỉ ngơi thong thả đi vài ngày."
                }
              ]
            },
            {
              "speaker": "松本(まつもと)：",
              "speakerHtml": "<span><strong><ruby>松本<rp>(</rp><rt>まつもと</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "あのう、あしたから 東京(とうきょう)へ 出張(しゅっちょう)しなければ なりません。",
                  "japaneseHtml": "<span>あのう、あしたから <ruby>東京<rp>(</rp><rt>とうきょう</rt><rp>)</rp></ruby>へ <ruby>出張<rp>(</rp><rt>しゅっちょう</rt><rp>)</rp></ruby>しなければ なりません。</span>",
                  "vietnamese": "Thưa bác sĩ, từ ngày mai tôi phải đi công tác ở Tokyo rồi.",
                  "vietnameseHtml": "Thưa bác sĩ, từ ngày mai tôi phải đi công tác ở Tokyo rồi."
                }
              ]
            },
            {
              "speaker": "医者(いしゃ)：",
              "speakerHtml": "<span><strong><ruby>医者<rp>(</rp><rt>いしゃ</rt><rp>)</rp></ruby>：</strong> </span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "じゃ、きょうは 薬(くすり)を 飲(の)んで、 早(はや)く 寝(ね)て ください。",
                  "japaneseHtml": "<span>じゃ、きょうは <ruby>薬<rp>(</rp><rt>くすり</rt><rp>)</rp></ruby>を <ruby>飲<rp>(</rp><rt>の</rt><rp>)</rp></ruby>んで、 <ruby>早<rp>(</rp><rt>はや</rt><rp>)</rp></ruby>く <ruby>寝<rp>(</rp><rt>ね</rt><rp>)</rp></ruby>て ください。</span>",
                  "vietnamese": "Vậy thì, hôm nay anh hãy uống thuốc và hãy đi ngủ sớm đi.",
                  "vietnameseHtml": "Vậy thì, hôm nay anh hãy uống thuốc và hãy đi ngủ sớm đi."
                }
              ]
            },
            {
              "speaker": "松本(まつもと)：",
              "speakerHtml": "<span><strong><ruby>松本<rp>(</rp><rt>まつもと</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "はい。",
                  "japaneseHtml": "<span>はい。</span>",
                  "vietnamese": "Vâng ạ.",
                  "vietnameseHtml": "Vâng ạ."
                }
              ]
            },
            {
              "speaker": "医者(いしゃ)：",
              "speakerHtml": "<span><strong><ruby>医者<rp>(</rp><rt>いしゃ</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "それから 今晩(こんばん)は おふろに 入(はい)らないで くださいね。",
                  "japaneseHtml": "<span>それから <ruby>今晩<rp>(</rp><rt>こんばん</rt><rp>)</rp></ruby>は おふろに <ruby>入<rp>(</rp><rt>はい</rt><rp>)</rp></ruby>らないで くださいね。</span>",
                  "vietnamese": "Thêm nữa là tối hôm nay đừng tắm bồn nhé.",
                  "vietnameseHtml": "Thêm nữa là tối hôm nay đừng tắm bồn nhé."
                }
              ]
            },
            {
              "speaker": "松本(まつもと)：",
              "speakerHtml": "<span><strong><ruby>松本<rp>(</rp><rt>まつもと</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "はい。わかりました。",
                  "japaneseHtml": "<span>はい。わかりました。</span>",
                  "vietnamese": "Vâng. Tôi biết rồi.",
                  "vietnameseHtml": "Vâng. Tôi biết rồi."
                }
              ]
            },
            {
              "speaker": "医者(いしゃ)：",
              "speakerHtml": "<span><strong><ruby>医者<rp>(</rp><rt>いしゃ</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "じゃ、お大事(だいじ)に。",
                  "japaneseHtml": "<span> じゃ、お<ruby>大事<rp>(</rp><rt>だいじ</rt><rp>)</rp></ruby>に。</span>",
                  "vietnamese": "Vậy, chúc anh mau khỏe.",
                  "vietnameseHtml": "Vậy, chúc anh mau khỏe."
                }
              ]
            },
            {
              "speaker": "松本(まつもと)：",
              "speakerHtml": "<span><strong><ruby>松本<rp>(</rp><rt>まつもと</rt><rp>)</rp></ruby>：</strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "どうも ありがとう ございました。",
                  "japaneseHtml": "<span>どうも ありがとう ございました。</span>",
                  "vietnamese": "Xin cảm ơn bác sĩ.",
                  "vietnameseHtml": "Xin cảm ơn bác sĩ."
                }
              ]
            }
          ],
