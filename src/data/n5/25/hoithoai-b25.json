        {
          "kind": "dialogue",
          "rows": [
            {
              "speaker": "木村(きむら)：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><strong><span><ruby>木村<rp>(</rp><rt>きむら</rt><rp>)</rp></ruby>：</span></strong></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "転勤(てんきん)、おめでとう ございます。",
                  "japaneseHtml": "<ruby>転勤<rp>(</rp><rt>てんきん</rt><rp>)</rp></ruby>、おめでとう ございます。",
                  "vietnamese": "Xin chúc mừng cậu chuyển công tác.",
                  "vietnameseHtml": "Xin chúc mừng cậu chuyển công tác."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><strong><span>ミラー：</span></strong></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ありがとう ございます。",
                  "japaneseHtml": "ありがとう ございます。",
                  "vietnamese": "Xin cảm ơn.",
                  "vietnameseHtml": "Xin cảm ơn."
                }
              ]
            },
            {
              "speaker": "木村(きむら)：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><strong><span><ruby>木村<rp>(</rp><rt>きむら</rt><rp>)</rp></ruby>：</span></strong></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ミラーさんが 東京(とうきょう)へ 行(い)ったら、寂(さび)しく なりますね。",
                  "japaneseHtml": "ミラーさんが <ruby>東京<rp>(</rp><rt>とうきょう</rt><rp>)</rp></ruby>へ <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>ったら、<ruby>寂<rp>(</rp><rt>さび</rt><rp>)</rp></ruby>しく なりますね。",
                  "vietnamese": "Anh Miller đi Tokyo rồi chúng tôi sẽ buồn đấy.",
                  "vietnameseHtml": "Anh Miller đi Tokyo rồi chúng tôi sẽ buồn đấy."
                }
              ]
            },
            {
              "speaker": "佐藤(さとう)：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><strong><span><ruby>佐藤<rp>(</rp><rt>さとう</rt><rp>)</rp></ruby>：</span></strong></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そうですね。",
                  "japaneseHtml": "そうですね。",
                  "vietnamese": "Ừ nhỉ.",
                  "vietnameseHtml": "Ừ nhỉ."
                }
              ]
            },
            {
              "speaker": "木村(きむら)：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><strong><span><ruby>木村<rp>(</rp><rt>きむら</rt><rp>)</rp></ruby>：</span></strong></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "東京(とうきょう)へ 行(い)っても、大阪(おおさか)の ことを 忘(わす)れないで くださいね。",
                  "japaneseHtml": "<ruby>東京<rp>(</rp><rt>とうきょう</rt><rp>)</rp></ruby>へ <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>っても、<ruby>大阪<rp>(</rp><rt>おおさか</rt><rp>)</rp></ruby>の ことを <ruby>忘<rp>(</rp><rt>わす</rt><rp>)</rp></ruby>れないで くださいね。",
                  "vietnamese": "Dù đi Tokyo nhưng anh cũng đừng quên Osaka đấy nhé.",
                  "vietnameseHtml": "Dù đi Tokyo nhưng anh cũng đừng quên Osaka đấy nhé."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><strong><span>ミラー：</span></strong></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "もちろん。皆(みな)さん、暇(ひま)が あったら、ぜひ 東京(とうきょう)へ 遊(あそ)びに 来(き)て ください。",
                  "japaneseHtml": "もちろん。<ruby>皆<rp>(</rp><rt>みな</rt><rp>)</rp></ruby>さん、<ruby>暇<rp>(</rp><rt>ひま</rt><rp>)</rp></ruby>が あったら、ぜひ <ruby>東京<rp>(</rp><rt>とうきょう</rt><rp>)</rp></ruby>へ <ruby>遊<rp>(</rp><rt>あそ</rt><rp>)</rp></ruby>びに <ruby>来<rp>(</rp><rt>き</rt><rp>)</rp></ruby>て ください。",
                  "vietnamese": "Đương nhiên rồi. Mọi người nếu có thời gian rảnh nhất định hãy đến Tokyo chơi nhé.",
                  "vietnameseHtml": "Đương nhiên rồi. Mọi người nếu có thời gian rảnh nhất định hãy đến Tokyo chơi nhé."
                }
              ]
            },
            {
              "speaker": "サントス：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><strong><span>サントス： </span></strong></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ミラーさんも 大阪(おおさか)へ 来(き)たら、電話(でんわ)を ください。",
                  "japaneseHtml": "ミラーさんも <ruby>大阪<rp>(</rp><rt>おおさか</rt><rp>)</rp></ruby>へ <ruby>来<rp>(</rp><rt>き</rt><rp>)</rp></ruby>たら、<ruby>電話<rp>(</rp><rt>でんわ</rt><rp>)</rp></ruby>を ください。",
                  "vietnamese": "Anh Miller khi đến Osaka cũng hãy điện thoại nhé.",
                  "vietnameseHtml": "Anh Miller khi đến Osaka cũng hãy điện thoại nhé."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "いっしょに 飲(の)みましょう。",
                  "japaneseHtml": "いっしょに <ruby>飲<rp>(</rp><rt>の</rt><rp>)</rp></ruby>みましょう。",
                  "vietnamese": "Rồi cùng uống nhé.",
                  "vietnameseHtml": "Rồi cùng uống nhé."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><strong><span>ミラー：</span></strong></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ、ぜひ。",
                  "japaneseHtml": "ええ、ぜひ。",
                  "vietnamese": "Vâng, nhất định rồi.",
                  "vietnameseHtml": "Vâng, nhất định rồi."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "皆(みな)さん、ほんとうに いろいろ お世話(せわ)に なりました。",
                  "japaneseHtml": "<ruby>皆<rp>(</rp><rt>みな</rt><rp>)</rp></ruby>さん、ほんとうに いろいろ お<ruby>世話<rp>(</rp><rt>せわ</rt><rp>)</rp></ruby>に なりました。",
                  "vietnamese": "Mọi người thật sự đã giúp đỡ tôi rất nhiều.",
                  "vietnameseHtml": "Mọi người thật sự đã giúp đỡ tôi rất nhiều."
                }
              ]
            },
            {
              "speaker": "佐(たすく) 藤(ふじ)：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><strong><span><ruby>佐<rp>(</rp><rt>たすく</rt><rp>)</rp></ruby> <ruby>藤<rp>(</rp><rt>ふじ</rt><rp>)</rp></ruby>：</span></strong></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "頑張(がんば)って ください。体(からだ)に 気(き)を つけて。",
                  "japaneseHtml": "<ruby>頑張<rp>(</rp><rt>がんば</rt><rp>)</rp></ruby>って ください。<ruby>体<rp>(</rp><rt>からだ</rt><rp>)</rp></ruby>に <ruby>気<rp>(</rp><rt>き</rt><rp>)</rp></ruby>を つけて。",
                  "vietnamese": "Hãy cố gắng lên và chú ý giữ gìn sức khỏe nhé.",
                  "vietnameseHtml": "Hãy cố gắng lên và chú ý giữ gìn sức khỏe nhé."
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><strong><span>ミラー：</span></strong></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "はい。皆(みな)さんも どうぞ お元気(げんき)で。",
                  "japaneseHtml": "はい。<ruby>皆<rp>(</rp><rt>みな</rt><rp>)</rp></ruby>さんも どうぞ お<ruby>元気<rp>(</rp><rt>げんき</rt><rp>)</rp></ruby>で。",
                  "vietnamese": "Vâng. Mong các anh chị cũng luôn khỏe mạnh.",
                  "vietnameseHtml": "Vâng. Mong các anh chị cũng luôn khỏe mạnh."
                }
              ]
            }
