        {
          "kind": "dialogue",
          "rows": [
            {
              "speaker": "山(やま) 田(た)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span><ruby>山<rp>(</rp><rt>やま</rt><rp>)</rp></ruby> <ruby>田<rp>(</rp><rt>た</rt><rp>)</rp></ruby>：</span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "サントスさんの 趣味(しゅみ)は 何(なん)ですか。",
                  "japaneseHtml": "<span>サントスさんの <ruby>趣味<rp>(</rp><rt>しゅみ</rt><rp>)</rp></ruby>は <ruby>何<rp>(</rp><rt>なん</rt><rp>)</rp></ruby>ですか。</span>",
                  "vietnamese": "Sở thích của anh Santos là gì vậy?",
                  "vietnameseHtml": "Sở thích của anh Santos là gì vậy?"
                }
              ]
            },
            {
              "speaker": "サントス：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span>サントス：</span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "写真(しゃしん)です。",
                  "japaneseHtml": "<span><ruby>写真<rp>(</rp><rt>しゃしん</rt><rp>)</rp></ruby>です。</span>",
                  "vietnamese": "Là chụp ảnh.",
                  "vietnameseHtml": "Là chụp ảnh."
                }
              ]
            },
            {
              "speaker": "山(やま) 田(た)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span><ruby>山<rp>(</rp><rt>やま</rt><rp>)</rp></ruby> <ruby>田<rp>(</rp><rt>た</rt><rp>)</rp></ruby>：</span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "どんな 写真(しゃしん)を 撮(と)りますか。",
                  "japaneseHtml": "<span>どんな <ruby>写真<rp>(</rp><rt>しゃしん</rt><rp>)</rp></ruby>を <ruby>撮<rp>(</rp><rt>と</rt><rp>)</rp></ruby>りますか。</span>",
                  "vietnamese": "Anh chụp những ảnh như thế nào?",
                  "vietnameseHtml": "Anh chụp những ảnh như thế nào?"
                }
              ]
            },
            {
              "speaker": "サントス：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span>サントス： </span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "動物(どうぶつ)の 写真(しゃしん)です。特(とく)に 馬(うま)が 好(す)きです。",
                  "japaneseHtml": "<span><ruby>動物<rp>(</rp><rt>どうぶつ</rt><rp>)</rp></ruby>の <ruby>写真<rp>(</rp><rt>しゃしん</rt><rp>)</rp></ruby>です。<ruby>特<rp>(</rp><rt>とく</rt><rp>)</rp></ruby>に <ruby>馬<rp>(</rp><rt>うま</rt><rp>)</rp></ruby>が <ruby>好<rp>(</rp><rt>す</rt><rp>)</rp></ruby>きです。</span>",
                  "vietnamese": "Ảnh động vật. Và tôi đặc biệt thích ngựa.",
                  "vietnameseHtml": "Ảnh động vật. Và tôi đặc biệt thích ngựa."
                }
              ]
            },
            {
              "speaker": "山(やま) 田(た)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span><ruby>山<rp>(</rp><rt>やま</rt><rp>)</rp></ruby> <ruby>田<rp>(</rp><rt>た</rt><rp>)</rp></ruby>：</span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "へえ、それは おもしろいですね。",
                  "japaneseHtml": "<span>へえ、それは おもしろいですね。</span>",
                  "vietnamese": "Ồ, thật là thú vị.",
                  "vietnameseHtml": "Ồ, thật là thú vị."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "日本(にほん)へ 来(き)てから、馬(うま)の 写真(しゃしん)を 撮(と)りましたか。",
                  "japaneseHtml": "<span><ruby>日本<rp>(</rp><rt>にほん</rt><rp>)</rp></ruby>へ <ruby>来<rp>(</rp><rt>き</rt><rp>)</rp></ruby>てから、<ruby>馬<rp>(</rp><rt>うま</rt><rp>)</rp></ruby>の <ruby>写真<rp>(</rp><rt>しゃしん</rt><rp>)</rp></ruby>を <ruby>撮<rp>(</rp><rt>と</rt><rp>)</rp></ruby>りましたか。 </span>",
                  "vietnamese": "Từ sau khi đến Nhật rồi thì anh có chụp ảnh ngựa không?",
                  "vietnameseHtml": "Từ sau khi đến Nhật rồi thì anh có chụp ảnh ngựa không?"
                }
              ]
            },
            {
              "speaker": "サントス：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span>サントス：</span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "いいえ。",
                  "japaneseHtml": "<span> いいえ。</span>",
                  "vietnamese": "Không có.",
                  "vietnameseHtml": "Không có."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "日本(にほん)では なかなか 馬(うま)を 見(み)る ことが できません。",
                  "japaneseHtml": "<span><ruby>日本<rp>(</rp><rt>にほん</rt><rp>)</rp></ruby>では なかなか <ruby>馬<rp>(</rp><rt>うま</rt><rp>)</rp></ruby>を <ruby>見<rp>(</rp><rt>み</rt><rp>)</rp></ruby>る ことが できません。</span>",
                  "vietnamese": "Ở Nhật ít khi có thể thấy được ngựa mà.",
                  "vietnameseHtml": "Ở Nhật ít khi có thể thấy được ngựa mà."
                }
              ]
            },
            {
              "speaker": "山(やま) 田(た)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span><ruby>山<rp>(</rp><rt>やま</rt><rp>)</rp></ruby> <ruby>田<rp>(</rp><rt>た</rt><rp>)</rp></ruby>：</span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "北海道(ほっかいどう)に 馬(うま)が たくさん ありますよ。",
                  "japaneseHtml": "<span><ruby>北海道<rp>(</rp><rt>ほっかいどう</rt><rp>)</rp></ruby>に <ruby>馬<rp>(</rp><rt>うま</rt><rp>)</rp></ruby>が たくさん ありますよ。</span>",
                  "vietnamese": "Ở Hokkaido có nhiều ngựa lắm đấy.",
                  "vietnameseHtml": "Ở Hokkaido có nhiều ngựa lắm đấy."
                }
              ]
            },
            {
              "speaker": "サントス：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span>サントス：</span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ほんとうですか。",
                  "japaneseHtml": "<span>ほんとうですか。</span>",
                  "vietnamese": "Thật vậy sao.",
                  "vietnameseHtml": "Thật vậy sao."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "じゃ、夏休(なつやす)みに ぜひ 行(い)きたいです。",
                  "japaneseHtml": "<span>じゃ、<ruby>夏休<rp>(</rp><rt>なつやす</rt><rp>)</rp></ruby>みに ぜひ <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>きたいです。</span>",
                  "vietnamese": "Vậy thì nhất định tôi muốn đến đó vào kỳ nghỉ hè.",
                  "vietnameseHtml": "Vậy thì nhất định tôi muốn đến đó vào kỳ nghỉ hè."
                }
              ]
            }
          ],
