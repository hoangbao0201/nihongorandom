          "vietnamese": "Sở thích của anh là gì?",
          "vietnameseHtml": "<strong></strong><strong>Sở thích của anh là gì?</strong>"
        },
        {
          "kind": "image",
          "url": "https://www.vnjpclub.com/images/minnamoi/bai18/kaiwa.jpg",
