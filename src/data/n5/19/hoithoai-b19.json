              ]
            },
            {
              "speaker": "松(まつ)本部長(ほんぶちょう)：",
              "speakerHtml": "<ruby>松<rp>(</rp><rt>まつ</rt><rp>)</rp></ruby><ruby>本部長<rp>(</rp><rt>ほんぶちょう</rt><rp>)</rp></ruby>：",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "でも、無理(むり)な ダイエットは 体(からだ)に よくないですよ。",
                  "japaneseHtml": "でも、<ruby>無理<rp>(</rp><rt>むり</rt><rp>)</rp></ruby>な ダイエットは <ruby>体<rp>(</rp><rt>からだ</rt><rp>)</rp></ruby>に よくないですよ。",
                  "vietnamese": "Nhưng mà chế độ giảm cân quá mức sẽ không tốt cho cơ thể đâu.",
                  "vietnameseHtml": "Nhưng mà chế độ giảm cân quá mức sẽ không tốt cho cơ thể đâu."
