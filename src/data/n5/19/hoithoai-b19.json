            {
              "speaker": "マリア：",
              "speakerHtml": "マリア：",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "どんな ダイエットですか。",
                  "japaneseHtml": "どんな ダイエットですか。",
