              ]
            },
            {
              "speaker": "マリア：",
              "speakerHtml": "マリア：",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そうですね。",
                  "japaneseHtml": "そうですね。",
                  "vietnamese": "Đúng vậy nhỉ.",
                  "vietnameseHtml": "Đúng vậy nhỉ."
                }
