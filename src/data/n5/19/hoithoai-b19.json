                  "japaneseHtml": "マリアさん、このアイスクリーム、おいしいですよ。",
                  "vietnamese": "Cô Maria này, kem này ngon lắm đấy.",
                  "vietnameseHtml": "Cô Maria này, kem này ngon lắm đấy."
                }
              ]
            },
            {
              "speaker": "マリア：",
              "speakerHtml": "マリア：",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そうですか。",
                  "japaneseHtml": "そうですか。",
                  "vietnamese": "Vậy sao,",
