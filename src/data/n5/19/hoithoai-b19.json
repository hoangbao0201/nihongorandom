              "speakerHtml": "<ruby>松本<rp>(</rp><rt>まつもと</rt><rp>)</rp></ruby><ruby>良子<rp>(</rp><rt>よしこ</rt><rp>)</rp></ruby>：",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "毎日(まいにち) りんごだけ 食(た)べたり、水(みず)を たくさん のんだり しました。",
                  "japaneseHtml": "<ruby>毎日<rp>(</rp><rt>まいにち</rt><rp>)</rp></ruby> りんごだけ <ruby>食<rp>(</rp><rt>た</rt><rp>)</rp></ruby>べたり、<ruby>水<rp>(</rp><rt>みず</rt><rp>)</rp></ruby>を たくさん のんだり しました。",
                  "vietnamese": "Mỗi ngày nào là chỉ ăn táo, nào là uống thật nhiều nước,..",
                  "vietnameseHtml": "Mỗi ngày nào là chỉ ăn táo, nào là uống thật nhiều nước,.."
