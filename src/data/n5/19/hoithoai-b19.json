                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "･････。ダイエットは また あしたから します。",
                  "japaneseHtml": "･････。ダイエットは また あしたから します。",
