            },
            {
              "kind": "sentence",
              "text": "JRのおおさか駅です。",
              "textHtml": "JRのおおさか<ruby>駅<rp>（</rp><rt>えき</rt><rp>）</rp></ruby>です。",
              "meaning": "Ga Osaka của tàu JR."
            },
            {
              "kind": "sentence",
              "text": "1．すみません。 きょうとまで いくらですか。",
              "textHtml": "1．すみません。 きょうとまで いくらですか。",
              "meaning": "Xin lỗi, đến Kyoto hết bao nhiêu tiền ạ?"
            },
            {
              "kind": "sentence",
              "text": "…560円ですよ。",
              "textHtml": "…<b>560</b><ruby>円<rp>（</rp><rt>えん</rt><rp>）</rp></ruby>ですよ。",
              "meaning": "Là 560 Yên ấy."
            },
            {
              "kind": "sentence",
              "text": "2．ならへいきます。いくらですか。",
              "textHtml": "2．ならへいきます。いくらですか。",
              "meaning": "Đi Nara hết bao nhiêu ạ?"
            },
            {
              "kind": "sentence",
              "text": "…800円です。",
              "textHtml": "…<b>800</b><ruby>円<rp>（</rp><rt>えん</rt><rp>）</rp></ruby>です。",
              "meaning": "Là 800 Yên."
            },
            {
              "kind": "sentence",
              "text": "3．あかしまで 300円ですか。",
              "textHtml": "3．あかしまで 300<ruby>円<rp>（</rp><rt>えん</rt><rp>）</rp></ruby>ですか。",
              "meaning": "Đến Akashi là 300 Yên phải không ạ?"
            },
            {
              "kind": "sentence",
              "text": "…いいえ、あかしは920円ですよ。",
              "textHtml": "…いいえ、あかしは<b>920</b><ruby>円<rp>（</rp><rt>えん</rt><rp>）</rp></ruby>ですよ。",
