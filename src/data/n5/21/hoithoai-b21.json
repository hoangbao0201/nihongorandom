        {
          "kind": "dialogue",
          "rows": [
            {
              "speaker": "松本(まつもと)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span><ruby>松本<rp>(</rp><rt>まつもと</rt><rp>)</rp></ruby>：</span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "あ、サントスさん、久(ひさ)しぶりですね。",
                  "japaneseHtml": "あ、サントスさん、<ruby>久<rp>(</rp><rt>ひさ</rt><rp>)</rp></ruby>しぶりですね。",
                  "vietnamese": "A, anh Santos. Lâu quá không gặp.",
                  "vietnameseHtml": "A, anh Santos. Lâu quá không gặp."
                }
              ]
            },
            {
              "speaker": "サントス：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span>サントス：</span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "あ、松本(まつもと)さん、お元気(げんき)ですか。",
                  "japaneseHtml": "あ、<ruby>松本<rp>(</rp><rt>まつもと</rt><rp>)</rp></ruby>さん、お<ruby>元気<rp>(</rp><rt>げんき</rt><rp>)</rp></ruby>ですか。",
                  "vietnamese": "A, anh Matsumoto, anh khỏe chứ?",
                  "vietnameseHtml": "A, anh Matsumoto, anh khỏe chứ?"
                }
              ]
            },
            {
              "speaker": "松本(まつもと)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span><ruby>松本<rp>(</rp><rt>まつもと</rt><rp>)</rp></ruby>：</span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ。ちょっと ビールでも 飲(の)みませんか。",
                  "japaneseHtml": "ええ。ちょっと ビールでも <ruby>飲<rp>(</rp><rt>の</rt><rp>)</rp></ruby>みませんか。",
                  "vietnamese": "Vâng tôi khỏe. Đi uống chút bia không?",
                  "vietnameseHtml": "Vâng tôi khỏe. Đi uống chút bia không?"
                }
              ]
            },
            {
              "speaker": "サントス：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span>サントス： </span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "いいですね。",
                  "japaneseHtml": "いいですね。",
                  "vietnamese": "Được đấy nhỉ.",
                  "vietnameseHtml": "Được đấy nhỉ."
                }
              ]
            },
            {
              "speaker": "サントス：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span>サントス： </span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "今晩(こんばん) 10時(じ)から 日本(にほん)と ブラジルの サッカーの 試合(しあい)が ありますね。",
                  "japaneseHtml": "<ruby>今晩<rp>(</rp><rt>こんばん</rt><rp>)</rp></ruby> 10<ruby>時<rp>(</rp><rt>じ</rt><rp>)</rp></ruby>から <ruby>日本<rp>(</rp><rt>にほん</rt><rp>)</rp></ruby>と ブラジルの サッカーの <ruby>試合<rp>(</rp><rt>しあい</rt><rp>)</rp></ruby>が ありますね。",
                  "vietnamese": "Tối nay từ 10 giờ có trận bóng đá giữa đội Nhật và Brazil nhỉ.",
                  "vietnameseHtml": "Tối nay từ 10 giờ có trận bóng đá giữa đội Nhật và Brazil nhỉ."
                }
              ]
            },
            {
              "speaker": "松本(まつもと)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span><ruby>松本<rp>(</rp><rt>まつもと</rt><rp>)</rp></ruby>：</span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ああ、そうですね。ぜひ 見(み)ないと･････。",
                  "japaneseHtml": "ああ、そうですね。ぜひ <ruby>見<rp>(</rp><rt>み</rt><rp>)</rp></ruby>ないと･････。",
                  "vietnamese": "A, đúng thế nhỉ. Tôi nhất định sẽ xem…",
                  "vietnameseHtml": "A, đúng thế nhỉ. Tôi nhất định sẽ xem…"
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "サントスさんは どちらが 勝(か)つと 思(おも)いますか。",
                  "japaneseHtml": "サントスさんは どちらが <ruby>勝<rp>(</rp><rt>か</rt><rp>)</rp></ruby>つと <ruby>思<rp>(</rp><rt>おも</rt><rp>)</rp></ruby>いますか。",
                  "vietnamese": "Mà anh Santos nghĩ là đội nào sẽ thắng?",
                  "vietnameseHtml": "Mà anh Santos nghĩ là đội nào sẽ thắng?"
                }
              ]
            },
            {
              "speaker": "サントス：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span>サントス： </span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "もちろん ブラジルですよ。",
                  "japaneseHtml": "もちろん ブラジルですよ。",
                  "vietnamese": "Đương nhiên là Brazil rồi.",
                  "vietnameseHtml": "Đương nhiên là Brazil rồi."
                }
              ]
            },
            {
              "speaker": "松本(まつもと)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span><ruby>松本<rp>(</rp><rt>まつもと</rt><rp>)</rp></ruby>： </span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そうですね。でも、最近(さいきん) 日本(にほん)も 強(つよ)く なりましたよ。",
                  "japaneseHtml": "そうですね。でも、<ruby>最近<rp>(</rp><rt>さいきん</rt><rp>)</rp></ruby> <ruby>日本<rp>(</rp><rt>にほん</rt><rp>)</rp></ruby>も <ruby>強<rp>(</rp><rt>つよ</rt><rp>)</rp></ruby>く なりましたよ。",
                  "vietnamese": "Ừ nhỉ. Nhưng mà dạo này đội Nhật cũng mạnh lên rồi đấy.",
                  "vietnameseHtml": "Ừ nhỉ. Nhưng mà dạo này đội Nhật cũng mạnh lên rồi đấy."
                }
              ]
            },
            {
              "speaker": "サントス：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span>サントス：</span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ、わたしも そう 思(おも)いますが、･････。",
                  "japaneseHtml": "ええ、わたしも そう <ruby>思<rp>(</rp><rt>おも</rt><rp>)</rp></ruby>いますが、･････。",
                  "vietnamese": "Vâng, tôi cũng nghĩ thế nhưng mà….",
                  "vietnameseHtml": "Vâng, tôi cũng nghĩ thế nhưng mà…."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "あ、もう 帰(かえ)らないと、･････。",
                  "japaneseHtml": "あ、もう <ruby>帰<rp>(</rp><rt>かえ</rt><rp>)</rp></ruby>らないと、･････。",
                  "vietnamese": "Ái chà, đã tới lúc phải về rồi,….",
                  "vietnameseHtml": "Ái chà, đã tới lúc phải về rồi,…."
                }
              ]
            },
            {
              "speaker": "松本(まつもと)：",
              "speakerHtml": "<span style=\"color:#000080;\"><strong><span><ruby>松本<rp>(</rp><rt>まつもと</rt><rp>)</rp></ruby>： </span></strong></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ、帰(かえ)りましょう。",
                  "japaneseHtml": "ええ、<ruby>帰<rp>(</rp><rt>かえ</rt><rp>)</rp></ruby>りましょう。",
                  "vietnamese": "Vâng, về thôi.",
                  "vietnameseHtml": "Vâng, về thôi."
                }
              ]
            }
          ],
          "contentHtml": "<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"khung\" style=\" width: 100%;\"> <tbody> <tr> <td style=\"width: 17%;\"> <span style=\"color:#000080;\"><strong><span><ruby>松本<rp>(</rp><rt>まつもと</rt><rp>)</rp></ruby>：</span></strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">あ、サントスさん、<ruby>久<rp>(</rp><rt>ひさ</rt><rp>)</rp></ruby>しぶりですね。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">A, anh Santos. Lâu quá không gặp.</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><span>サントス：</span></strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">あ、<ruby>松本<rp>(</rp><rt>まつもと</rt><rp>)</rp></ruby>さん、お<ruby>元気<rp>(</rp><rt>げんき</rt><rp>)</rp></ruby>ですか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">A, anh Matsumoto, anh khỏe chứ?</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><span><ruby>松本<rp>(</rp><rt>まつもと</rt><rp>)</rp></ruby>：</span></strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">ええ。ちょっと ビールでも <ruby>飲<rp>(</rp><rt>の</rt><rp>)</rp></ruby>みませんか。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Vâng tôi khỏe. Đi uống chút bia không?</div></div></div></td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><span>サントス： </span></strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\">いいですね。</div><div class=\"kqdich\" style=\"opacity: 0; display: none;\"><span></span><div class=\"nddich\">Được đấy nhỉ.</div></div></div></td> </tr> <tr> <td> </td> <td> ‐‐‐‐‐‐‐‐‐‐‐‐‐‐‐‐ </td> </tr> <tr> <td> <span style=\"color:#000080;\"><strong><span>サントス： </span></strong></span></td> <td> <div class=\"tudich\"><div class=\"candich\"><ruby>今晩<rp>(</rp><rt>こんばん</rt><rp>)</rp></ruby> 10<ruby>時<rp>(</rp><rt>じ</rt><rp>)</rp></ruby>から <ruby>日本<rp>(</rp><rt>にほん</rt><rp>)</rp></r