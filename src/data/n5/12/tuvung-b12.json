    {
      "key": "section-2",
      "label": "会話(かいわ)",
      "labelHtml": "＜<b><ruby>会話<rp>(</rp><rt>かいわ</rt><rp>)</rp></ruby></b>＞",
      "items": [
        {
          "kind": "phrase",
          "index": 45,
          "text": "ただいま。",
          "textHtml": "ただいま。",
          "audio": "https://www.vnjpclub.com/Audio/minnamoi/bai12/00010100110000010.mp3",
          "meaning": "Tôi đã về đây. (dùng nói khi về đến nhà)",
          "meaningHtml": "Tôi đã về đây. (dùng nói khi về đến nhà)"
        },
        {
          "kind": "phrase",
          "index": 46,
          "text": "お帰（かえ）りなさい",
          "textHtml": "お<ruby>帰<rp>（</rp><rt>かえ</rt><rp>）</rp></ruby>りなさい",
          "audio": "https://www.vnjpclub.com/Audio/minnamoi/bai12/00010100110000011.mp3",
          "meaning": "Anh/Chị đã về đấy à. (dùng để nói với ai đó mới về đến nhà)",
          "meaningHtml": "Anh/Chị đã về đấy à.<br /> (dùng để nói với ai đó mới về đến nhà)"
        },
        {
          "kind": "phrase",
          "index": 47,
          "text": "わあ、すごい人（ひと）ですね。",
          "textHtml": "わあ、すごい<ruby>人<rp>（</rp><rt>ひと</rt><rp>）</rp></ruby>ですね。",
          "audio": "https://www.vnjpclub.com/Audio/minnamoi/bai12/00010100110000100.mp3",
          "meaning": "Ôi, (người) đông quá nhỉ!",
          "meaningHtml": "Ôi, (người) đông quá nhỉ!"
        },
        {
          "kind": "phrase",
          "index": 48,
          "text": "疲（つか）れました。",
          "textHtml": "<ruby>疲<rp>（</rp><rt>つか</rt><rp>）</rp></ruby>れました。",
          "audio": "https://www.vnjpclub.com/Audio/minnamoi/bai12/00010100110000101.mp3",
          "meaning": "Tôi mệt rồi",
          "meaningHtml": "Tôi mệt rồi"
        },
        {
          "kind": "divider"
        },
        {
          "kind": "phrase",
          "index": 49,
          "text": "祗園（ぎおん）祭（まつり）",
          "textHtml": "<ruby>祗園<rp>（</rp><rt>ぎおん</rt><rp>）</rp></ruby><ruby>祭<rp>（</rp><rt>まつり</rt><rp>）</rp></ruby>",
          "audio": "https://www.vnjpclub.com/Audio/minnamoi/bai12/00010100110000110.mp3",
          "meaning": "Lễ hội Gi-ôn (lễ hội nổi tiếng nhất ở Kyoto)",
          "meaningHtml": "Lễ hội Gi-ôn (lễ hội nổi tiếng nhất ở Kyoto)"
        },
        {
          "kind": "phrase",
