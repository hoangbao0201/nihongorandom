              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "これ、京都(きょうと)の お土産(みやげ)です。",
                  "japaneseHtml": "<strong></strong><span>これ、<ruby>京都<rp>(</rp><rt>きょうと</rt><rp>)</rp></ruby>の お<ruby>土産<rp>(</rp><rt>みやげ</rt><rp>)</rp></ruby>です。</span><strong></strong>",
                  "vietnamese": "Cái này là quà lưu niệm của Kyoto.",
                  "vietnameseHtml": "<strong></strong><span> </span>Cái này là quà lưu niệm của Kyoto.<strong></strong>"
                }
              ]
            },
            {
              "speaker": "管理人(かんりにん)：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><span><strong><ruby>管理人<rp>(</rp><rt>かんりにん</rt><rp>)</rp></ruby>：</strong></span></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "どうも すみません。",
                  "japaneseHtml": "<strong></strong><span>どうも すみません。</span><strong></strong>",
                  "vietnamese": "Cảm ơn cậu.",
                  "vietnameseHtml": "<strong></strong>Cảm ơn cậu.<strong></strong>"
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "祇園祭(ぎおんまつり)は どうでしたか。",
                  "japaneseHtml": "<strong></strong><span><ruby>祇園祭<rp>(</rp><rt>ぎおんまつり</rt><rp>)</rp></ruby>は どうでしたか。</span><strong></strong>",
                  "vietnamese": "Lễ hội Gion ra sao?",
                  "vietnameseHtml": "<strong></strong>Lễ hội Gion ra sao?<strong></strong>"
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><span><strong>ミラー：</strong></span></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "おもしろかったです。",
                  "japaneseHtml": "<strong></strong><span>おもしろかったです。</span><strong></strong>",
