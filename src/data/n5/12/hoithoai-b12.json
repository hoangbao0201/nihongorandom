              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "とても にぎやかでした。",
                  "japaneseHtml": "<strong></strong><span>とても にぎやかでした。</span><strong></strong>",
                  "vietnamese": "Rất là náo nhiệt.",
