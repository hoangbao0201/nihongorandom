                }
              ]
            },
            {
              "speaker": "管理人(かんりにん)：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><span><strong><ruby>管理人<rp>(</rp><rt>かんりにん</rt><rp>)</rp></ruby>：</strong></span></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "祇園祭(ぎおんまつり)は 京都(きょうと)の 祭(まつ)りで いちばん 有名(ゆうめい)ですからね。",
                  "japaneseHtml": "<strong></strong><span><ruby>祇園祭<rp>(</rp><rt>ぎおんまつり</rt><rp>)</rp></ruby>は <ruby>京都<rp>(</rp><rt>きょうと</rt><rp>)</rp></ruby>の <ruby>祭<rp>(</rp><rt>まつ</rt><rp>)</rp></ruby>りで いちばん <ruby>有名<rp>(</rp><rt>ゆうめい</rt><rp>)</rp></ruby>ですからね。 </span><strong></strong>",
                  "vietnamese": "Vì lễ hội Gion là lễ hội nổi tiếng nhất của Kyoto mà.",
                  "vietnameseHtml": "<strong></strong>Vì lễ hội Gion là lễ hội nổi tiếng nhất của Kyoto mà.<strong></strong>"
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><span><strong>ミラー：</strong></span></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そうですか。",
                  "japaneseHtml": "<strong></strong><span>そうですか。</span><strong></strong>",
                  "vietnamese": "Vậy à.",
                  "vietnameseHtml": "<strong></strong><span>Vậy à. </span><strong></strong>"
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "<span style=\"color:#000080;\"><u><span><strong></strong></span></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "写真(しゃしん)を たくさん 撮(と)りました。 これです。",
                  "japaneseHtml": "<strong></strong><span><ruby>写真<rp>(</rp><rt>しゃしん</rt><rp>)</rp></ruby>を たくさん <ruby>撮<rp>(</rp><rt>と</rt><rp>)</rp></ruby>りました。 これです。</span><strong></strong>",
                  "vietnamese": "Tôi đã chụp rất nhiều hình. Cái này ạ.",
                  "vietnameseHtml": "<strong></strong>Tôi đã chụp rất nhiều hình. Cái này ạ.<strong></strong>"
                }
              ]
            },
            {
              "speaker": "管理人(かんりにん)：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><span><strong><ruby>管理人<rp>(</rp><rt>かんりにん</rt><rp>)</rp></ruby>：</strong></span></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "わあ、すごい 人(ひと)ですね。",
                  "japaneseHtml": "<strong></strong><span>わあ、すごい <ruby>人<rp>(</rp><rt>ひと</rt><rp>)</rp></ruby>ですね。 </span><strong></strong>",
                  "vietnamese": "Wa, nhiều người quá nhỉ.",
                  "vietnameseHtml": "<strong></strong>Wa, nhiều người quá nhỉ.<strong></strong>"
                }
              ]
            },
            {
              "speaker": "ミラー：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><span><strong>ミラー： </strong></span></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ。ちょっと 疲(つか)れました。",
                  "japaneseHtml": "<strong></strong><span>ええ。ちょっと <ruby>疲<rp>(</rp><rt>つか</rt><rp>)</rp></ruby>れました。 </span><strong></strong>",
