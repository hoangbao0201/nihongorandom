                  "vietnameseHtml": "<strong></strong>Tôi về rồi đây.<strong></strong>"
                }
              ]
            },
            {
              "speaker": "管理人(かんりにん)：",
              "speakerHtml": "<span style=\"color:#000080;\"><u><span><strong><ruby>管理人<rp>(</rp><rt>かんりにん</rt><rp>)</rp></ruby>：</strong></span></u></span>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "お帰(かえ)りなさい。",
                  "japaneseHtml": "<strong></strong><span> お<ruby>帰<rp>(</rp><rt>かえ</rt><rp>)</rp></ruby>りなさい。 </span><strong></strong>",
                  "vietnamese": "Cậu về rồi à.",
