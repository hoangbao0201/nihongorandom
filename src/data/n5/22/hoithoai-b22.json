        {
          "kind": "audio",
          "style": "controls",
          "url": "https://www.vnjpclub.com/Audio/minnahonsatsu1/75.mp3",
          "contentHtml": "<audio controls=\"\"><source src=\"/Audio/minnahonsatsu1/75.mp3\" type=\"audio/mpeg\"></audio>"
        },
        {
          "kind": "dialogue",
          "rows": [
            {
              "speaker": "不動産(ふどうさん)屋(や)：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong><ruby>不動産<rp>(</rp><rt>ふどうさん</rt><rp>)</rp></ruby><ruby>屋<rp>(</rp><rt>や</rt><rp>)</rp></ruby>：</strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "どんな 部屋(へや)を お探(さが)しですか。",
                  "japaneseHtml": "どんな <ruby>部屋<rp>(</rp><rt>へや</rt><rp>)</rp></ruby>を お<ruby>探<rp>(</rp><rt>さが</rt><rp>)</rp></ruby>しですか。",
                  "vietnamese": "Anh tìm phòng như thế nào?",
                  "vietnameseHtml": "Anh tìm phòng như thế nào?"
                }
              ]
            },
            {
              "speaker": "ワン：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong>ワン：</strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そうですね。家賃(やちん)は 8万(まん)円(えん)ぐらいで、 駅(えき)から 遠(とお)くない 所が いいですね。",
                  "japaneseHtml": "そうですね。<ruby>家賃<rp>(</rp><rt>やちん</rt><rp>)</rp></ruby>は 8<ruby>万<rp>(</rp><rt>まん</rt><rp>)</rp></ruby><ruby>円<rp>(</rp><rt>えん</rt><rp>)</rp></ruby>ぐらいで、 <ruby>駅<rp>(</rp><rt>えき</rt><rp>)</rp></ruby>から <ruby>遠<rp>(</rp><rt>とお</rt><rp>)</rp></ruby>くない 所が いいですね。",
                  "vietnamese": "Tiền nhà tầm 80000Yen và không xa nhà ga thì được.",
                  "vietnameseHtml": "Tiền nhà tầm 80000Yen và không xa nhà ga thì được."
                }
              ]
            },
            {
              "speaker": "不動産(ふどうさん)屋(や)：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong><ruby>不動産<rp>(</rp><rt>ふどうさん</rt><rp>)</rp></ruby><ruby>屋<rp>(</rp><rt>や</rt><rp>)</rp></ruby>：</strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "では、こちらは いかがですか。駅(えき)から 10分で、家賃(やちん)は 83,000円です。",
                  "japaneseHtml": "では、こちらは いかがですか。<ruby>駅<rp>(</rp><rt>えき</rt><rp>)</rp></ruby>から 10分で、<ruby>家賃<rp>(</rp><rt>やちん</rt><rp>)</rp></ruby>は 83,000円です。",
                  "vietnamese": "Vậy chỗ này có được không? Từ nhà ga cách 10 phút và tiền nhà 83000Yen.",
                  "vietnameseHtml": "Vậy chỗ này có được không? Từ nhà ga cách 10 phút và tiền nhà 83000Yen."
                }
              ]
            },
            {
              "speaker": "ワン：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong>ワン： </strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ダイニングキチンと 和室(わしつ)ですね。",
                  "japaneseHtml": "ダイニングキチンと <ruby>和室<rp>(</rp><rt>わしつ</rt><rp>)</rp></ruby>ですね。",
                  "vietnamese": "Bếp kèm phòng ăn và phòng kiểu Nhật nhỉ.",
                  "vietnameseHtml": "Bếp kèm phòng ăn và phòng kiểu Nhật nhỉ."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "すみません。ここは 何(なん)ですか。",
                  "japaneseHtml": "すみません。ここは <ruby>何<rp>(</rp><rt>なん</rt><rp>)</rp></ruby>ですか。",
                  "vietnamese": "Xin lỗi chỗ này là gì vậy?",
                  "vietnameseHtml": "Xin lỗi chỗ này là gì vậy?"
                }
              ]
            },
            {
              "speaker": "不動産(ふどうさん)屋(や)：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong><ruby>不動産<rp>(</rp><rt>ふどうさん</rt><rp>)</rp></ruby><ruby>屋<rp>(</rp><rt>や</rt><rp>)</rp></ruby>： </strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "押(お)し入(い)れです。布団(ふとん)を 入(い)れる 所(ところ)ですよ。",
                  "japaneseHtml": "<ruby>押<rp>(</rp><rt>お</rt><rp>)</rp></ruby>し<ruby>入<rp>(</rp><rt>い</rt><rp>)</rp></ruby>れです。<ruby>布団<rp>(</rp><rt>ふとん</rt><rp>)</rp></ruby>を <ruby>入<rp>(</rp><rt>い</rt><rp>)</rp></ruby>れる <ruby>所<rp>(</rp><rt>ところ</rt><rp>)</rp></ruby>ですよ。",
                  "vietnamese": "Là ngăn tủ. Là nơi để chăn mền đấy ạ.",
                  "vietnameseHtml": "Là ngăn tủ. Là nơi để chăn mền đấy ạ."
                }
              ]
            },
            {
              "speaker": "ワン：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong>ワン：</strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "そうですか。",
                  "japaneseHtml": "そうですか。",
                  "vietnamese": "Vậy à.",
                  "vietnameseHtml": "Vậy à."
                }
              ]
            },
            {
              "speaker": null,
              "speakerHtml": "",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "この 部屋(へや)、きょう 見(み)る ことが できますか。",
                  "japaneseHtml": "この <ruby>部屋<rp>(</rp><rt>へや</rt><rp>)</rp></ruby>、きょう <ruby>見<rp>(</rp><rt>み</rt><rp>)</rp></ruby>る ことが できますか。",
                  "vietnamese": "Căn phòng này, ngày hôm nay có thể xem được không?",
                  "vietnameseHtml": "Căn phòng này, ngày hôm nay có thể xem được không?"
                }
              ]
            },
            {
              "speaker": "不動産(ふどうさん)屋(や)：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong><ruby>不動産<rp>(</rp><rt>ふどうさん</rt><rp>)</rp></ruby><ruby>屋<rp>(</rp><rt>や</rt><rp>)</rp></ruby>：</strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ。今(いま)から 行(い)きましょうか。",
                  "japaneseHtml": "ええ。<ruby>今<rp>(</rp><rt>いま</rt><rp>)</rp></ruby>から <ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>きましょうか。",
                  "vietnamese": "Được chứ. Chúng ta đi từ bây giờ luôn ạ?",
                  "vietnameseHtml": "Được chứ. Chúng ta đi từ bây giờ luôn ạ?"
                }
              ]
            },
            {
              "speaker": "ワン：",
              "speakerHtml": "<u><span style=\"color:#000080;\"><span><strong>ワン：</strong></span></span></u>",
              "lines": [
                {
                  "kind": "tudich",
                  "japanese": "ええ、お願(ねが)いします。",
                  "japaneseHtml": "ええ、お<ruby>願<rp>(</rp><rt>ねが</rt><rp>)</rp></ruby>いします。",
                  "vietnamese": "Vâng, nhờ anh đấy.",
                  "vietnameseHtml": "Vâng, nhờ anh đấy."
                }
              ]
            }
          ],
