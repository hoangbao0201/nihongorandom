          "vietnamese": "Anh chị tìm phòng như thế nào?",
          "vietnameseHtml": "<strong></strong><strong>Anh chị tìm phòng như thế nào?</strong><strong></strong>"
        },
        {
          "kind": "image",
          "url": "https://www.vnjpclub.com/images/minnamoi/bai22/kaiwa.jpg",
          "contentHtml": "<img alt=\"\" src=\"/images/minnamoi/bai22/kaiwa.jpg\" style=\"width: 60%;\">"
